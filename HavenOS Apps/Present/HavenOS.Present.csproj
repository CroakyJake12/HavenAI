<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PlatformTarget">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>HavenOS.Apps.Present</RootNamespace>
    <AssemblyName>HavenOS.Present</AssemblyName>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Haven.Application/Haven.Application.csproj" />
    <ProjectReference Include="../../src/Haven.Desktop/Haven.Desktop.csproj" />
    <ProjectReference Include="../../src/Haven.Infrastructure/Haven.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
