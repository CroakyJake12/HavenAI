#!/usr/bin/env bash
set -euo pipefail
mkdir -p artifacts/android
sha256sum -c <(cat <<'SUMS'
f9c392022a66d6d91c47bb027403fb1452fd18fc25c008c8dc59542f60b2d125  scripts/mobile_repair_payload.part0
3df31500827a908058dc037b559534c3faf28003f60395657c5ada9ae63c561b  scripts/mobile_repair_payload.part1a
5abd7b04e1e82e34ed2521fe72365fb2b319c1e19c9d828bc29c18fb1d703353  scripts/mobile_repair_payload.part1b
2c6502eb78708634662b59472916ff925dbb1c101b9b7b30ca39c73f2813d444  scripts/mobile_repair_payload.part2
SUMS
)
cat scripts/mobile_repair_payload.part0 scripts/mobile_repair_payload.part1a scripts/mobile_repair_payload.part1b scripts/mobile_repair_payload.part2 > /tmp/repair.b64
base64 -d /tmp/repair.b64 > /tmp/repair.py.gz
echo "dea708a322621af0141b4d717435ed59ec974860e68bffacd2f8c3878aa616f0  /tmp/repair.py.gz" | sha256sum -c -
gzip -t /tmp/repair.py.gz
gzip -dc /tmp/repair.py.gz > /tmp/repair.py
echo "5a8f943fc2ab1a3c7583c53f158484092dcf5d188f2ff9eb3fb351da8c4eb51a  /tmp/repair.py" | sha256sum -c -
python - <<'PY'
from pathlib import Path
path = Path("/tmp/repair.py")
text = path.read_text()
needle = """        if (_mobileHomeFooter is not null)
            _mobileHomeFooter.IsVisible = isHome;
        PageContent.Margin = isHome
"""
replacement = """        if (_mobileHomeFooter is not null)
            _mobileHomeFooter.IsVisible = isHome;

        PageContent.Margin = isHome
"""
if