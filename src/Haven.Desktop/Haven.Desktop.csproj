<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Haven.Desktop.csproj in the Desktop composition layer, which starts and wires the Avalonia application.
  What: This MSBuild/XML file declares project inputs, dependencies, and build behavior.
  Why: Central declarative configuration keeps builds reproducible across developer machines and CI.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PlatformTarget">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Haven</AssemblyName>
    <RootNamespace>Haven.Desktop</RootNamespace>
    <ApplicationIcon Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">Assets\haven.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">app.manifest</ApplicationManifest>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Exe</OutputType>
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">$(DefineConstants);HAVEN_WINDOWS_DESKTOP</DefineConstants>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <!-- DI-created pages deliberately have no parameterless runtime-loader constructor. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <ProjectReference Include="..\Haven.Core\Haven.Core.csproj" />
    <ProjectReference Include="..\Haven.Application\Haven.Application.csproj" />
    <ProjectReference Include="..\Haven.Infrastructure\Haven.Infrastructure.csproj" />
    <ProjectReference Include="..\Haven.Browser\Haven.Browser.csproj" />
    <!-- During Phase 2 this desktop project is the Avalonia backend/host for platform-neutral Haven.UI. -->
    <ProjectReference Include="..\Haven.UI\Haven.UI.csproj" />
    <!-- Legacy Haven.Automations project retired; scheduled Tasks live in Haven.Application. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <!-- Wraps Avalonia's existing CoreWebView2 COM handle without importing WebView2's WPF/WinForms assemblies. -->
    <PackageReference Include="Microsoft.Web.WebView2" GeneratePathProperty="true" ExcludeAssets="all" Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />
    <Reference Include="Microsoft.Web.WebView2.Core" Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="KokoroSharp.CPU" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Prefabs\**\*.hui" />
    <EmbeddedResource Include="DynamicUI\**\*.hui" />
    <Compile Update="Prefabs\**\*.hui.cs"><DependentUpon>%(Filename)</DependentUpon></Compile>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../HavenOS Apps/Write/WriteAppSurface.cs" Link="HavenOS Apps/Write/WriteAppSurface.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Views\Pages\Go\GoPage.axaml.cs">
      <DependentUpon>GoPage.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Pages\Home\NewDashboardPage.axaml.cs">
      <DependentUpon>NewDashboardPage.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
