<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Haven.Desktop.csproj in the Desktop composition layer, which starts and wires the Avalonia application.
  What: This MSBuild/XML file declares project inputs, dependencies, and build behavior.
  Why: Central declarative configuration keeps builds reproducible across developer machines and CI.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PlatformTarget">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Haven</AssemblyName>
    <RootNamespace>Haven.Desktop</RootNamespace>
    <ApplicationIcon>Assets\haven.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <ProjectReference Include="..\Haven.Core\Haven.Core.csproj" />
    <ProjectReference Include="..\Haven.Application\Haven.Application.csproj" />
    <ProjectReference Include="..\Haven.Infrastructure\Haven.Infrastructure.csproj" />
    <ProjectReference Include="..\Haven.Browser\Haven.Browser.csproj" />
    <ProjectReference Include="..\Haven.Automations\Haven.Automations.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="KokoroSharp.CPU" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**\*.axaml" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Interface\Overlay\" />
    <Folder Include="Interface\Pages\Data\" />
    <Folder Include="Interface\Pages\Configure\" />
    <Folder Include="Interface\Pages\Imagine\" />
    <Folder Include="Interface\Pages\Browse\" />
    <Folder Include="Interface\Pages\Translate\" />
    <Folder Include="Interface\Pages\Vision\" />
    <Folder Include="Interface\Pages\Play\" />
    <Folder Include="Interface\Pages\Planner\" />
    <Folder Include="Interface\Pages\Tasks\" />
    <Folder Include="Interface\Pages\Optimise\" />
    <Folder Include="Interface\Pages\Present\" />
    <Folder Include="Interface\Pages\Write\" />
    <Folder Include="Interface\Pages\Studio\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Interface\Pages\Chat\Chat.axaml.cs">
      <DependentUpon>Chat.axaml</DependentUpon>
    </Compile>
    <Compile Update="Interface\Pages\Go\Go.axaml.cs">
      <DependentUpon>Go.axaml</DependentUpon>
    </Compile>
    <Compile Update="Interface\Pages\Home\Dashboard.axaml.cs">
      <DependentUpon>Dashboard.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
