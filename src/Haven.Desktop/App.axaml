<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/App.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.App. Its visual vocabulary includes: Application, Application.Resources, SolidColorBrush, Color, ControlTheme, Setter, ControlTemplate, Border, ExperimentalAcrylicBorder, ExperimentalAcrylicBorder.Material, ExperimentalAcrylicMaterial, ContentPresenter, AcrylicSurface, ScrollViewer, ItemsPresenter, Application.Styles, FluentTheme, Style, Application.DataTemplates, DataTemplate, ChatView, ChatGroupView, HomeView, CallView, PlanView, CatalogView, AutomationsView, BrowserView, TrainingView, SettingsView, ContainerSettingsView, LessonSettingsView, WorkspaceHomeView, ProjectCreatorView, StudioProjectView, WorkspaceEditorView, MacrosView, ArchiveView, ActivityLogView, ModeLibraryView.
  Data flow: Binding expressions read or update these view-model paths: no direct Binding expressions; values are static or resource-driven.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Haven.Desktop.ViewModels"
             xmlns:views="using:Haven.Desktop.Views"
             xmlns:controls="using:Haven.Desktop.Controls"
             xmlns:pages="using:Haven.Desktop.Views.Pages.WorkspaceEditor"
             xmlns:studio="using:Haven.Desktop.Views.Pages.StudioProject"
             x:Class="Haven.Desktop.App"
             RequestedThemeVariant="Light">
  <!-- ============================================================
       Light Mint Theme
       Light mint gradient background, white panels, cyan accents
       ============================================================ -->

  <!-- Section: Defines reusable theme resources here so descendant controls resolve consistent values at runtime. -->
  <Application.Resources>
    <!-- Background: light mint gradient surfaces -->
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenBackgroundBrush" Color="#E8F5E9" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenElevatedBrush" Color="#FFFFFF" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenPanelBrush" Color="#FFFFFF" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenPanel2Brush" Color="#FAFAFA" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenPanel3Brush" Color="#F5F5F5" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenPanelHoverBrush" Color="#F0F0F0" />
    <!-- Text: dark hierarchy -->
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenTextBrush" Color="#1A1A1A" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenTextSoftBrush" Color="#666666" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenMutedBrush" Color="#999999" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenMuted2Brush" Color="#777777" />
    <!-- Accent: cyan -->
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenAccentBrush" Color="#00BCD4" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenAccentInkBrush" Color="#FFFFFF" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenAccentSoftBrush" Color="#E0F7FA" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenBlueBrush" Color="#00ACC1" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenBlueSoftBrush" Color="#E0F2F1" />
    <!-- Semantic -->
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenDangerBrush" Color="#D32F2F" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenWarningBrush" Color="#F9A825" />
    <!-- Borders -->
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenLineBrush" Color="#E0E0E0" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenLineStrongBrush" Color="#BDBDBD" />
    <!-- Sidebar accent nub -->
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenNubBrush" Color="#00BCD4" />
    <!-- Surface overlays -->
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenMicaSurfaceBrush" Color="#0A000000" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenMicaSidebarBrush" Color="#06000000" />
    <!-- Acrylic -->
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenAcrylicBrush" Color="#1AFFFFFF" />
    <!-- Section: Hosts the Color portion of this view at this position in the visual tree. -->
    <Color x:Key="HavenAcrylicTintColor">#F8F9FA</Color>
    <!-- Section: Hosts the Color portion of this view at this position in the visual tree. -->
    <Color x:Key="HavenAcrylicFallbackColor">#F2F8F9FA</Color>
    <!-- Buttons -->
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenButtonBrush" Color="#F5F5F5" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenButtonHoverBrush" Color="#EEEEEE" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenButtonPressedBrush" Color="#E0E0E0" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenFocusBrush" Color="#8000BCD4" />
    <!-- Semantic error/danger borders -->
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenErrorBrush" Color="#D32F2F" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenErrorBorderBrush" Color="#E57373" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenAccentBorderBrush" Color="#8000BCD4" />
    <!-- Section: Hosts the SolidColorBrush portion of this view at this position in the visual tree. -->
    <SolidColorBrush x:Key="HavenDangerBorderBrush" Color="#80D32F2F" />

    <!-- Reusable live acrylic primitive. Consumers can override its styled
         properties, while the defaults track the active Haven theme. -->
    <!-- Section: Hosts the ControlTheme portion of this view at this position in the visual tree. -->
    <ControlTheme x:Key="{x:Type controls:AcrylicSurface}" TargetType="controls:AcrylicSurface">
      <Setter Property="TintColor" Value="{DynamicResource HavenAcrylicTintColor}" />
      <Setter Property="FallbackColor" Value="{DynamicResource HavenAcrylicFallbackColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Template">
        <ControlTemplate TargetType="controls:AcrylicSurface">
          <Border CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  ClipToBounds="True">
            <ExperimentalAcrylicBorder CornerRadius="{TemplateBinding CornerRadius}">
              <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                             TintColor="{TemplateBinding TintColor}"
                                             TintOpacity="{TemplateBinding TintOpacity}"
                                             MaterialOpacity="{TemplateBinding MaterialOpacity}"
                                             FallbackColor="{TemplateBinding FallbackColor}" />
              </ExperimentalAcrylicBorder.Material>
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}" />
            </ExperimentalAcrylicBorder>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- Section: Hosts the ControlTheme portion of this view at this position in the visual tree. -->
    <ControlTheme x:Key="HavenAcrylicFlyoutPresenterTheme" TargetType="FlyoutPresenter">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="FlyoutPresenter">
          <controls:AcrylicSurface Padding="8">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </controls:AcrylicSurface>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- Section: Hosts the ControlTheme portion of this view at this position in the visual tree. -->
    <ControlTheme x:Key="HavenAcrylicMenuPresenterTheme" TargetType="MenuFlyoutPresenter"
                  BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}">
      <Setter Property="Width" Value="390" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="MenuFlyoutPresenter">
          <controls:AcrylicSurface Padding="8">
            <ScrollViewer MaxHeight="720" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter />
            </ScrollViewer>
          </controls:AcrylicSurface>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Application.Resources>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Application.Styles>
    <!-- Section: Hosts the FluentTheme portion of this view at this position in the visual tree. -->
    <FluentTheme />

    <!-- ============================================================
         BASE STYLES
         ============================================================ -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Montserrat, sans-serif" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="UserControl"><Setter Property="Background" Value="Transparent" /></Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Text variants -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBlock.soft"><Setter Property="Foreground" Value="{DynamicResource HavenTextSoftBrush}" /></Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource HavenMutedBrush}" /></Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBlock.muted2"><Setter Property="Foreground" Value="{DynamicResource HavenMuted2Brush}" /></Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="32" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBlock.sectionHeading"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource HavenMuted2Brush}" /></Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="PathIcon">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="PathIcon.muted"><Setter Property="Foreground" Value="{DynamicResource HavenMutedBrush}" /></Style>

    <!-- ============================================================
         BUTTONS — Vibrant, bold, Windows 11 style
         ============================================================ -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="{DynamicResource HavenButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Opacity" Value="0.97" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button:pointerover /template/ ContentPresenter">
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.025)" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Full-window click catchers close floating pickers. They must remain visually
         inert: inheriting the normal hover scale would make the entire chat flash. -->
    <Style Selector="Button.popupDismissLayer:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HavenButtonPressedBrush}" />
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource HavenFocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Chrome: transparent -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
    </Style>

    <!-- Ghost: transparent -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.ghost">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource HavenButtonBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineStrongBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.navigation">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.navigation:pointerover /template/ ContentPresenter">
    </Style>

    <!-- Status pill -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.status">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Product -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.product">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- ============================================================
         SIDEBAR — Windows 11 Settings style with accent nub
         ============================================================ -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.sidebar">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.sidebar:pointerover /template/ ContentPresenter">
    </Style>

    <!-- Active: accent nub only, no background tint -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.sidebarActive">
      <Setter Property="Background" Value="{DynamicResource HavenAccentSoftBrush}" />
    </Style>

    <!-- Utility buttons -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.sidebarUtility">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.sidebarUtility:pointerover /template/ ContentPresenter">
    </Style>

    <!-- Project identity -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.projectIdentity">
      <Setter Property="Background" Value="{DynamicResource HavenAccentSoftBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Choice -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.choice">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinWidth" Value="175" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- ============================================================
         TABS
         ============================================================ -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.workspaceTab">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="14,5,32,5" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.workspaceTab.active">
      <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.workspaceTab:pointerover /template/ ContentPresenter">
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.tabClose">
      <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="-26,3,3,3" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.tabClose:pointerover /template/ ContentPresenter">
    </Style>

    <!-- ============================================================
         ACCENT BUTTONS — Vibrant, bold, high contrast
         ============================================================ -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.primary">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource HavenAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.primary PathIcon"><Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" /></Style>

    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource HavenAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.accent PathIcon"><Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" /></Style>

    <!-- ============================================================
         ICON / SEND / STOP
         ============================================================ -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.icon.compact">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.send">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="{DynamicResource HavenAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.send PathIcon"><Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" /></Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.stop">
      <Setter Property="Background" Value="{DynamicResource HavenDangerBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.stop PathIcon"><Setter Property="Foreground" Value="#FFFFFF" /></Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.chip">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource HavenDangerBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    </Style>

    <!-- ============================================================
         TEXTBOX — Clean, minimal
         ============================================================ -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="SelectionBrush" Value="{DynamicResource HavenAccentBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource HavenAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
    </Style>

    <!-- Native editors inherit Haven's rounded, translucent surface instead of
         falling back to Avalonia's black/default focus chrome. -->
    <Style Selector="NumericUpDown,DatePicker,TimePicker">
      <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBox.composerInput">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="16,12,16,6" />
    </Style>

    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBox.sidebarSearch">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <!-- Reserve the left inset for the overlaid search glyph. -->
      <Setter Property="Padding" Value="38,6,10,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBox.sidebarSearch:pointerover /template/ Border#PART_BorderElement">
    </Style>

    <!-- ============================================================
         COMBOBOX
         ============================================================ -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="ComboBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource HavenAccentBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HavenAccentSoftBrush}" />
    </Style>

    <!-- ============================================================
         FLYOUT / MENU — Rounded popups
         ============================================================ -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="FlyoutPresenter">
      <Setter Property="Background" Value="#F0FFFFFF" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="#F0FFFFFF" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="MenuItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter">
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,5" />
    </Style>

    <!-- ============================================================
         BORDERS — Cards with subtle depth
         ============================================================ -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 2 8 0 #14000000" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.dashboardTile">
      <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #12000000" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.dashboardTile:pointerover">
      <Setter Property="Background" Value="{DynamicResource HavenPanel3Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineStrongBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.iconPlate">
      <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource HavenAccentSoftBrush}" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.iconPlate PathIcon"><Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" /></Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.statusPill">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource HavenButtonBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.warningPill">
      <Setter Property="CornerRadius" Value="999" /><Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="#20F9A825" /><Setter Property="BorderBrush" Value="#40F9A825" /><Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.agendaDot">
      <Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource HavenAccentBrush}" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.composer">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.avatar">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource HavenPanel3Brush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.permission">
      <Setter Property="Background" Value="{DynamicResource HavenAccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Separator"><Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" /></Style>
  </Application.Styles>

  <!-- Data templates -->
  <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
  <Application.DataTemplates>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:ChatPageViewModel}"><views:ChatView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:ChatGroupPageViewModel}"><views:ChatGroupView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:HomePageViewModel}"><views:HomeView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:CallPageViewModel}"><views:CallView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:PlanPageViewModel}"><views:PlanView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:CatalogPageViewModel}"><views:CatalogView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:AutomationsPageViewModel}"><views:AutomationsView /></DataTemplate>
    <!-- Section: BrowserPage is a UserControl stored directly as the tab page; no DataTemplate needed. -->
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:TrainingPageViewModel}"><views:TrainingView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}"><views:SettingsView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:LessonSettingsPageViewModel}"><views:LessonSettingsView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:WorkspaceHomePageViewModel}"><views:WorkspaceHomeView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:ProjectCreatorPageViewModel}"><views:ProjectCreatorView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type studio:StudioProjectPage}"><views:StudioProjectView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type pages:WorkspaceEditorPage}"><views:WorkspaceEditorView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:MacrosPageViewModel}"><views:MacrosView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:ArchivePageViewModel}"><views:ArchiveView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:ActivityLogPageViewModel}"><views:ActivityLogView /></DataTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
    <DataTemplate DataType="{x:Type vm:ModeLibraryPageViewModel}"><views:ModeLibraryView /></DataTemplate>
  </Application.DataTemplates>
</Application>
