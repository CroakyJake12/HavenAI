<Container Name="AddOverlay" Layout="Overlay" LayoutParticipation="Overlay" Width="100%" Height="100%" Visibility="Collapsed" ZIndex="100">
  <Button Name="Dismiss" Variant="Text" Content="" Width="100%" Height="100%" Background="Transparent" />
  <Container Name="Panels" Layout="Vertical" Width="100%" MaxWidth="900px" HorizontalAlignment="Center" VerticalAlignment="End" Margin="0px 0px 86px 0px" PointerEvents="ChildrenOnly" ZIndex="101">
    <Container Name="MainMenu" Layout="Vertical" Width="100%" Background="SurfaceRaised" BorderColor="AccentMuted" BorderWidth="1px" Radius="24px" Shadow="Card" Gap="4px" Padding="18px 20px">
      <Text Content="Attach to Chat" FontSize="18" FontWeight="700" Margin="0px 0px 6px 0px" />
      <Text Name="CurrentResponseState" Content="Default agent · Basic actions · Auto" Visibility="Collapsed" />
      <Button Name="AttachFiles" Variant="Text" IconKey="paperclip" Content="Files ⌄" Width="100%" MinHeight="42px" Padding="8px 6px" Radius="12px" FontSize="15" FontWeight="650" />
      <Button Name="Instructions" Variant="Text" IconKey="prompt" Content="Instructions (Skills) ⌄" Width="100%" MinHeight="42px" Padding="8px 6px" Radius="12px" FontSize="15" FontWeight="650" />
      <Button Name="Capabilities" Variant="Text" IconKey="bolt" Content="Capabilities (Plugins) ⌄" Width="100%" MinHeight="42px" Padding="8px 6px" Radius="12px" FontSize="15" FontWeight="650" />
      <Button Name="Agents" Variant="Text" IconKey="agents" Content="Agents ⌄" Width="100%" MinHeight="42px" Padding="8px 6px" Radius="12px" FontSize="15" FontWeight="650" />
      <Button Name="Apps" Variant="Text" IconKey="rocket" Content="Apps ⌄" Width="100%" MinHeight="42px" Padding="8px 6px" Radius="12px" FontSize="15" FontWeight="650" />
      <Button Name="MultipleResponses" Variant="Text" IconKey="agents" Content="Multiple Responses  ›" Width="100%" MinHeight="42px" Padding="8px 6px" Radius="12px" FontSize="15" FontWeight="650" />
      <Button Name="AllowActions" Variant="Text" IconKey="bolt" Content="Allow Actions  ›" Width="100%" MinHeight="42px" Padding="8px 6px" Radius="12px" FontSize="15" FontWeight="650" Visibility="Collapsed" />
      <Button Name="VisualResponses" Variant="Text" IconKey="browse" Content="Prefer Visual Responses  ›" Width="100%" MinHeight="42px" Padding="8px 6px" Radius="12px" FontSize="15" FontWeight="650" Visibility="Collapsed" />
    </Container>
    <Container Name="CatalogPanel" Layout="Vertical" Width="100%" Background="SurfaceRaised" BorderColor="AccentMuted" BorderWidth="1px" Radius="24px" Shadow="Card" Gap="6px" Padding="16px 20px" Visibility="Collapsed">
      <Input Name="CatalogSearch" Height="1px" Visibility="Collapsed" Placeholder="Search" />
      <Container Name="CatalogResults" Layout="Vertical" MaxHeight="340px" Gap="4px" Overflow="Scroll" />
    </Container>
  </Container>
</Container>
