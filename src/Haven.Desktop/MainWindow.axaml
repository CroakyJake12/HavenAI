<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/MainWindow.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.MainWindow. Its visual vocabulary includes: Window.Resources, ControlTheme, Setter, Style, Grid, Border, StackPanel, Button, Image, TextBlock, HavenIcon, Button.Flyout, MenuFlyout, MenuItem, MenuItem.Header, Menu, Separator, ScrollViewer, ItemsControl, ItemsControl.ItemsPanel, ItemsPanelTemplate, ItemsControl.ItemTemplate, DataTemplate, Button.ContextMenu, ContextMenu, Flyout, TextBox, UniformGrid, ContentControl, WrapPanel.
  Data flow: Binding expressions read or update these view-model paths: ProductName, NavigateHomeCommand, NavigateChatCommand, NavigateCallCommand, NavigateDoCommand, NavigateStudioCommand, NavigateBrowserCommand, NavigatePlanCommand, NavigateTrainingCommand, FileNewLabel, NewChatCommand, SupportsConversationCommands, FileNewContainerLabel, NewContainerCommand, CurrentChat.NewLessonCommand, IsTeach, NavigateArchiveCommand, NavigateSettingsCommand, SupportsEditingCommands, UndoCurrentCommand, RedoCurrentCommand, SaveCurrentCommand, CopyLastResponseCommand, DictateCommand, ToggleSidebarCommand, OpenCommandPaletteCommand, RefreshModelsCommand, NavigateTeachCommand, BranchCurrentCommand, ToggleTemporaryCommand, CompactCurrentCommand, ArchiveCurrentCommand, ConfigureModelCommand, ProjectMenuHeader, NavigateProjectHomeCommand, IsProjectOpen, NewProjectChatCommand, NavigateCurrentChatCommand, ContainerSettingsLabel, NavigateContainerSettingsCommand, NavigateAgentsCommand, NavigatePluginsCommand, NavigatePromptsCommand, NavigateAutomationsCommand, NavigateMacrosCommand, HasLiveCall, OpenLiveCallCommand, LiveCallLabel, EndLiveCallCommand, OllamaStatus, IsHorizontalTabsVisible, OpenTabs, IsSelected, Title, IsCloseable, AddNewTabCommand, HasFullSidebar, IsChatProduct, ChatTypeLabel, ActiveProjectName, ActiveProjectRoot, NewItemLabel, SearchQuery, CurrentChat.SelectQuickChatsCommand, ContainerHeading, CurrentChat.Containers, Name, Lessons, HasPinnedConversations, PinnedConversations, IsActive, OpenCommand, IsNormal, Meta, TogglePinCommand, BeginRenameCommand, BranchCommand, ArchiveCommand, DeleteCommand, IsRenaming, DraftTitle, SaveRenameCommand, CancelRenameCommand, IsDeleteConfirming, CancelDeleteCommand, ConfirmDeleteCommand, RecentHeading, HasRecentConversations, ShowNoProjectChats, RecentConversations, PinLabel, ActiveProjectPage.RefreshCommand, ActiveProjectPage.Files, Folder, ActiveProjectPage.BuildCommand, ActiveProjectPage.TestCommand, HasCompactSidebar, IsWorkspaceHeaderVisible, IsSidebarClosed, WorkspaceEyebrow, WorkspaceTitle, CurrentPage, IsCommandPaletteOpen, CloseCommandPaletteCommand, CommandSearch, CommandItems, RunCommand, Description, Shortcut, IsRenameOpen, CancelRenameCurrentCommand, RenameDraft, SaveRenameCurrentCommand, IsDeleteConfirmationOpen, CancelDeleteCurrentCommand, ConfirmDeleteCurrentCommand, Notifications, Id, Message, CompanionDock.HasCards, CompanionDock.ToggleExpandCommand, CompanionDock.CardCount, CompanionDock.Cards, CompanionDock.IsCollapsed, IsPinned, SurfaceIcon, CompanionDock.IsExpanded, SurfaceLabel.
  Interaction: Direct event handlers in this file are: OnWindowKeyDown, OnExitClicked, OnAboutClicked.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Haven.Desktop.Controls"
        x:Class="Haven.Desktop.MainWindow"
        Title="Haven"
        Width="1440" Height="920"
        MinWidth="1050" MinHeight="700"
        Icon="/Assets/haven.ico"
        KeyDown="OnWindowKeyDown"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur, Blur"
        TransparencyBackgroundFallback="#181818">

 <!-- Section: Defines reusable theme resources here so descendant controls resolve consistent values at runtime. -->
	<Window.Resources>

		<!-- Modern rounded icons (24×24 view box) — closed filled shapes for Avalonia PathIcon -->

  <!-- Section: Hosts the ControlTheme portion of this view at this position in the visual tree. -->
		<ControlTheme x:Key="MenuItemTheme"
					  TargetType="MenuItem"
					  BasedOn="{StaticResource {x:Type MenuItem}}">
   <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
			<Setter Property="Background" Value="Transparent" />
   <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
			<Setter Property="BorderBrush" Value="Transparent" />
   <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
			<Setter Property="BorderThickness" Value="0" />
   <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
			<Setter Property="CornerRadius" Value="6" />
   <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
			<Setter Property="Margin" Value="2,2" />
   <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
			<Setter Property="Padding" Value="14,10" />
   <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
			<Setter Property="MinHeight" Value="40" />
   <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
			<Style Selector="^:pointerover">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
				<Setter Property="Background" Value="{DynamicResource HavenPanelHoverBrush}" />
			</Style>
   <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
			<Style Selector="^:selected">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
				<Setter Property="Background" Value="{DynamicResource HavenPanelHoverBrush}" />
			</Style>
   <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
			<Style Selector="^:pressed">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
				<Setter Property="Background" Value="{DynamicResource HavenPanel3Brush}" />
			</Style>
   <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
			<Style Selector="^:disabled">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
				<Setter Property="Opacity" Value="0.45" />
			</Style>
		</ControlTheme>

	</Window.Resources>


	<!-- Main window layout: translucent title bar, tab strip and content surfaces over Mica. -->
 <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
	<Grid RowDefinitions="58,48,*"
		  Background="Transparent">

		<!-- A light tint preserves contrast without hiding the Windows backdrop. -->
  <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
		<Border Grid.RowSpan="3"
				Background="{DynamicResource HavenBackgroundBrush}"
				IsHitTestVisible="False" />

		<!-- ============================================================
         ROW 1: TITLE BAR (58px)
         Left: Product logo dropdown + main menu bar
         Right: Ollama status indicator + sidebar toggle
         ============================================================ -->
  <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
		<Border Margin="0,4,4,0"
				Background="Transparent"
				BorderBrush="Transparent"
				BorderThickness="0"
				CornerRadius="8" Grid.Row="1">
   <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
			<Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
				<!-- LEFT: Product logo + menu bar -->
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
				<StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
					<!-- Product logo dropdown — opens a menu to switch between Haven modes -->
					<Button Classes="product">

						<!-- Product selector -->
						<StackPanel Orientation="Horizontal"
									Spacing="8">

							<Image Source="/Assets/haven-32.png"
								   Width="22"
								   Height="22"
								   VerticalAlignment="Center" />

							<TextBlock Text="{Binding ProductName}"
									   FontWeight="Bold"
									   VerticalAlignment="Center" />

							<controls:HavenIcon IconKey="chevron-down"
									  Width="14"
									  Height="14"
									  Classes="muted"
									  VerticalAlignment="Center" />
						</StackPanel>

						<Button.Flyout>
							<MenuFlyout
								Placement="BottomEdgeAlignedLeft"
								VerticalOffset="6"
								FlyoutPresenterTheme="{StaticResource HavenAcrylicMenuPresenterTheme}">

								<!-- =====================================================
             HOME
             ===================================================== -->
								<MenuItem
									Theme="{StaticResource MenuItemTheme}"
									Command="{Binding NavigateHomeCommand}">

									<MenuItem.Header>
										<Grid Width="326"
											  ColumnDefinitions="26,*">

											<controls:HavenIcon
												Grid.Column="0"
												IconKey="home"
												Width="21"
												Height="21"
												Foreground="{DynamicResource HavenTextSoftBrush}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />

											<StackPanel
												Grid.Column="1"
												Margin="14,0,0,0"
												Spacing="2"
												VerticalAlignment="Center">

												<TextBlock
													Text="Haven Home"
													FontFamily="Montserrat"
													FontWeight="700"
													FontSize="15"
													Foreground="{DynamicResource HavenTextBrush}" />

												<TextBlock
													Text="Your Haven Dashboard"
													FontFamily="Montserrat"
													FontWeight="550"
													FontSize="11.5"
													Foreground="{DynamicResource HavenMutedBrush}"
													TextWrapping="Wrap" />

											</StackPanel>
										</Grid>
									</MenuItem.Header>
								</MenuItem>

								<!-- =====================================================
             CHAT
             ===================================================== -->
								<MenuItem
									Theme="{StaticResource MenuItemTheme}"
									Command="{Binding NavigateChatCommand}">

									<MenuItem.Header>
										<Grid Width="326"
											  ColumnDefinitions="26,*">

											<controls:HavenIcon
												Grid.Column="0"
												IconKey="chat"
												Width="21"
												Height="21"
												Foreground="{DynamicResource HavenTextSoftBrush}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />

											<StackPanel
												Grid.Column="1"
												Margin="14,0,0,0"
												Spacing="2"
												VerticalAlignment="Center">

												<TextBlock
													Text="Haven Chat"
													FontFamily="Montserrat"
													FontWeight="700"
													FontSize="15"
													Foreground="{DynamicResource HavenTextBrush}" />

												<TextBlock
													Text="Chat with Haven"
													FontFamily="Montserrat"
													FontWeight="550"
													FontSize="11.5"
													Foreground="{DynamicResource HavenMutedBrush}"
													TextWrapping="Wrap" />

											</StackPanel>
										</Grid>
									</MenuItem.Header>
								</MenuItem>

								<!-- =====================================================
             CALL
             No command was present in the original XAML.
             ===================================================== -->
								<MenuItem Theme="{StaticResource MenuItemTheme}" Command="{Binding NavigateCallCommand}">

									<MenuItem.Header>
										<Grid Width="326"
											  ColumnDefinitions="26,*">

											<controls:HavenIcon
												Grid.Column="0"
												IconKey="call"
												Width="21"
												Height="21"
												Foreground="{DynamicResource HavenTextSoftBrush}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />

											<StackPanel
												Grid.Column="1"
												Margin="14,0,0,0"
												Spacing="2"
												VerticalAlignment="Center">

												<TextBlock
													Text="Haven Call"
													FontFamily="Montserrat"
													FontWeight="700"
													FontSize="15"
													Foreground="{DynamicResource HavenTextBrush}" />

												<TextBlock
													Text="Have a live call with Haven"
													FontFamily="Montserrat"
													FontWeight="550"
													FontSize="11.5"
													Foreground="{DynamicResource HavenMutedBrush}"
													TextWrapping="Wrap" />

											</StackPanel>
										</Grid>
									</MenuItem.Header>
								</MenuItem>

								<!-- =====================================================
             DO
             ===================================================== -->
								<MenuItem
									Theme="{StaticResource MenuItemTheme}"
									Command="{Binding NavigateDoCommand}">

									<MenuItem.Header>
										<Grid Width="326"
											  ColumnDefinitions="26,*">

											<controls:HavenIcon
												Grid.Column="0"
												IconKey="tasks"
												Width="21"
												Height="21"
												Foreground="{DynamicResource HavenTextSoftBrush}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />

											<StackPanel
												Grid.Column="1"
												Margin="14,0,0,0"
												Spacing="2"
												VerticalAlignment="Center">

												<TextBlock
													Text="Haven Do"
													FontFamily="Montserrat"
													FontWeight="700"
													FontSize="15"
													Foreground="{DynamicResource HavenTextBrush}" />

												<TextBlock
													Text="Work with Haven"
													FontFamily="Montserrat"
													FontWeight="550"
													FontSize="11.5"
													Foreground="{DynamicResource HavenMutedBrush}"
													TextWrapping="Wrap" />

											</StackPanel>
										</Grid>
									</MenuItem.Header>
								</MenuItem>

								<!-- =====================================================
             STUDIO
             ===================================================== -->
								<MenuItem
									Theme="{StaticResource MenuItemTheme}"
									Command="{Binding NavigateStudioCommand}">

									<MenuItem.Header>
										<Grid Width="326"
											  ColumnDefinitions="26,*">

											<controls:HavenIcon
												Grid.Column="0"
												IconKey="studio"
												Width="21"
												Height="21"
												Foreground="{DynamicResource HavenTextSoftBrush}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />

											<StackPanel
												Grid.Column="1"
												Margin="14,0,0,0"
												Spacing="2"
												VerticalAlignment="Center">

												<TextBlock
													Text="Haven Studio"
													FontFamily="Montserrat"
													FontWeight="700"
													FontSize="15"
													Foreground="{DynamicResource HavenTextBrush}" />

												<TextBlock
													Text="Create and Manage Projects with Haven"
													FontFamily="Montserrat"
													FontWeight="550"
													FontSize="11.5"
													Foreground="{DynamicResource HavenMutedBrush}"
													TextWrapping="Wrap" />

											</StackPanel>
										</Grid>
									</MenuItem.Header>
								</MenuItem>

								<!-- =====================================================
             BROWSE
             ===================================================== -->
								<MenuItem
									Theme="{StaticResource MenuItemTheme}"
									Command="{Binding NavigateBrowserCommand}">

									<MenuItem.Header>
										<Grid Width="326"
											  ColumnDefinitions="26,*">

											<controls:HavenIcon
												Grid.Column="0"
												IconKey="browse"
												Width="21"
												Height="21"
												Foreground="{DynamicResource HavenTextSoftBrush}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />

											<StackPanel
												Grid.Column="1"
												Margin="14,0,0,0"
												Spacing="2"
												VerticalAlignment="Center">

												<TextBlock
													Text="Haven Browse"
													FontFamily="Montserrat"
													FontWeight="700"
													FontSize="15"
													Foreground="{DynamicResource HavenTextBrush}" />

												<TextBlock
													Text="Browse the Web with Haven"
													FontFamily="Montserrat"
													FontWeight="550"
													FontSize="11.5"
													Foreground="{DynamicResource HavenMutedBrush}"
													TextWrapping="Wrap" />

											</StackPanel>
										</Grid>
									</MenuItem.Header>
								</MenuItem>

								<!-- =====================================================
             PLAN
             No command was present in the original XAML.
             ===================================================== -->
								<MenuItem Theme="{StaticResource MenuItemTheme}" Command="{Binding NavigatePlanCommand}">

									<MenuItem.Header>
										<Grid Width="326"
											  ColumnDefinitions="26,*">

											<controls:HavenIcon
												Grid.Column="0"
												IconKey="plan"
												Width="21"
												Height="21"
												Foreground="{DynamicResource HavenTextSoftBrush}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />

											<StackPanel
												Grid.Column="1"
												Margin="14,0,0,0"
												Spacing="2"
												VerticalAlignment="Center">

												<TextBlock
													Text="Haven Plan"
													FontFamily="Montserrat"
													FontWeight="700"
													FontSize="15"
													Foreground="{DynamicResource HavenTextBrush}" />

												<TextBlock
													Text="Plan and Organise with Haven"
													FontFamily="Montserrat"
													FontWeight="550"
													FontSize="11.5"
													Foreground="{DynamicResource HavenMutedBrush}"
													TextWrapping="Wrap" />

											</StackPanel>
										</Grid>
									</MenuItem.Header>
								</MenuItem>

								<!-- =====================================================
             TRAINING
             ===================================================== -->
								<MenuItem
									Theme="{StaticResource MenuItemTheme}"
									Command="{Binding NavigateTrainingCommand}">

									<MenuItem.Header>
										<Grid Width="326"
											  ColumnDefinitions="26,*">

											<controls:HavenIcon
												Grid.Column="0"
												IconKey="training"
												Width="21"
												Height="21"
												Foreground="{DynamicResource HavenTextSoftBrush}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />

											<StackPanel
												Grid.Column="1"
												Margin="14,0,0,0"
												Spacing="2"
												VerticalAlignment="Center">

												<TextBlock
													Text="Haven Training"
													FontFamily="Montserrat"
													FontWeight="700"
													FontSize="15"
													Foreground="{DynamicResource HavenTextBrush}" />

												<TextBlock
													Text="Train Haven for better and more accurate responses"
													FontFamily="Montserrat"
													FontWeight="550"
													FontSize="11.5"
													Foreground="{DynamicResource HavenMutedBrush}"
													TextWrapping="Wrap" />

											</StackPanel>
										</Grid>
									</MenuItem.Header>
								</MenuItem>

							</MenuFlyout>
						</Button.Flyout>
					</Button>
					<!-- Main menu bar — File, Edit, View, Chat, Project, Tools, Help -->
					<Menu>
						<!-- File: new chat, containers, home, archive, settings, exit -->
						<MenuItem Header="File">
							<MenuItem Header="{Binding FileNewLabel}" Command="{Binding NewChatCommand}" InputGesture="Ctrl+N" IsVisible="{Binding SupportsConversationCommands}" />
							<MenuItem Header="{Binding FileNewContainerLabel}" Command="{Binding NewContainerCommand}" IsVisible="{Binding SupportsConversationCommands}" />
							<MenuItem Header="New lesson" Command="{Binding CurrentChat.NewLessonCommand}" IsVisible="{Binding IsTeach}" />
							<MenuItem Header="Home" Command="{Binding NavigateHomeCommand}" />
							<Separator />
							<MenuItem Header="Archive" Command="{Binding NavigateArchiveCommand}" IsVisible="{Binding SupportsConversationCommands}" />
							<MenuItem Header="Settings" Command="{Binding NavigateSettingsCommand}" />
							<Separator />
							<MenuItem Header="Exit" Click="OnExitClicked" />
						</MenuItem>
						<!-- Edit: undo, redo, save, copy last response, dictate -->
						<MenuItem Header="Edit" IsVisible="{Binding SupportsEditingCommands}">
							<MenuItem Header="Undo" Command="{Binding UndoCurrentCommand}" InputGesture="Ctrl+Z" />
							<MenuItem Header="Redo" Command="{Binding RedoCurrentCommand}" InputGesture="Ctrl+Y" />
							<MenuItem Header="Save file" Command="{Binding SaveCurrentCommand}" InputGesture="Ctrl+S" />
							<Separator />
							<MenuItem Header="Copy last response" Command="{Binding CopyLastResponseCommand}" />
							<MenuItem Header="Read Conversation Aloud" Command="{Binding DictateCommand}" InputGesture="Win+H" />
						</MenuItem>
						<!-- View: toggle sidebar, command palette, refresh models -->
						<MenuItem Header="View">
							<MenuItem Header="Toggle sidebar" Command="{Binding ToggleSidebarCommand}" IsVisible="{Binding SupportsConversationCommands}" />
							<MenuItem Header="Command palette" Command="{Binding OpenCommandPaletteCommand}" InputGesture="Ctrl+K" />
							<MenuItem Header="Refresh models" Command="{Binding RefreshModelsCommand}" IsVisible="{Binding SupportsConversationCommands}" />
						</MenuItem>
						<!-- Chat: mode selection, branch, temporary, compact, archive, model config -->
						<MenuItem Header="Chat" IsVisible="{Binding SupportsConversationCommands}">
							<MenuItem Header="General chat" Command="{Binding NavigateChatCommand}" />
							<MenuItem Header="Teaching" Command="{Binding NavigateTeachCommand}" />
							<Separator />
							<MenuItem Header="Branch" Command="{Binding BranchCurrentCommand}" />
							<MenuItem Header="Temporary" Command="{Binding ToggleTemporaryCommand}" />
							<MenuItem Header="Compact context" Command="{Binding CompactCurrentCommand}" />
							<MenuItem Header="Archive current" Command="{Binding ArchiveCurrentCommand}" />
							<MenuItem Header="Configure model" Command="{Binding ConfigureModelCommand}" />
						</MenuItem>
						<!-- Project: project navigation, new container, project home, settings -->
						<MenuItem Header="{Binding ProjectMenuHeader}" IsVisible="{Binding SupportsConversationCommands}">
							<MenuItem Header="{Binding FileNewContainerLabel}" Command="{Binding NewContainerCommand}" />
							<MenuItem Header="Project home" Command="{Binding NavigateProjectHomeCommand}" IsVisible="{Binding IsProjectOpen}" />
							<MenuItem Header="New project chat" Command="{Binding NewProjectChatCommand}" IsVisible="{Binding IsProjectOpen}" />
							<MenuItem Header="Product home" Command="{Binding NavigateHomeCommand}" />
							<MenuItem Header="Current chat" Command="{Binding NavigateCurrentChatCommand}" />
							<MenuItem Header="{Binding ContainerSettingsLabel}" Command="{Binding NavigateContainerSettingsCommand}" />
						</MenuItem>
						<!-- Tools: agents, plugins, prompts, automations, macros, browse, training -->
						<MenuItem Header="Tools">
							<MenuItem Header="Agents" Command="{Binding NavigateAgentsCommand}" />
							<MenuItem Header="Plugins" Command="{Binding NavigatePluginsCommand}" />
							<MenuItem Header="Prompt Library" Command="{Binding NavigatePromptsCommand}" />
							<Separator />
							<MenuItem Header="Scheduled Actions" Command="{Binding NavigateAutomationsCommand}" />
							<MenuItem Header="Macros" Command="{Binding NavigateMacrosCommand}" />
							<MenuItem Header="Haven Browse" Command="{Binding NavigateBrowserCommand}" />
							<MenuItem Header="Haven Training" Command="{Binding NavigateTrainingCommand}" />
							<Separator />
							<MenuItem Header="Refresh models" Command="{Binding RefreshModelsCommand}" />
						</MenuItem>
						<!-- Help: feature discovery, about -->
						<MenuItem Header="Help">
							<MenuItem Header="Feature discovery" Command="{Binding OpenCommandPaletteCommand}" />
							<MenuItem Header="About Haven" Click="OnAboutClicked" />
						</MenuItem>
					</Menu>
				</StackPanel>
				<!-- RIGHT: Ollama status -->
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
					<Border Classes="statusPill" IsVisible="{Binding HasLiveCall}">
						<Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
							<Button Classes="subtle" Command="{Binding OpenLiveCallCommand}">
								<StackPanel Orientation="Horizontal" Spacing="7">
									<controls:HavenIcon IconKey="call" Width="15" Height="15" />
									<TextBlock Text="{Binding LiveCallLabel}" FontSize="11" />
								</StackPanel>
							</Button>
							<Button Grid.Column="1" Classes="danger icon compact" Command="{Binding EndLiveCallCommand}" ToolTip.Tip="End call">
								<controls:HavenIcon IconKey="hang-up" Width="14" Height="14" />
							</Button>
						</Grid>
					</Border>
					<!-- Ollama status indicator — green dot + status text, click to refresh -->
					<Button Classes="status"
							Command="{Binding RefreshModelsCommand}">
						<StackPanel Orientation="Horizontal"
									Spacing="8"
									VerticalAlignment="Center">
							<Border Width="9"
									Height="9"
									CornerRadius="999"
									Background="{DynamicResource HavenAccentBrush}"
									BoxShadow="0 0 10 0 #8083AFFF" />
							<TextBlock Text="{Binding OllamaStatus}"
									   FontSize="10"
									   MaxWidth="235"
									   TextTrimming="CharacterEllipsis"
									   VerticalAlignment="Center" />
							<controls:HavenIcon IconKey="refresh"
									  Width="13"
									  Height="13"
									  Foreground="{DynamicResource HavenMutedBrush}"
									  VerticalAlignment="Center" />
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ============================================================
         ROW 0: HORIZONTAL TAB BAR (48px)
         Scrollable row of open workspace tabs. Each tab shows title + close button.
         Hidden when no tabs are open (IsHorizontalTabsVisible).
         ============================================================ -->
  <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
		<Border Grid.Row="0"
				Margin="10,3,10,5"
				ClipToBounds="False"
				IsVisible="{Binding IsHorizontalTabsVisible}">
   <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
			<Grid RowDefinitions="*,Auto">
    <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
				<Border Grid.Row="0"
						Background="{DynamicResource HavenPanelBrush}"
						BorderBrush="{DynamicResource HavenLineBrush}"
						BorderThickness="1"
						CornerRadius="16">
					<Grid ColumnDefinitions="*,Auto" Margin="8,0">
						<ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto">
							<ItemsControl ItemsSource="{Binding OpenTabs}" Margin="0,5">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="3" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Vertical"
											PointerEntered="Tab_PointerEntered" PointerExited="Tab_PointerExited">
									<Button Classes="workspaceTab" Classes.active="{Binding IsSelected}"
											Command="{Binding $parent[Window].DataContext.SelectTabCommand}"
											CommandParameter="{Binding}"
											MinWidth="80" MaxWidth="210">
										<TextBlock Text="{Binding Title}" MaxLines="1" TextTrimming="CharacterEllipsis" />
										<Button.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Close tab"
														  Command="{Binding $parent[Window].DataContext.CloseTabCommand}"
														  CommandParameter="{Binding}"
														  IsVisible="{Binding IsCloseable}" />
											</ContextMenu>
										</Button.ContextMenu>
									</Button>
									<!-- Accent nub: visible only when selected -->
									<Border Height="3" Margin="8,0"
											Background="{DynamicResource HavenAccentBrush}"
											CornerRadius="2"
											IsVisible="{Binding IsSelected}" />
								</StackPanel>
							</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						<!-- Plus button to add a new chat tab -->
						<Button Grid.Column="1"
								Classes="chrome"
								Command="{Binding AddNewTabCommand}"
								IsVisible="{Binding SupportsConversationCommands}"
								ToolTip.Tip="New chat tab"
								VerticalAlignment="Center"
								Margin="6,0,2,0">
							<controls:HavenIcon IconKey="plus"
									  Width="14"
									  Height="14"
									  VerticalAlignment="Center" />
						</Button>
					</Grid>
				</Border>
			</Grid>
		</Border>

		<!-- ============================================================
         ROW 2: MAIN CONTENT AREA
         Left: Sidebar (276px, collapsible)
         Right: Page content area with workspace header
         ============================================================ -->
  <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
		<Grid Grid.Row="2"
			  Margin="10,4,10,10"
			  ColumnDefinitions="Auto,Auto,*"
			  ColumnSpacing="10">

			<!-- ============================================================
           FULL SIDEBAR (260px wide)
           ============================================================ -->
   <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
			<Border Width="276"
					Background="{DynamicResource HavenElevatedBrush}"
					BorderBrush="Transparent"
					BorderThickness="0"
					CornerRadius="12"
					IsVisible="{Binding HasFullSidebar}">
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
				<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,13,12,11">

					<!-- Row 0: Sidebar identity — product name or project name -->
					<!-- Non-project mode: Chat mode selector dropdown -->
					<Grid ColumnDefinitions="*,Auto"
						  ColumnSpacing="6"
						  Margin="0,0,0,9"
						  IsVisible="{Binding !IsProjectOpen}">
						<Button Classes="product"
								IsVisible="{Binding IsChatProduct}"
								HorizontalContentAlignment="Stretch">
							<Grid ColumnDefinitions="Auto,*,Auto"
								  ColumnSpacing="9">
								<controls:HavenIcon IconKey="chat"
										  Width="18"
										  Height="18"
										  Foreground="{DynamicResource HavenMutedBrush}"
										  VerticalAlignment="Center" />
								<TextBlock Grid.Column="1"
										   Text="{Binding ChatTypeLabel}"
										   FontWeight="SemiBold"
										   VerticalAlignment="Center"
										   TextTrimming="CharacterEllipsis" />
								<controls:HavenIcon Grid.Column="2"
										  IconKey="chevron-down"
										  Width="12"
										  Height="12"
										  Foreground="{DynamicResource HavenMutedBrush}"
										  VerticalAlignment="Center" />
							</Grid>
							<Button.Flyout>
													<Flyout FlyoutPresenterTheme="{StaticResource HavenAcrylicFlyoutPresenterTheme}">
									<StackPanel Spacing="2">
										<Button Classes="sidebar" HorizontalAlignment="Stretch"
												Command="{Binding NavigateChatCommand}">
											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
												<controls:HavenIcon IconKey="chat" Width="18" Height="18"
														  Foreground="{DynamicResource HavenMutedBrush}" VerticalAlignment="Center" />
												<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="Haven Chat" FontWeight="SemiBold" />
													<TextBlock Text="Chat with Haven" Classes="muted" FontSize="10" />
												</StackPanel>
											</Grid>
										</Button>
										<Button Classes="sidebar" HorizontalAlignment="Stretch"
												Command="{Binding NavigateTeachCommand}">
											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
												<controls:HavenIcon IconKey="call" Width="18" Height="18"
														  Foreground="{DynamicResource HavenMutedBrush}" VerticalAlignment="Center" />
												<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="Teach" FontWeight="SemiBold" />
													<TextBlock Text="Learn with Haven" Classes="muted" FontSize="10" />
												</StackPanel>
											</Grid>
										</Button>
									</StackPanel>
								</Flyout>
							</Button.Flyout>
						</Button>
						<Button Grid.Column="1"
								Classes="chrome"
								Command="{Binding ToggleSidebarCommand}"
								ToolTip.Tip="Collapse sidebar">
							<controls:HavenIcon IconKey="chevron-left"
									  Width="14"
									  Height="14" />
						</Button>
					</Grid>
					<!-- Project mode: project name + root path -->
					<Grid ColumnDefinitions="*,Auto"
						  ColumnSpacing="6"
						  Margin="0,0,0,9"
						  IsVisible="{Binding IsProjectOpen}">
						<Button Classes="projectIdentity"
								Command="{Binding NavigateProjectHomeCommand}"
								HorizontalContentAlignment="Stretch">
							<Grid ColumnDefinitions="Auto,*"
								  ColumnSpacing="10">
								<controls:HavenIcon IconKey="folder"
										  Width="19"
										  Height="19"
										  Foreground="{DynamicResource HavenMutedBrush}"
										  VerticalAlignment="Center" />
								<StackPanel Grid.Column="1"
											Spacing="1"
											VerticalAlignment="Center">
									<TextBlock Text="{Binding ActiveProjectName}"
											   FontWeight="SemiBold"
											   MaxLines="1"
											   TextTrimming="CharacterEllipsis" />
									<TextBlock Text="{Binding ActiveProjectRoot}"
											   Classes="muted2"
											   FontSize="9"
											   MaxLines="1"
											   TextTrimming="CharacterEllipsis" />
								</StackPanel>
							</Grid>
						</Button>
						<Button Grid.Column="1"
								Classes="chrome"
								Command="{Binding ToggleSidebarCommand}"
								ToolTip.Tip="Collapse sidebar">
							<controls:HavenIcon IconKey="chevron-left"
									  Width="14"
									  Height="14" />
						</Button>
					</Grid>

					<!-- Row 1: New item button + home button -->
					<!-- Non-project mode: New chat + Home -->
					<Grid Grid.Row="1"
						  ColumnDefinitions="*,Auto"
						  ColumnSpacing="7"
						  IsVisible="{Binding !IsProjectOpen}">
						<Button Classes="primary"
								Command="{Binding NewChatCommand}"
								HorizontalAlignment="Stretch">
							<StackPanel Orientation="Horizontal"
										HorizontalAlignment="Center"
										Spacing="8">
								<controls:HavenIcon IconKey="plus"
										  Width="15"
										  Height="15"
										  VerticalAlignment="Center" />
								<TextBlock Text="{Binding NewItemLabel}"
										   VerticalAlignment="Center" />
							</StackPanel>
						</Button>
					</Grid>
					<!-- Project mode: New project chat + Project home -->
					<Grid Grid.Row="1"
						  ColumnDefinitions="*,Auto"
						  ColumnSpacing="7"
						  IsVisible="{Binding IsProjectOpen}">
						<Button Classes="primary"
								Command="{Binding NewProjectChatCommand}"
								HorizontalAlignment="Stretch">
							<StackPanel Orientation="Horizontal"
										HorizontalAlignment="Center"
										Spacing="8">
								<controls:HavenIcon IconKey="plus"
										  Width="15"
										  Height="15"
										  VerticalAlignment="Center" />
								<TextBlock Text="New project chat"
										   VerticalAlignment="Center" />
							</StackPanel>
						</Button>
						<Button Grid.Column="1"
								Classes="icon"
								Command="{Binding NavigateProjectHomeCommand}"
								ToolTip.Tip="Project home">
							<controls:HavenIcon IconKey="home"
									  Width="17"
									  Height="17" />
						</Button>
					</Grid>

					<!-- Row 2: Search box — filters conversations by title or content -->
					<Grid Grid.Row="2"
						  Margin="0,8">
						<TextBox Text="{Binding SearchQuery}"
								 Classes="sidebarSearch"
								 PlaceholderText="Search chats" />
						<controls:HavenIcon IconKey="search"
								  Width="16"
								  Height="16"
								  Margin="12,0,0,0"
								  HorizontalAlignment="Left"
								  VerticalAlignment="Center"
								  Foreground="{DynamicResource HavenMutedBrush}"
								  IsHitTestVisible="False" />
					</Grid>

					<!-- Row 3: Scrollable conversation lists + project files -->
					<ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
						<StackPanel Spacing="3">

							<!-- Containers section (non-project mode only) -->
							<StackPanel IsVisible="{Binding !IsProjectOpen}">
								<StackPanel Margin="0,0,0,12">
									<Button Classes="sidebar" HorizontalAlignment="Stretch"
											IsVisible="{Binding IsTeach}"
											Command="{Binding CurrentChat.SelectQuickChatsCommand}">
										<StackPanel Orientation="Horizontal" Spacing="9">
											<controls:HavenIcon IconKey="chat" Width="17" Height="17" />
											<TextBlock Text="Quick Chats" />
										</StackPanel>
									</Button>
									<!-- Containers heading + add button -->
									<Grid ColumnDefinitions="*,Auto" Margin="9,0,3,5">
										<TextBlock Text="{Binding ContainerHeading}" Classes="eyebrow" />
										<Button Grid.Column="1"
                           Classes="chrome"
                           Command="{Binding NewContainerCommand}"
                           ToolTip.Tip="New container">
											<controls:HavenIcon IconKey="plus"
													  Width="14"
													  Height="14" />
										</Button>
									</Grid>
									<!-- Container list — each is a clickable sidebar button -->
								<ItemsControl ItemsSource="{Binding CurrentChat.Containers}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Button Classes="sidebar" HorizontalAlignment="Stretch" Command="{Binding $parent[Window].DataContext.SelectContainerCommand}" CommandParameter="{Binding}">
												<TextBlock Text="{Binding Name}" />
												<Button.ContextMenu>
													<ContextMenu>
														<MenuItem Header="Open" Command="{Binding $parent[Window].DataContext.SelectContainerCommand}" CommandParameter="{Binding}" />
														<Separator />
												<MenuItem Header="Archive" Command="{Binding $parent[Window].DataContext.DeleteContainerCommand}" CommandParameter="{Binding}" />
													</ContextMenu>
												</Button.ContextMenu>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
									<!-- Lessons section (Teach mode only) -->
									<StackPanel IsVisible="{Binding $parent[Window].DataContext.IsTeach}" Margin="12,7,0,0">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Text="Lessons" Classes="eyebrow" />
											<Button Grid.Column="1"
                         Classes="chrome"
                         Command="{Binding $parent[Window].DataContext.CurrentChat.NewLessonCommand}"
                         ToolTip.Tip="New lesson">
												<controls:HavenIcon IconKey="plus"
														  Width="14"
														  Height="14" />
											</Button>
										</Grid>
										<ItemsControl ItemsSource="{Binding $parent[Window].DataContext.CurrentChat.LessonGroups}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<StackPanel Margin="0,4,0,0">
														<TextBlock Text="{Binding Name}" Classes="eyebrow" Margin="8,3" />
														<ItemsControl ItemsSource="{Binding Lessons}">
															<ItemsControl.ItemTemplate>
																<DataTemplate>
																	<Button Classes="sidebar" Content="{Binding Name}" HorizontalAlignment="Stretch"
																			Command="{Binding $parent[Window].DataContext.CurrentChat.SelectLessonCommand}" CommandParameter="{Binding}">
																		<Button.ContextMenu>
																			<ContextMenu>
																				<MenuItem Header="Move up" Command="{Binding $parent[Window].DataContext.CurrentChat.MoveLessonUpCommand}" CommandParameter="{Binding}" />
																				<MenuItem Header="Move down" Command="{Binding $parent[Window].DataContext.CurrentChat.MoveLessonDownCommand}" CommandParameter="{Binding}" />
																				<Separator />
																				<MenuItem Header="Delete" Command="{Binding $parent[Window].DataContext.CurrentChat.DeleteLessonCommand}" CommandParameter="{Binding}" />
																			</ContextMenu>
																		</Button.ContextMenu>
																	</Button>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
													</StackPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<Border Classes="card" Margin="0,8,0,0" Padding="10"
												IsVisible="{Binding $parent[Window].DataContext.CurrentChat.ShowTeachEmptyState}">
											<StackPanel Spacing="4">
												<TextBlock Text="{Binding $parent[Window].DataContext.CurrentChat.TeachEmptyStateTitle}" FontWeight="SemiBold" />
												<TextBlock Text="{Binding $parent[Window].DataContext.CurrentChat.TeachEmptyStateMessage}" Classes="muted" FontSize="10" />
												<Button Content="Create subject" Classes="subtle"
														Command="{Binding $parent[Window].DataContext.NewContainerCommand}"
														/>
											</StackPanel>
										</Border>
									</StackPanel>
								</StackPanel>
							</StackPanel>

							<!-- Pinned conversations section -->
							<TextBlock Text="Pinned" Classes="eyebrow" Margin="9,0,0,5" IsVisible="{Binding HasPinnedConversations}" />
							<ItemsControl ItemsSource="{Binding PinnedConversations}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="0,1">
											<Grid>
												<!-- Normal state: sidebar button with title + meta + accent nub when active -->
												<Button Classes="sidebar" Classes.sidebarActive="{Binding IsActive}" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" IsVisible="{Binding IsNormal}">
													<Grid ColumnDefinitions="3,8,*">
														<!-- Accent nub: 3px wide colored bar on the left (visible when active) -->
														<Border Background="{DynamicResource HavenNubBrush}" CornerRadius="2" IsVisible="{Binding IsActive}" Margin="0,2,0,2"/>
														<StackPanel Grid.Column="2">
															<TextBlock Text="{Binding Title}" MaxLines="1" TextTrimming="CharacterEllipsis" />
															<TextBlock Text="{Binding Meta}" Classes="muted2" FontSize="9" />
														</StackPanel>
													</Grid>
													<Button.ContextMenu>
														<ContextMenu>
															<MenuItem Header="Open" Command="{Binding OpenCommand}" />
															<MenuItem Header="Unpin" Command="{Binding TogglePinCommand}" />
															<MenuItem Header="Rename" Command="{Binding BeginRenameCommand}" />
															<MenuItem Header="Branch" Command="{Binding BranchCommand}" />
															<MenuItem Header="Archive" Command="{Binding ArchiveCommand}" />
															<Separator />
															<MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
														</ContextMenu>
													</Button.ContextMenu>
												</Button>
												<!-- Renaming state: inline text box + save/cancel -->
												<Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsRenaming}" ColumnSpacing="4">
													<TextBox Text="{Binding DraftTitle}" />
													<Button Grid.Column="1"
                        Classes="icon"
                        Command="{Binding SaveRenameCommand}"
                        ToolTip.Tip="Save name">
														<controls:HavenIcon IconKey="check"
																  Width="14"
																  Height="14" />
													</Button>
													<Button Grid.Column="2"
												   Classes="icon"
												   Command="{Binding CancelRenameCommand}"
												   ToolTip.Tip="Cancel rename">
														<controls:HavenIcon IconKey="close"
																  Width="14"
																  Height="14" />
													</Button>
												</Grid>
												<!-- Delete confirmation state: warning + confirm/cancel buttons -->
												<Border Classes="permission" IsVisible="{Binding IsDeleteConfirming}">
													<StackPanel Spacing="5">
														<TextBlock Text="Delete this chat permanently?" FontSize="11" />
														<StackPanel Orientation="Horizontal" Spacing="5">
															<Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
															<Button Content="Delete" Classes="danger" Command="{Binding ConfirmDeleteCommand}" />
														</StackPanel>
													</StackPanel>
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Recent conversations section -->
							<TextBlock Text="{Binding RecentHeading}" Classes="eyebrow" Margin="9,11,0,5" IsVisible="{Binding HasRecentConversations}" />
							<TextBlock Text="No project chats yet. Use New project chat above." Classes="muted" FontSize="10" Margin="9,0,4,7" IsVisible="{Binding ShowNoProjectChats}" />
							<ItemsControl ItemsSource="{Binding RecentConversations}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="0,1">
											<Grid>
												<!-- Normal state: sidebar button with title + meta + accent nub when active -->
												<Button Classes="sidebar" Classes.sidebarActive="{Binding IsActive}" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" IsVisible="{Binding IsNormal}">
													<Grid ColumnDefinitions="3,8,*">
														<!-- Accent nub: 3px wide colored bar on the left (visible when active) -->
														<Border Background="{DynamicResource HavenNubBrush}" CornerRadius="2" IsVisible="{Binding IsActive}" Margin="0,2,0,2"/>
														<StackPanel Grid.Column="2">
															<TextBlock Text="{Binding Title}" MaxLines="1" TextTrimming="CharacterEllipsis" />
															<TextBlock Text="{Binding Meta}" Classes="muted2" FontSize="9" />
														</StackPanel>
													</Grid>
													<Button.ContextMenu>
														<ContextMenu>
															<MenuItem Header="Open" Command="{Binding OpenCommand}" />
															<MenuItem Header="{Binding PinLabel}" Command="{Binding TogglePinCommand}" />
															<MenuItem Header="Rename" Command="{Binding BeginRenameCommand}" />
															<MenuItem Header="Branch" Command="{Binding BranchCommand}" />
															<MenuItem Header="Archive" Command="{Binding ArchiveCommand}" />
															<Separator />
															<MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
														</ContextMenu>
													</Button.ContextMenu>
												</Button>
												<!-- Renaming state: inline text box + save/cancel -->
												<Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsRenaming}" ColumnSpacing="4">
													<TextBox Text="{Binding DraftTitle}" />
													<Button Grid.Column="1"
                        Classes="icon"
                        Command="{Binding SaveRenameCommand}"
                        ToolTip.Tip="Save name">
														<controls:HavenIcon IconKey="check"
																  Width="14"
																  Height="14" />
													</Button>
													<Button Grid.Column="2"
												   Classes="icon"
												   Command="{Binding CancelRenameCommand}"
												   ToolTip.Tip="Cancel rename">
														<controls:HavenIcon IconKey="close"
																  Width="14"
																  Height="14" />
													</Button>
												</Grid>
												<!-- Delete confirmation state: warning + confirm/cancel buttons -->
												<Border Classes="permission" IsVisible="{Binding IsDeleteConfirming}">
													<StackPanel Spacing="5">
														<TextBlock Text="Delete this chat permanently?" FontSize="11" />
														<StackPanel Orientation="Horizontal" Spacing="5">
															<Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
															<Button Content="Delete" Classes="danger" Command="{Binding ConfirmDeleteCommand}" />
														</StackPanel>
													</StackPanel>
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Project files section (project mode only) -->
							<StackPanel IsVisible="{Binding IsProjectOpen}" Margin="0,12,0,0">
								<!-- Files heading + Refresh button -->
								<Grid ColumnDefinitions="*,Auto"
									  Margin="9,0,3,6">
									<TextBlock Text="Project files"
											   Classes="eyebrow"
											   VerticalAlignment="Center" />
									<Button Grid.Column="1"
											Classes="chrome"
											Command="{Binding ActiveProjectPage.RefreshCommand}"
											ToolTip.Tip="Refresh project files">
										<StackPanel Orientation="Horizontal"
													Spacing="6">
											<controls:HavenIcon IconKey="refresh"
													  Width="13"
													  Height="13"
													  VerticalAlignment="Center" />
											<TextBlock Text="Refresh"
													   FontSize="10"
													   VerticalAlignment="Center" />
										</StackPanel>
									</Button>
								</Grid>
								<!-- File list — each file has a context menu with AI and Explorer actions -->
								<ItemsControl ItemsSource="{Binding ActiveProjectPage.Files}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Button Classes="sidebar"
													HorizontalAlignment="Stretch"
													Command="{Binding $parent[Window].DataContext.ActiveProjectPage.OpenFileCommand}"
													CommandParameter="{Binding}">
												<Button.ContextMenu>
													<ContextMenu>
														<MenuItem Header="Ask AI about this file"
																  Command="{Binding $parent[Window].DataContext.ActiveProjectPage.AskAiAboutFileCommand}"
																  CommandParameter="{Binding}" />
														<MenuItem Header="Reveal in Explorer"
																  Command="{Binding $parent[Window].DataContext.ActiveProjectPage.RevealInExplorerCommand}"
																  CommandParameter="{Binding}" />
													</ContextMenu>
												</Button.ContextMenu>
												<Grid ColumnDefinitions="Auto,*"
													  ColumnSpacing="10">
													<controls:HavenIcon IconKey="file"
															  Width="17"
															  Height="17"
															  Foreground="{DynamicResource HavenMutedBrush}"
															  VerticalAlignment="Center" />
													<StackPanel Grid.Column="1"
																Spacing="1"
																VerticalAlignment="Center">
														<TextBlock Text="{Binding Name}"
																   MaxLines="1"
																   TextTrimming="CharacterEllipsis" />
														<TextBlock Text="{Binding Folder}"
																   Classes="muted2"
																   FontSize="9"
																   MaxLines="1"
																   TextTrimming="CharacterEllipsis" />
													</StackPanel>
												</Grid>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</StackPanel>
					</ScrollViewer>

					<!-- Row 4: Utility buttons at bottom of sidebar -->
					<!-- Project mode: Build, Test, Project settings, Studio Home -->
					<StackPanel Grid.Row="4"
								Spacing="6"
								Margin="0,9,0,0"
								IsVisible="{Binding IsProjectOpen}">
						<Border Height="1"
								Background="{DynamicResource HavenLineBrush}"
								Margin="7,0,7,3" />
						<Grid ColumnDefinitions="*,*"
							  ColumnSpacing="6">
							<Button Classes="sidebarUtility"
									Command="{Binding ActiveProjectPage.BuildCommand}">
								<StackPanel Orientation="Horizontal"
											Spacing="7"
											HorizontalAlignment="Center">
									<controls:HavenIcon IconKey="build"
											  Width="15"
											  Height="15"
											  VerticalAlignment="Center" />
									<TextBlock Text="Build"
											   VerticalAlignment="Center" />
								</StackPanel>
							</Button>
							<Button Grid.Column="1"
									Classes="sidebarUtility"
									Command="{Binding ActiveProjectPage.TestCommand}">
								<StackPanel Orientation="Horizontal"
											Spacing="7"
											HorizontalAlignment="Center">
									<controls:HavenIcon IconKey="test"
											  Width="15"
											  Height="15"
											  VerticalAlignment="Center" />
									<TextBlock Text="Test"
											   VerticalAlignment="Center" />
								</StackPanel>
							</Button>
						</Grid>
						<Button Classes="sidebarUtility"
								Command="{Binding NavigateContainerSettingsCommand}"
								HorizontalAlignment="Stretch">
							<StackPanel Orientation="Horizontal"
										Spacing="8"
										HorizontalAlignment="Center">
								<controls:HavenIcon IconKey="settings"
										  Width="15"
										  Height="15"
										  VerticalAlignment="Center" />
								<TextBlock Text="Project settings"
										   VerticalAlignment="Center" />
							</StackPanel>
						</Button>
						<Button Classes="sidebarUtility"
								Command="{Binding NavigateHomeCommand}"
								HorizontalAlignment="Stretch">
							<StackPanel Orientation="Horizontal"
										Spacing="8"
										HorizontalAlignment="Center">
								<controls:HavenIcon IconKey="home"
										  Width="15"
										  Height="15"
										  VerticalAlignment="Center" />
								<TextBlock Text="Studio Home"
										   VerticalAlignment="Center" />
							</StackPanel>
						</Button>
					</StackPanel>
					<!-- Non-project mode: Agents, Plugins, Prompts, More tools, Archive, Settings -->
					<StackPanel Grid.Row="4"
								Spacing="6"
								Margin="0,9,0,0"
								IsVisible="{Binding !IsProjectOpen}">
						<Border Height="1"
								Background="{DynamicResource HavenLineBrush}"
								Margin="7,0,7,3" />
						<UniformGrid Columns="2">
							<Button Classes="sidebarUtility"
									Command="{Binding NavigateAgentsCommand}"
									Margin="0,0,3,3">
								<StackPanel Orientation="Horizontal"
											Spacing="7"
											HorizontalAlignment="Center">
									<controls:HavenIcon IconKey="agents"
											  Width="15"
											  Height="15" />
									<TextBlock Text="Agents" />
								</StackPanel>
							</Button>
							<Button Classes="sidebarUtility"
									Command="{Binding NavigatePluginsCommand}"
									Margin="3,0,0,3">
								<StackPanel Orientation="Horizontal"
											Spacing="7"
											HorizontalAlignment="Center">
									<controls:HavenIcon IconKey="plugin"
											  Width="15"
											  Height="15" />
									<TextBlock Text="Plugins" />
								</StackPanel>
							</Button>
							<Button Classes="sidebarUtility"
									Command="{Binding NavigatePromptsCommand}"
									Margin="0,0,3,3">
								<StackPanel Orientation="Horizontal"
											Spacing="7"
											HorizontalAlignment="Center">
									<controls:HavenIcon IconKey="prompt"
											  Width="15"
											  Height="15" />
									<TextBlock Text="Prompts" />
								</StackPanel>
							</Button>
							<Button Classes="sidebarUtility"
									Command="{Binding OpenCommandPaletteCommand}"
									Margin="3,0,0,3">
								<StackPanel Orientation="Horizontal"
											Spacing="7"
											HorizontalAlignment="Center">
									<controls:HavenIcon IconKey="more"
											  Width="15"
											  Height="15" />
									<TextBlock Text="More tools" />
								</StackPanel>
							</Button>
							<Button Classes="sidebarUtility"
									Command="{Binding NavigateArchiveCommand}"
									Margin="0,0,3,0">
								<StackPanel Orientation="Horizontal"
											Spacing="7"
											HorizontalAlignment="Center">
									<controls:HavenIcon IconKey="archive"
											  Width="15"
											  Height="15" />
									<TextBlock Text="Archive" />
								</StackPanel>
							</Button>
							<Button Classes="sidebarUtility"
									Command="{Binding NavigateSettingsCommand}"
									Margin="3,0,0,0">
								<StackPanel Orientation="Horizontal"
											Spacing="7"
											HorizontalAlignment="Center">
									<controls:HavenIcon IconKey="settings"
											  Width="15"
											  Height="15" />
									<TextBlock Text="Settings" />
								</StackPanel>
							</Button>
						</UniformGrid>
					</StackPanel>
				</Grid>
			</Border>

			<!-- ============================================================
           COMPACT SIDEBAR (56px wide, icon-only)
           Shown when sidebar is collapsed but not in browse/training mode
           ============================================================ -->
   <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
			<Border Grid.Column="1"
					Width="56"
					Background="{DynamicResource HavenElevatedBrush}"
					BorderBrush="Transparent"
					BorderThickness="0"
					CornerRadius="12"
					IsVisible="{Binding HasCompactSidebar}">
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
				<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="6,10,6,8">
					<!-- Expand button -->
					<Button Classes="icon"
							Command="{Binding ToggleSidebarCommand}"
							ToolTip.Tip="Expand sidebar"
							Margin="0,0,0,4">
						<controls:HavenIcon IconKey="menu"
								  Width="18" Height="18" />
					</Button>
					<!-- New chat -->
					<Button Grid.Row="1" Classes="icon"
							Command="{Binding NewChatCommand}"
							ToolTip.Tip="New chat"
							Margin="0,0,0,4">
						<controls:HavenIcon IconKey="plus" Width="18" Height="18" />
					</Button>
					<!-- Home -->
					<Button Grid.Row="2" Classes="icon"
							Command="{Binding NavigateHomeCommand}"
							ToolTip.Tip="Home"
							Margin="0,0,0,4">
						<controls:HavenIcon IconKey="home" Width="18" Height="18" />
					</Button>
					<!-- Bottom utility icons -->
					<StackPanel Grid.Row="4" Spacing="4">
						<Button Classes="icon"
								Command="{Binding NavigateAgentsCommand}"
								ToolTip.Tip="Agents">
							<controls:HavenIcon IconKey="agents" Width="18" Height="18" />
						</Button>
						<Button Classes="icon"
								Command="{Binding NavigateSettingsCommand}"
								ToolTip.Tip="Settings">
							<controls:HavenIcon IconKey="settings" Width="18" Height="18" />
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<!-- ============================================================
           PAGE CONTENT AREA (right of sidebar)
           Top: workspace header with breadcrumbs + actions
           Bottom: current page content (bound to CurrentPage ViewModel)
           ============================================================ -->
   <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
			<Border Grid.Column="2"
					Background="{DynamicResource HavenPanelBrush}"
					BorderBrush="{DynamicResource HavenLineBrush}"
					BorderThickness="1"
					CornerRadius="24"
					ClipToBounds="True"
					BoxShadow="0 12 34 0 #42000000">
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
				<Grid RowDefinitions="Auto,*">
					<!-- Workspace header bar — shown when in a workspace (not home) -->
					<Border Height="72"
							Margin="8,8,8,0"
							Padding="18,0"
							Background="{DynamicResource HavenPanelBrush}"
							BorderBrush="{DynamicResource HavenLineBrush}"
							BorderThickness="1"
							CornerRadius="17"
							IsVisible="{Binding IsWorkspaceHeaderVisible}">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<!-- Sidebar toggle — only visible when sidebar is closed -->
							<Button Classes="chrome"
									Command="{Binding ToggleSidebarCommand}"
									IsVisible="{Binding IsSidebarClosed}"
									Margin="0,0,10,0"
									ToolTip.Tip="Open sidebar">
								<controls:HavenIcon IconKey="menu"
										  Width="18"
										  Height="18" />
							</Button>

							<!-- Breadcrumb + page title -->
							<StackPanel Grid.Column="1"
										Spacing="2"
										VerticalAlignment="Center">
								<TextBlock Text="{Binding WorkspaceEyebrow}"
										   Classes="eyebrow" />
								<TextBlock Text="{Binding WorkspaceTitle}"
										   FontSize="18"
										   FontWeight="SemiBold" />
							</StackPanel>
						</Grid>
					</Border>

					<!-- Current page content — dynamically swaps based on navigation -->
					<ContentControl Grid.Row="1"
									Margin="6"
									Content="{Binding CurrentPage}" />
				</Grid>
			</Border>
		</Grid>

		<!-- ============================================================
         OVERLAY PANELS (span all 3 rows, shown on top of everything)
         ============================================================ -->

		<!-- Command Palette overlay — search bar + scrollable command list -->
  <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
		<Grid Grid.RowSpan="3"
			  IsVisible="{Binding IsCommandPaletteOpen}">
   <!-- Section: Exposes an explicit user action through a command or event handler. -->
			<Button Background="{DynamicResource HavenPanelBrush}"
					BorderThickness="0"
					Command="{Binding CloseCommandPaletteCommand}" />
   <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
			<Border Classes="card"
					Width="700"
					MaxHeight="650"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
				<Grid RowDefinitions="Auto,Auto,*"
					  RowSpacing="14">
					<Grid ColumnDefinitions="Auto,*,Auto"
						  ColumnSpacing="11">
						<Border Width="40"
								Height="40"
								Background="{DynamicResource HavenAccentSoftBrush}"
								BorderBrush="#5083AFFF"
								BorderThickness="1"
								CornerRadius="14">
							<controls:HavenIcon IconKey="commands"
									  Width="19"
									  Height="19"
									  Foreground="{DynamicResource HavenAccentBrush}"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center" />
						</Border>
						<StackPanel Grid.Column="1"
									Spacing="2"
									VerticalAlignment="Center">
							<TextBlock Text="Commands"
									   Classes="sectionHeading" />
							<TextBlock Text="Search actions, pages and features"
									   Classes="muted"
									   FontSize="10.5" />
						</StackPanel>
						<Button Grid.Column="2"
								Classes="chrome"
								Command="{Binding CloseCommandPaletteCommand}"
								ToolTip.Tip="Close command palette">
							<controls:HavenIcon IconKey="close"
									  Width="15"
									  Height="15" />
						</Button>
					</Grid>

					<Grid Grid.Row="1">
						<TextBox Text="{Binding CommandSearch}"
								 Classes="sidebarSearch"
								 PlaceholderText="Search commands and features" />
						<controls:HavenIcon IconKey="search"
								  Width="16"
								  Height="16"
								  Margin="12,0,0,0"
								  HorizontalAlignment="Left"
								  VerticalAlignment="Center"
								  Foreground="{DynamicResource HavenMutedBrush}"
								  IsHitTestVisible="False" />
					</Grid>

					<ScrollViewer Grid.Row="2"
								  VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding CommandItems}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Button Classes="sidebar"
											HorizontalAlignment="Stretch"
											Command="{Binding RunCommand}">
										<Grid ColumnDefinitions="Auto,*,Auto"
											  ColumnSpacing="11">
											<Border Width="34"
													Height="34"
													Background="{DynamicResource HavenPanelBrush}"
													BorderBrush="{DynamicResource HavenLineBrush}"
													BorderThickness="1"
													CornerRadius="11"
													VerticalAlignment="Center">
												<controls:HavenIcon IconKey="commands"
														  Width="15"
														  Height="15"
														  Foreground="{DynamicResource HavenMutedBrush}"
														  HorizontalAlignment="Center"
														  VerticalAlignment="Center" />
											</Border>
											<StackPanel Grid.Column="1"
														Spacing="2"
														VerticalAlignment="Center">
												<TextBlock Text="{Binding Name}"
														   FontWeight="SemiBold" />
												<TextBlock Text="{Binding Description}"
														   Classes="muted"
														   FontSize="10"
														   TextWrapping="Wrap" />
											</StackPanel>
											<Border Grid.Column="2"
													Padding="8,4"
													Background="{DynamicResource HavenPanelBrush}"
													BorderBrush="{DynamicResource HavenLineBrush}"
													BorderThickness="1"
													CornerRadius="9"
													VerticalAlignment="Center">
												<TextBlock Text="{Binding Shortcut}"
														   Classes="muted"
														   FontSize="10" />
											</Border>
										</Grid>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>


		<!-- Rename dialog overlay — text input + save/cancel -->
  <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
		<Grid Grid.RowSpan="3"
			  IsVisible="{Binding IsRenameOpen}">
   <!-- Section: Exposes an explicit user action through a command or event handler. -->
			<Button Background="{DynamicResource HavenPanelBrush}"
					BorderThickness="0"
					Command="{Binding CancelRenameCurrentCommand}" />
   <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
			<Border Classes="card"
					Width="450"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
				<StackPanel Spacing="15">
					<Grid ColumnDefinitions="Auto,*"
						  ColumnSpacing="11">
						<Border Width="40"
								Height="40"
								Background="{DynamicResource HavenAccentSoftBrush}"
								BorderBrush="#5083AFFF"
								BorderThickness="1"
								CornerRadius="14">
							<controls:HavenIcon IconKey="edit"
									  Width="18"
									  Height="18"
									  Foreground="{DynamicResource HavenAccentBrush}"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center" />
						</Border>
						<StackPanel Grid.Column="1"
									Spacing="2"
									VerticalAlignment="Center">
							<TextBlock Text="Rename chat"
									   Classes="sectionHeading" />
							<TextBlock Text="Choose a clear name for this conversation."
									   Classes="muted"
									   FontSize="10.5" />
						</StackPanel>
					</Grid>

					<TextBox Text="{Binding RenameDraft}" />

					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Right"
								Spacing="8">
						<Button Command="{Binding CancelRenameCurrentCommand}">
							<StackPanel Orientation="Horizontal"
										Spacing="7">
								<controls:HavenIcon IconKey="close"
										  Width="13"
										  Height="13" />
								<TextBlock Text="Cancel" />
							</StackPanel>
						</Button>
						<Button Classes="accent"
								Command="{Binding SaveRenameCurrentCommand}">
							<StackPanel Orientation="Horizontal"
										Spacing="7">
								<controls:HavenIcon IconKey="check"
										  Width="13"
										  Height="13" />
								<TextBlock Text="Save" />
							</StackPanel>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>

		<!-- Delete confirmation overlay — warning message + confirm/cancel -->
  <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
		<Grid Grid.RowSpan="3"
			  IsVisible="{Binding IsDeleteConfirmationOpen}">
   <!-- Section: Exposes an explicit user action through a command or event handler. -->
			<Button Background="{DynamicResource HavenPanelBrush}"
					BorderThickness="0"
					Command="{Binding CancelDeleteCurrentCommand}" />
   <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
			<Border Classes="card"
					Width="470"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
				<StackPanel Spacing="15">
					<Grid ColumnDefinitions="Auto,*"
						  ColumnSpacing="11">
						<Border Width="40"
								Height="40"
								Background="{DynamicResource HavenAccentSoftBrush}"
								BorderBrush="#70E65F6B"
								BorderThickness="1"
								CornerRadius="14">
							<controls:HavenIcon IconKey="delete"
									  Width="18"
									  Height="18"
									  Foreground="{DynamicResource HavenDangerBrush}"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center" />
						</Border>
						<StackPanel Grid.Column="1"
									Spacing="2"
									VerticalAlignment="Center">
							<TextBlock Text="Delete this chat permanently?"
									   Classes="sectionHeading" />
							<TextBlock Text="This action cannot be undone."
									   Foreground="{DynamicResource HavenDangerBrush}"
									   FontSize="10.5" />
						</StackPanel>
					</Grid>

					<TextBlock Text="This removes the locally stored conversation and cannot be undone. Archive it instead if you may need it later."
							   Classes="muted"
							   TextWrapping="Wrap" />

					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Right"
								Spacing="8">
						<Button Command="{Binding CancelDeleteCurrentCommand}">
							<StackPanel Orientation="Horizontal"
										Spacing="7">
								<controls:HavenIcon IconKey="close"
										  Width="13"
										  Height="13" />
								<TextBlock Text="Cancel" />
							</StackPanel>
						</Button>
						<Button Classes="danger"
								Command="{Binding ConfirmDeleteCurrentCommand}">
							<StackPanel Orientation="Horizontal"
										Spacing="7">
								<controls:HavenIcon IconKey="delete"
										  Width="13"
										  Height="13" />
								<TextBlock Text="Delete permanently" />
							</StackPanel>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>

		<!-- ============================================================
         TOAST NOTIFICATIONS (bottom-right corner)
         Floating notification cards that auto-dismiss after 5 seconds.
         Stacked vertically, newest at bottom. Each card has:
         - Title (bold, single line)
         - Dismiss button (×)
         - Message (up to 3 lines, wraps)
         IsHitTestVisible=False on the container so toasts don't block
         clicks on the main UI. Individual cards are hit-testable.
         ============================================================ -->
  <!-- Section: Projects a bound collection into repeated UI without code-behind manually creating controls. -->
		<ItemsControl Grid.RowSpan="3"
					  ItemsSource="{Binding Notifications}"
					  HorizontalAlignment="Right"
					  VerticalAlignment="Bottom"
					  Margin="0,0,22,22"
					  IsHitTestVisible="False">
   <!-- Section: Projects a bound collection into repeated UI without code-behind manually creating controls. -->
			<ItemsControl.ItemTemplate>
    <!-- Section: Describes how one bound item is rendered while keeping its data object independent of Avalonia controls. -->
				<DataTemplate>
					<Border Background="{DynamicResource HavenPanel2Brush}"
							BorderBrush="{DynamicResource HavenLineStrongBrush}"
							BorderThickness="1"
							CornerRadius="18"
							Padding="14,12"
							Margin="0,0,0,9"
							MinWidth="300"
							MaxWidth="420"
							IsHitTestVisible="True"
							BoxShadow="0 12 34 0 #65000000">
						<Grid RowDefinitions="Auto,Auto"
							  ColumnDefinitions="Auto,*,Auto"
							  ColumnSpacing="10">
							<Border Width="31"
									Height="31"
									Background="{DynamicResource HavenAccentSoftBrush}"
									BorderBrush="#5083AFFF"
									BorderThickness="1"
									CornerRadius="10"
									VerticalAlignment="Top">
								<controls:HavenIcon IconKey="info"
										  Width="15"
										  Height="15"
										  Foreground="{DynamicResource HavenAccentBrush}"
										  HorizontalAlignment="Center"
										  VerticalAlignment="Center" />
							</Border>

							<TextBlock Grid.Column="1"
									   Text="{Binding Title}"
									   FontWeight="SemiBold"
									   FontSize="12"
									   VerticalAlignment="Center"
									   MaxLines="1"
									   TextTrimming="CharacterEllipsis" />

							<Button Grid.Column="2"
									Classes="chrome"
									Padding="5"
									MinWidth="28"
									MinHeight="28"
									Command="{Binding $parent[ItemsControl].DataContext.DismissNotificationCommand}"
									CommandParameter="{Binding Id}"
									ToolTip.Tip="Dismiss notification">
								<controls:HavenIcon IconKey="close"
										  Width="12"
										  Height="12" />
							</Button>

							<TextBlock Grid.Row="1"
									   Grid.Column="1"
									   Grid.ColumnSpan="2"
									   Text="{Binding Message}"
									   FontSize="11"
									   Foreground="{DynamicResource HavenMutedBrush}"
									   MaxLines="3"
									   TextWrapping="Wrap"
									   TextTrimming="CharacterEllipsis"
									   Margin="0,3,0,0" />
						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- ============================================================
             COMPANION DOCK (right edge, bottom area)
             Persistent dock for Browser, Planner, Call, and Do activity cards.
             Collapsed by default; expandable to show card list and active card content.
             Cards support pin, close, resize, and expand to full surface.
             ============================================================ -->
  <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
		<Border Grid.Row="2"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				Margin="0,0,22,22"
				IsVisible="{Binding CompanionDock.HasCards}"
				Background="{DynamicResource HavenPanelBrush}"
				BorderBrush="{DynamicResource HavenLineStrongBrush}"
				BorderThickness="1"
				CornerRadius="16"
				MinWidth="44"
				MaxWidth="280"
				MaxHeight="340"
				BoxShadow="0 8 24 0 #55000000">
   <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
			<Grid RowDefinitions="40,Auto,*">

				<!-- Dock header: toggle + card count -->
    <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
				<Border Grid.Row="0"
						Background="{DynamicResource HavenPanel2Brush}"
						CornerRadius="16,16,0,0">
					<Grid ColumnDefinitions="*,Auto">
						<Button Grid.Column="0"
								Classes="chrome"
								HorizontalAlignment="Left"
								Margin="10,0,0,0"
								VerticalAlignment="Center"
								Command="{Binding CompanionDock.ToggleExpandCommand}"
								ToolTip.Tip="Toggle companion dock">
							<StackPanel Orientation="Horizontal"
										Spacing="6">
								<controls:HavenIcon IconKey="dock-right"
										  Width="14"
										  Height="14" />
								<TextBlock Text="Companions"
										   FontSize="11"
										   FontWeight="SemiBold"
										   VerticalAlignment="Center" />
							</StackPanel>
						</Button>

						<Border Grid.Column="1"
								Background="{DynamicResource HavenAccentSoftBrush}"
								CornerRadius="8"
								Padding="6,2"
								Margin="0,0,10,0"
								VerticalAlignment="Center"
								IsVisible="{Binding CompanionDock.HasCards}">
							<TextBlock Text="{Binding CompanionDock.CardCount}"
									   FontSize="10"
									   FontWeight="Bold"
									   HorizontalAlignment="Center" />
						</Border>
					</Grid>
				</Border>

				<!-- Collapsed card indicators (dot row) -->
    <!-- Section: Projects a bound collection into repeated UI without code-behind manually creating controls. -->
				<ItemsControl Grid.Row="1"
							  ItemsSource="{Binding CompanionDock.Cards}"
							  IsVisible="{Binding CompanionDock.IsCollapsed}"
							  Margin="8,6,8,0">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Width="28"
									Height="28"
									CornerRadius="8"
									Background="{DynamicResource HavenPanel2Brush}"
									BorderBrush="{DynamicResource HavenLineBrush}"
									BorderThickness="1"
									Margin="2"
									ToolTip.Tip="{Binding Title}"
									Cursor="Hand"
									IsVisible="{Binding IsPinned}">
								<controls:HavenIcon IconKey="{Binding SurfaceIcon}"
										  Width="12"
										  Height="12"
										  HorizontalAlignment="Center"
										  VerticalAlignment="Center" />
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Expanded card list + active card content -->
    <!-- Section: Keeps the region usable when content exceeds the available window size. -->
				<ScrollViewer Grid.Row="2"
							  IsVisible="{Binding CompanionDock.IsExpanded}"
							  VerticalScrollBarVisibility="Auto"
							  Padding="6">
					<StackPanel Spacing="4">
						<!-- Card list -->
						<ItemsControl ItemsSource="{Binding CompanionDock.Cards}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="{DynamicResource HavenPanel2Brush}"
											BorderBrush="{DynamicResource HavenLineBrush}"
											BorderThickness="1"
											CornerRadius="10"
											Padding="8,6"
											Margin="0,0,0,3"
											IsVisible="{Binding IsPinned}">
										<Grid ColumnDefinitions="24,*,Auto,Auto">
											<!-- Surface icon -->
											<Border Width="22"
													Height="22"
													CornerRadius="6"
													Background="{DynamicResource HavenAccentSoftBrush}"
													VerticalAlignment="Center">
												<controls:HavenIcon IconKey="{Binding SurfaceIcon}"
														  Width="11"
														  Height="11"
														  HorizontalAlignment="Center"
														  VerticalAlignment="Center" />
											</Border>

											<!-- Title -->
											<StackPanel Grid.Column="1"
														Margin="8,0,0,0"
														VerticalAlignment="Center">
												<TextBlock Text="{Binding Title}"
														   FontSize="11"
														   FontWeight="SemiBold"
														   MaxLines="1"
														   TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding SurfaceLabel}"
														   FontSize="9"
														   Foreground="{DynamicResource HavenMutedBrush}" />
											</StackPanel>

											<!-- Expand button -->
											<Button Grid.Column="2"
													Classes="chrome"
													Padding="4"
													MinWidth="22"
													MinHeight="22"
													Command="{Binding $parent[ItemsControl].DataContext.CompanionDock.ExpandCardCommand}"
													CommandParameter="{Binding}"
													ToolTip.Tip="Toggle expand">
												<controls:HavenIcon IconKey="expand"
														  Width="10"
														  Height="10" />
											</Button>

											<!-- Close button -->
											<Button Grid.Column="3"
													Classes="chrome"
													Padding="4"
													MinWidth="22"
													MinHeight="22"
													Command="{Binding $parent[ItemsControl].DataContext.CompanionDock.CloseCardCommand}"
													CommandParameter="{Binding}"
													ToolTip.Tip="Close card">
												<controls:HavenIcon IconKey="close"
														  Width="10"
														  Height="10" />
											</Button>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Border>

	</Grid>
</Window>
