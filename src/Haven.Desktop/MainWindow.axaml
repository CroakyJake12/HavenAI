<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Haven.Desktop.Controls"
        x:Class="Haven.Desktop.MainWindow"
        Title="Haven"
        Width="1440" Height="920"
        MinWidth="1050" MinHeight="700"
        Icon="/Assets/haven.ico"
        RequestedThemeVariant="Light">
	
	<Window.Background>
		<LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
			<GradientStop Color="#FFFFFFFF" Offset="0" />
			<GradientStop Color="#FFF8FFF9" Offset="0.42" />
			<GradientStop Color="#FFCBFFD3" Offset="0.84" />
			<GradientStop Color="#FFBEFAF8" Offset="1" />
		</LinearGradientBrush>
	</Window.Background>

    <ContentControl x:Name="MainContent"/>

</Window>
