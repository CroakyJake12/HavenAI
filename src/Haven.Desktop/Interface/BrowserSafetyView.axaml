<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/BrowserSafetyView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.BrowserSafetyView. Its visual vocabulary includes: Border, Grid, StackPanel, TextBlock, Button, ProgressBar, TabControl, TabItem, ScrollViewer, ComboBox, ItemsControl, ItemsControl.ItemTemplate, DataTemplate.
  Data flow: Binding expressions read or update these view-model paths: RefreshCommand, Status, IsBusy, CurrentOrigin, PermissionStatus, PermissionKinds, SelectedPermissionKind, PermissionDecisions, SelectedPermissionDecision, SavePermissionCommand, RevokeOriginCommand, HasNoPermissions, Permissions, Origin, Kind, Decision, Updated, HasNoPending, Pending, Expires, Summary, Id, Audit, Result, Operation, Recorded, Detail, Downloads, FileName, Size, Completed, Path, Hash.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             x:Class="Haven.Desktop.Views.BrowserSafetyView"
             Width="520"
             MaxHeight="680">
  <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
  <hui:HavenAdaptiveSurface Background="{DynamicResource HavenElevatedBrush}"
          BorderBrush="{DynamicResource HavenLineStrongBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="14">
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel>
          <TextBlock Text="BROWSER SAFETY" Classes="eyebrow" />
          <TextBlock Text="Review permissions, submissions, downloads, and the browser audit trail" FontWeight="SemiBold" FontSize="16" />
          <TextBlock Text="Pending actions expire after ten minutes and are never resumed automatically after restart." Classes="muted" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
        <hui:HavenButton Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
        <hui:HavenProgressBar Grid.Column="1" Width="72" Height="4" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      </Grid>

      <hui:HavenTabView Grid.Row="2">
        <hui:HavenTabItem Header="Permissions">
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
            <StackPanel Spacing="9" Margin="0,8,0,0">
              <hui:HavenAdaptiveSurface Classes="soft" Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="CURRENT ORIGIN" Classes="eyebrow" />
                  <TextBlock Text="{Binding CurrentOrigin}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PermissionStatus}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Permission" Classes="muted2" FontSize="9" />
                      <hui:HavenComboBox ItemsSource="{Binding PermissionKinds}" SelectedItem="{Binding SelectedPermissionKind}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="Decision" Classes="muted2" FontSize="9" />
                      <hui:HavenComboBox ItemsSource="{Binding PermissionDecisions}" SelectedItem="{Binding SelectedPermissionDecision}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <hui:HavenButton Content="Save decision" Classes="accent" Command="{Binding SavePermissionCommand}" />
                    <hui:HavenButton Grid.Column="1" Content="Reset origin to Ask" Classes="danger" Command="{Binding RevokeOriginCommand}" />
                  </Grid>
                </StackPanel>
              </hui:HavenAdaptiveSurface>

              <hui:HavenAdaptiveSurface Classes="soft" Padding="12" IsVisible="{Binding HasNoPermissions}">
                <StackPanel Spacing="3">
                  <TextBlock Text="No saved site decisions" FontWeight="SemiBold" />
                  <TextBlock Text="Sites remain on Ask until you explicitly save Allow or Deny." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </hui:HavenAdaptiveSurface>

              <ItemsControl ItemsSource="{Binding Permissions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <hui:HavenAdaptiveSurface Classes="card" Margin="0,3" Padding="9">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                          <TextBlock Text="{Binding Origin}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource HavenAccentSecondaryBrush}" FontSize="10" />
                          <TextBlock Grid.Column="2" Text="{Binding Decision}" FontWeight="SemiBold" FontSize="10" />
                        </Grid>
                        <TextBlock Text="{Binding Updated}" Classes="muted2" FontSize="9" />
                      </StackPanel>
                    </hui:HavenAdaptiveSurface>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </hui:HavenTabItem>

        <hui:HavenTabItem Header="Approvals">
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
            <StackPanel Spacing="7" Margin="0,8,0,0">
              <hui:HavenAdaptiveSurface Classes="soft" Padding="12" IsVisible="{Binding HasNoPending}">
                <StackPanel Spacing="3">
                  <TextBlock Text="No pending actions" FontWeight="SemiBold" />
                  <TextBlock Text="Normal navigation, page reading, scrolling, and non-sensitive field filling do not appear here." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </hui:HavenAdaptiveSurface>
              <ItemsControl ItemsSource="{Binding Pending}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <hui:HavenAdaptiveSurface Classes="card" Margin="0,3" Padding="10">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="{Binding Expires}" Classes="muted2" FontSize="9" />
                        </Grid>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Origin}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                          <TextBlock Text="{Binding Id}" Classes="muted2" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <hui:HavenButton Grid.Column="1" Content="Reject" Classes="danger"
                                  Command="{Binding $parent[UserControl].DataContext.RejectCommand}"
                                  CommandParameter="{Binding}" />
                          <hui:HavenButton Grid.Column="2" Content="Approve" Classes="accent"
                                  Command="{Binding $parent[UserControl].DataContext.ApproveCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </StackPanel>
                    </hui:HavenAdaptiveSurface>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </hui:HavenTabItem>

        <hui:HavenTabItem Header="Audit">
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
            <ItemsControl ItemsSource="{Binding Audit}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <hui:HavenAdaptiveSurface Classes="card" Margin="0,3" Padding="9">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding Result}" FontWeight="SemiBold" FontSize="9" />
                        <TextBlock Grid.Column="1" Text="{Binding Operation}" Foreground="{DynamicResource HavenAccentSecondaryBrush}" FontSize="10" />
                        <TextBlock Grid.Column="2" Text="{Binding Recorded}" Classes="muted2" FontSize="9" />
                      </Grid>
                      <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Origin}" Classes="muted2" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </hui:HavenAdaptiveSurface>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </hui:HavenTabItem>

        <hui:HavenTabItem Header="Downloads">
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
            <ItemsControl ItemsSource="{Binding Downloads}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <hui:HavenAdaptiveSurface Classes="card" Margin="0,3" Padding="9">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="muted" FontSize="10" />
                        <TextBlock Grid.Column="2" Text="{Binding Completed}" Classes="muted2" FontSize="9" />
                      </Grid>
                      <TextBlock Text="{Binding Path}" Classes="muted" FontSize="9" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Hash}" Classes="muted2" FontSize="8" TextWrapping="Wrap" />
                    </StackPanel>
                  </hui:HavenAdaptiveSurface>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </hui:HavenTabItem>
      </hui:HavenTabView>
    </Grid>
  </hui:HavenAdaptiveSurface>
</UserControl>
