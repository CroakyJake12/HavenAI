<!--
  DefaultTheme.axaml — canonical HavenUI theme resources and styles.
-->

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Haven.Desktop.Controls"
        xmlns:hui="using:Haven.Desktop.HavenUI.Components"
        xmlns:floating="using:Haven.Desktop.HavenUI.Floating"
        xmlns:tokens="using:Haven.Desktop.HavenUI.Tokens">

  <!-- ============================================================
       RESOURCES — Brushes, Colors, Fonts
       ============================================================ -->
  <Styles.Resources>
    <FontFamily x:Key="HavenFontFamily">avares://Haven/Assets/Fonts/MontserratStatic#Montserrat</FontFamily>

    <!-- Background: light mint gradient surfaces -->
    <SolidColorBrush x:Key="HavenBackgroundBrush" Color="#E8F5E9" />
    <SolidColorBrush x:Key="HavenElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HavenPanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HavenPanel2Brush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="HavenPanel3Brush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="HavenPanelHoverBrush" Color="#F0F0F0" />

    <!-- Text: dark hierarchy -->
    <SolidColorBrush x:Key="HavenTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="HavenTextSoftBrush" Color="#666666" />
    <SolidColorBrush x:Key="HavenMutedBrush" Color="#999999" />
    <SolidColorBrush x:Key="HavenMuted2Brush" Color="#777777" />

    <!-- Live page accents. Every tier is a gradient; the colour resources are
         companion values for APIs such as focus/effects that require Color. -->
    <LinearGradientBrush x:Key="HavenAccentBrush" StartPoint="0%,50%" EndPoint="100%,50%">
      <GradientStop Color="#FF4B0B" Offset="0" />
      <GradientStop Color="#FF5F21" Offset="0.52" />
      <GradientStop Color="#D63A00" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HavenAccentPrimaryBrush" StartPoint="0%,50%" EndPoint="100%,50%">
      <GradientStop Color="#FF4B0B" Offset="0" />
      <GradientStop Color="#FF5F21" Offset="0.52" />
      <GradientStop Color="#D63A00" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HavenAccentSecondaryBrush" StartPoint="0%,50%" EndPoint="100%,50%">
      <GradientStop Color="#FF7A4B" Offset="0" />
      <GradientStop Color="#FF6C37" Offset="0.52" />
      <GradientStop Color="#FF5420" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HavenAccentTertiaryBrush" StartPoint="0%,50%" EndPoint="100%,50%">
      <GradientStop Color="#4A1C08" Offset="0" />
      <GradientStop Color="#351204" Offset="0.52" />
      <GradientStop Color="#5A2108" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HavenAccentPrimaryHoverBrush" StartPoint="0%,50%" EndPoint="100%,50%">
      <GradientStop Color="#FF5618" Offset="0" />
      <GradientStop Color="#FF682D" Offset="0.52" />
      <GradientStop Color="#E84A10" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HavenAccentSecondaryHoverBrush" StartPoint="0%,50%" EndPoint="100%,50%">
      <GradientStop Color="#FF8052" Offset="0" />
      <GradientStop Color="#FF7442" Offset="0.52" />
      <GradientStop Color="#FF602D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HavenAccentTertiaryHoverBrush" StartPoint="0%,50%" EndPoint="100%,50%">
      <GradientStop Color="#FF7144" Offset="0" />
      <GradientStop Color="#FF6334" Offset="0.52" />
      <GradientStop Color="#FF4F20" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HavenAccentPressedBrush" StartPoint="0%,50%" EndPoint="100%,50%">
      <GradientStop Color="#E7460C" Offset="0" />
      <GradientStop Color="#DB3D08" Offset="0.52" />
      <GradientStop Color="#BA3000" Offset="1" />
    </LinearGradientBrush>
    <Color x:Key="HavenAccentPrimaryColor">#FFFF5F21</Color>
    <Color x:Key="HavenAccentSecondaryColor">#FFFF6C37</Color>
    <Color x:Key="HavenAccentTertiaryColor">#FF351204</Color>
    <Color x:Key="HavenAccentPrimaryGlowColor">#C8FF5F21</Color>
    <Color x:Key="HavenAccentSecondaryGlowColor">#A8FF7A4B</Color>
    <Color x:Key="HavenAccentTertiaryGlowColor">#925A2108</Color>
    <SolidColorBrush x:Key="HavenAccentInkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HavenAccentSoftBrush" Color="#E0F7FA" />
    <SolidColorBrush x:Key="HavenBlueSoftBrush" Color="#E0F2F1" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="HavenDangerBrush" Color="#D32F2F" />
    <SolidColorBrush x:Key="HavenWarningBrush" Color="#F9A825" />

    <!-- Borders -->
    <SolidColorBrush x:Key="HavenLineBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="HavenLineStrongBrush" Color="#BDBDBD" />

    <!-- Sidebar accent nub -->
    <SolidColorBrush x:Key="HavenNubBrush" Color="#00BCD4" />

    <!-- Surface overlays -->
    <SolidColorBrush x:Key="HavenMicaSurfaceBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="HavenMicaSidebarBrush" Color="#06000000" />

    <!-- Acrylic -->
    <SolidColorBrush x:Key="HavenAcrylicBrush" Color="#1AFFFFFF" />
    <Color x:Key="HavenAcrylicTintColor">#F8F9FA</Color>
    <Color x:Key="HavenAcrylicFallbackColor">#F2F8F9FA</Color>

    <!-- Buttons -->
    <SolidColorBrush x:Key="HavenButtonBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="HavenButtonHoverBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="HavenButtonPressedBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="HavenFocusBrush" Color="#8000BCD4" />

    <!-- Semantic error/danger borders -->
    <SolidColorBrush x:Key="HavenErrorBrush" Color="#D32F2F" />
    <SolidColorBrush x:Key="HavenErrorBorderBrush" Color="#E57373" />
    <SolidColorBrush x:Key="HavenAccentBorderBrush" Color="#8000BCD4" />
    <SolidColorBrush x:Key="HavenDangerBorderBrush" Color="#80D32F2F" />

    <!-- Canonical HavenUI semantic colour tokens. Legacy resource names above
         remain aliases during migration; production components should prefer
         these role-based names. -->
    <SolidColorBrush x:Key="HavenBackgroundPrimaryBrush" Color="#E8F5E9" />
    <SolidColorBrush x:Key="HavenBackgroundSecondaryBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="HavenBackgroundElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HavenCardSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HavenOverlaySurfaceBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="HavenInputSurfaceBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="HavenTextPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="HavenTextSecondaryBrush" Color="#666666" />
    <SolidColorBrush x:Key="HavenTextMutedBrush" Color="#999999" />
    <SolidColorBrush x:Key="HavenTextDisabledBrush" Color="#88999999" />
    <SolidColorBrush x:Key="HavenBorderSubtleBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="HavenSeparatorBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="HavenStateHoverBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="HavenStatePressedBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="HavenStateSelectedBrush" Color="#E0F7FA" />
    <SolidColorBrush x:Key="HavenStateDisabledBrush" Color="#70F5F5F5" />
    <SolidColorBrush x:Key="HavenSuccessBrush" Color="#147A48" />
    <SolidColorBrush x:Key="HavenInformationBrush" Color="#00BCD4" />
    <SolidColorBrush x:Key="HavenLinkBrush" Color="#00ACC1" />
    <SolidColorBrush x:Key="HavenShadowBrush" Color="#52000000" />
    <SolidColorBrush x:Key="HavenAccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HavenButtonTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HavenButtonTextSecondaryBrush" Color="#FFF4EE" />

    <!-- Central geometry tokens are colour-mode invariant. -->
    <x:Double x:Key="HavenSpace1">4</x:Double>
    <x:Double x:Key="HavenSpace2">8</x:Double>
    <x:Double x:Key="HavenSpace3">12</x:Double>
    <x:Double x:Key="HavenSpace4">16</x:Double>
    <CornerRadius x:Key="HavenControlRadius">10</CornerRadius>
    <CornerRadius x:Key="HavenCardRadius">16</CornerRadius>
    <CornerRadius x:Key="HavenPopupRadius">20</CornerRadius>

    <!-- AcrylicSurface theme -->
    <ControlTheme x:Key="{x:Type controls:AcrylicSurface}" TargetType="controls:AcrylicSurface">
      <Setter Property="TintColor" Value="{DynamicResource HavenAcrylicTintColor}" />
      <Setter Property="FallbackColor" Value="{DynamicResource HavenAcrylicFallbackColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HavenLineStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Template">
        <ControlTemplate TargetType="controls:AcrylicSurface">
          <Border CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  ClipToBounds="True">
            <ExperimentalAcrylicBorder CornerRadius="{TemplateBinding CornerRadius}">
              <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                             TintColor="{TemplateBinding TintColor}"
                                             TintOpacity="{TemplateBinding TintOpacity}"
                                             MaterialOpacity="{TemplateBinding MaterialOpacity}"
                                             FallbackColor="{TemplateBinding FallbackColor}" />
              </ExperimentalAcrylicBorder.Material>
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}" />
            </ExperimentalAcrylicBorder>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- Flyout presenter themes -->
    <ControlTheme x:Key="HavenAcrylicFlyoutPresenterTheme" TargetType="FlyoutPresenter">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="FlyoutPresenter">
          <controls:AcrylicSurface Padding="8">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </controls:AcrylicSurface>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="HavenFloatingFlyoutPresenterTheme" TargetType="FlyoutPresenter">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="FlyoutPresenter">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="HavenAcrylicMenuPresenterTheme" TargetType="MenuFlyoutPresenter"
                  BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}">
      <Setter Property="Width" Value="390" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="MenuFlyoutPresenter">
          <controls:AcrylicSurface Padding="8">
            <ScrollViewer MaxHeight="720" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter />
            </ScrollViewer>
          </controls:AcrylicSurface>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <!-- ============================================================
       BASE STYLES
       ============================================================ -->
  <Style Selector="Window">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource HavenFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TemplatedControl">
    <Setter Property="FontFamily" Value="{StaticResource HavenFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="UserControl"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HavenFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Text variants -->
  <Style Selector="TextBlock.soft"><Setter Property="Foreground" Value="{DynamicResource HavenTextSoftBrush}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource HavenMutedBrush}" /></Style>
  <Style Selector="TextBlock.muted2"><Setter Property="Foreground" Value="{DynamicResource HavenMuted2Brush}" /></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="32" /><Setter Property="FontWeight" Value="ExtraBold" /></Style>
  <Style Selector="TextBlock.sectionHeading"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="Bold" /></Style>
  <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource HavenMuted2Brush}" /></Style>
  <Style Selector="PathIcon">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
  </Style>
  <Style Selector="PathIcon.muted"><Setter Property="Foreground" Value="{DynamicResource HavenMutedBrush}" /></Style>

  <!-- ============================================================
       BUTTONS — Vibrant, bold, Windows 11 style
       ============================================================ -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Background" Value="{DynamicResource HavenButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Opacity" Value="0.97" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.025)" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.popupDismissLayer:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HavenButtonPressedBrush}" />
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.42" /></Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource HavenFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Button variants -->
  <Style Selector="Button.chrome">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <!-- Mockup-defined compact desktop rail controls. These are deliberately
       separate from ordinary page buttons so the shell keeps its 42px rhythm. -->
  <Style Selector="Button.headerIcon">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.headerIcon.accent">
    <Setter Property="Background" Value="{DynamicResource HavenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" />
  </Style>
  <Style Selector="Button.headerPill">
    <Setter Property="Height" Value="42" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="Background" Value="{DynamicResource HavenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.headerPill.model">
    <Setter Property="Background" Value="#FFFF5B19" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource HavenButtonBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineStrongBrush}" />
  </Style>
  <Style Selector="Button.navigation">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.status">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.product">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <!-- Sidebar -->
  <Style Selector="Button.sidebar">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="Button.sidebarActive">
    <Setter Property="Background" Value="{DynamicResource HavenAccentSoftBrush}" />
  </Style>
  <Style Selector="Button.sidebarUtility">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.projectIdentity">
    <Setter Property="Background" Value="{DynamicResource HavenAccentSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.choice">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="MinWidth" Value="175" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.mockupSuggestion">
    <Setter Property="Height" Value="64" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="32" />
    <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
  </Style>

  <!-- Tabs -->
  <Style Selector="Button.workspaceTab">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="14,5,32,5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.workspaceTab.active">
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
  </Style>
  <Style Selector="Button.tabClose">
    <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="-26,3,3,3" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Accent buttons -->
  <Style Selector="Button.primary">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource HavenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource HavenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Icon / Send / Stop / Chip / Danger -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon.compact">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.send">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource HavenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentInkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.stop">
    <Setter Property="Background" Value="{DynamicResource HavenDangerBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource HavenDangerBrush}" />
  </Style>

  <!-- ============================================================
       TEXTBOX — Clean, minimal
       ============================================================ -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="SelectionBrush" Value="{DynamicResource HavenAccentBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource HavenAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
  </Style>
  <Style Selector="NumericUpDown,DatePicker,TimePicker">
    <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="TextBox.composerInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16,12,16,6" />
  </Style>
  <Style Selector="TextBox.sidebarSearch">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="38,6,10,6" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ============================================================
       COMBOBOX
       ============================================================ -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource HavenAccentBrush}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="{DynamicResource HavenBackgroundSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryHoverBrush}"/></Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}" />
  </Style>

  <!-- ============================================================
       FLYOUT / MENU — Rounded popups
       ============================================================ -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource HavenOverlaySurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="FlyoutPresenter /template/ Border#LayoutRoot">
    <Setter Property="BoxShadow" Value="0 18 50 0 #88000000" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource HavenOverlaySurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="MenuFlyoutPresenter /template/ Border#LayoutRoot">
    <Setter Property="BoxShadow" Value="0 18 50 0 #88000000" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextBrush}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <!-- ============================================================
       BORDERS — Cards with subtle depth
       ============================================================ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #14000000" />
  </Style>
  <Style Selector="Border.dashboardTile">
    <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 2 6 0 #12000000" />
  </Style>
  <Style Selector="Border.dashboardTile:pointerover">
    <Setter Property="Background" Value="{DynamicResource HavenPanel3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineStrongBrush}" />
  </Style>
  <Style Selector="Border.iconPlate">
    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource HavenAccentSoftBrush}" />
  </Style>
  <Style Selector="Border.statusPill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Background" Value="{DynamicResource HavenButtonBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.warningPill">
    <Setter Property="CornerRadius" Value="999" /><Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="#20F9A825" /><Setter Property="BorderBrush" Value="#40F9A825" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.agendaDot">
    <Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource HavenAccentBrush}" /><Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.composer">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource HavenPanel3Brush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.permission">
    <Setter Property="Background" Value="{DynamicResource HavenAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.havenFloatingRail">
    <Setter Property="Background" Value="{DynamicResource HavenElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="BoxShadow" Value="0 18 52 0 #76000000" />
  </Style>

  <!-- Caption buttons -->
  <Style Selector="Button.captionButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextSoftBrush}" />
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.captionClose:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#D9E44737" />
  </Style>
  <Style Selector="Button.captionClose:pointerover PathIcon">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ============================================================
       CANONICAL HAVENUI COMPONENTS
       These typed controls are the only supported common-control vocabulary
       for rebuilt screens. Visual state lives here, never in page XAML.
       ============================================================ -->

  <!-- Deck slide 3: buttons, glow morph and release bounce. -->
  <Style Selector=":is(Button).havenButton">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="28,0" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource HavenFontFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.17" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Button).havenButton:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.018)" />
  </Style>
  <Style Selector=":is(Button).havenButton:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
    <Setter Property="Background" Value="{DynamicResource HavenAccentPressedBrush}" />
  </Style>
  <Style Selector=":is(Button).havenButton.releaseBounce">
    <Setter Property="RenderTransform" Value="scale(1.045)" />
  </Style>

  <!-- Adaptive bridge: every still-composed route gets canonical motion,
       gradient inheritance and roles before its layout is fully recomposed. -->
  <Style Selector="hui|HavenButton">
    <Setter Property="Background" Value="{DynamicResource HavenAccentSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}" />
  </Style>
  <Style Selector="hui|HavenButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource HavenAccentSecondaryHoverBrush}" />
    <Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentSecondaryGlowColor}" BlurRadius="19" Opacity="0.64" /></Setter>
  </Style>
  <Style Selector="hui|HavenButton.primary, hui|HavenButton.accent">
    <Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}" />
  </Style>
  <Style Selector="hui|HavenButton.primary:pointerover, hui|HavenButton.accent:pointerover">
    <Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryHoverBrush}" />
    <Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentPrimaryGlowColor}" BlurRadius="24" Opacity="0.82" /></Setter>
  </Style>
  <Style Selector="hui|HavenButton.danger, hui|HavenButton.stop">
    <Setter Property="Background"><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#FFFF343D" Offset="0"/><GradientStop Color="#FFFF0C18" Offset="0.54"/><GradientStop Color="#FFE6000B" Offset="1"/></LinearGradientBrush></Setter>
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="hui|HavenButton.danger:pointerover, hui|HavenButton.stop:pointerover"><Setter Property="Effect"><DropShadowEffect Color="#B8FF1B25" BlurRadius="21" Opacity="0.70" /></Setter></Style>
  <Style Selector="hui|HavenButton.ghost">
    <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentSecondaryBrush}"/>
  </Style>
  <Style Selector="hui|HavenButton.icon, hui|HavenButton.chrome">
    <Setter Property="MinWidth" Value="44"/><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Background" Value="{DynamicResource HavenInputSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/>
  </Style>
  <Style Selector="hui|HavenButton.icon:pointerover, hui|HavenButton.chrome:pointerover"><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryHoverBrush}"/><Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentTertiaryGlowColor}" BlurRadius="15" Opacity="0.42"/></Setter></Style>
  <Style Selector="hui|HavenButton.sidebar"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="14,10"/><Setter Property="CornerRadius" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/></Style>
  <Style Selector="hui|HavenButton.sidebar:pointerover"><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/></Style>
  <Style Selector="hui|HavenButton.chip"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="12,4"/><Setter Property="CornerRadius" Value="15"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/></Style>

  <Style Selector="hui|HavenPrimaryButton">
    <Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}" />
  </Style>
  <Style Selector="hui|HavenPrimaryButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryHoverBrush}" />
    <Setter Property="Effect">
      <DropShadowEffect Color="{DynamicResource HavenAccentPrimaryGlowColor}" BlurRadius="24" Opacity="0.82" />
    </Setter>
  </Style>

  <Style Selector="hui|HavenSecondaryButton">
    <Setter Property="Background" Value="{DynamicResource HavenAccentSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}" />
  </Style>
  <Style Selector="hui|HavenSecondaryButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource HavenAccentSecondaryHoverBrush}" />
    <Setter Property="Effect">
      <DropShadowEffect Color="{DynamicResource HavenAccentSecondaryGlowColor}" BlurRadius="19" Opacity="0.64" />
    </Setter>
  </Style>

  <Style Selector="hui|HavenTertiaryButton">
    <Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentSecondaryBrush}" />
  </Style>
  <Style Selector="hui|HavenTertiaryButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}" />
    <Setter Property="Effect">
      <DropShadowEffect Color="{DynamicResource HavenAccentTertiaryGlowColor}" BlurRadius="16" Opacity="0.46" />
    </Setter>
  </Style>

  <Style Selector="hui|HavenNegativeButton">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#FFFF343D" Offset="0" />
        <GradientStop Color="#FFFF0C18" Offset="0.54" />
        <GradientStop Color="#FFE6000B" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="hui|HavenNegativeButton:pointerover">
    <Setter Property="Effect"><DropShadowEffect Color="#B8FF1B25" BlurRadius="21" Opacity="0.70" /></Setter>
  </Style>

  <Style Selector=":is(Button).havenText">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentSecondaryBrush}" />
  </Style>
  <Style Selector=":is(Button).havenText:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentPrimaryBrush}" />
  </Style>

  <Style Selector=":is(Button).havenIcon">
    <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" /><Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="22" />
    <Setter Property="Background" Value="{DynamicResource HavenInputSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(Button).havenIcon:pointerover">
    <Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryHoverBrush}" />
    <Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentTertiaryGlowColor}" BlurRadius="15" Opacity="0.42" /></Setter>
  </Style>
  <Style Selector=":is(Button).havenIcon.accent"><Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}"/></Style>

  <Style Selector=":is(Button).havenHeaderIcon">
    <Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" /><Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="21" />
    <Setter Property="Background" Value="{DynamicResource HavenBackgroundSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(Button).havenHeaderIcon.accent"><Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}"/></Style>
  <Style Selector=":is(Button).havenHeaderIcon:pointerover"><Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentPrimaryGlowColor}" BlurRadius="17" Opacity="0.56"/></Setter></Style>
  <Style Selector=":is(Button).havenLogo"><Setter Property="Width" Value="54"/><Setter Property="Height" Value="54"/><Setter Property="MinHeight" Value="54"/><Setter Property="Padding" Value="3"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector=":is(Button).havenHeaderPill">
    <Setter Property="Height" Value="42" /><Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="17,0" /><Setter Property="CornerRadius" Value="21" />
    <Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector=":is(Button).havenHeaderPill.negative"><Setter Property="Background" Value="{DynamicResource HavenDangerBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}"/></Style>

  <!-- Model picker intentionally owns its reasoning-level palette. -->
  <Style Selector=":is(Button).havenModelPicker">
    <Setter Property="Height" Value="42" /><Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="18,0" /><Setter Property="CornerRadius" Value="21" />
    <Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector=":is(Button).havenModelPicker.reasoningLow"><Setter Property="Background"><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#FFFFB640" Offset="0"/><GradientStop Color="#FFFF8A23" Offset="1"/></LinearGradientBrush></Setter></Style>
  <Style Selector=":is(Button).havenModelPicker.reasoningBalanced"><Setter Property="Background"><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#FFFF7A35" Offset="0"/><GradientStop Color="#FFFF4B0B" Offset="1"/></LinearGradientBrush></Setter></Style>
  <Style Selector=":is(Button).havenModelPicker.reasoningHigh"><Setter Property="Background"><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#FFFF4F2C" Offset="0"/><GradientStop Color="#FFE91C12" Offset="1"/></LinearGradientBrush></Setter></Style>
  <Style Selector=":is(Button).havenModelPicker.reasoningMax"><Setter Property="Background"><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#FFB650FF" Offset="0"/><GradientStop Color="#FF6D30E8" Offset="1"/></LinearGradientBrush></Setter></Style>
  <Style Selector=":is(Button).havenModelPicker:pointerover"><Setter Property="Effect"><DropShadowEffect Color="#B8FF5B19" BlurRadius="20" Opacity="0.72"/></Setter></Style>

  <Style Selector=":is(Button).havenNavigation">
    <Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="14" /><Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(Button).havenNavigation:pointerover"><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}" /></Style>
  <Style Selector=":is(Button).havenNavigation.selected"><Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}"/><Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentPrimaryGlowColor}" BlurRadius="14" Opacity="0.44"/></Setter></Style>

  <Style Selector=":is(Button).havenSuggestion">
    <Setter Property="MinHeight" Value="64" /><Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="32" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(Button).havenSuggestion:pointerover">
    <Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryHoverBrush}" />
    <Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentTertiaryGlowColor}" BlurRadius="18" Opacity="0.48" /></Setter>
  </Style>
  <Style Selector=":is(Button).havenChip"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="12,4"/><Setter Property="CornerRadius" Value="15"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/></Style>
  <Style Selector=":is(Button).havenMobileAction"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="11,7"/><Setter Property="CornerRadius" Value="15"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/></Style>
  <Style Selector=":is(Button).havenMobileAction:pointerover"><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryHoverBrush}"/></Style>

  <Style Selector=":is(Button).havenTab">
    <Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="0" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" /><Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector=":is(Button).havenTab.selected"><Setter Property="Foreground" Value="{DynamicResource HavenAccentSecondaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenAccentPrimaryBrush}"/></Style>
  <Style Selector="hui|HavenTabView"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="hui|HavenTabItem"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="14,8"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource HavenTextSecondaryBrush}"/></Style>
  <Style Selector="hui|HavenTabItem:selected"><Setter Property="Foreground" Value="{DynamicResource HavenAccentSecondaryBrush}"/></Style>
  <Style Selector="hui|HavenToggleButton"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="14,7"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="hui|HavenToggleButton:checked"><Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}"/><Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentPrimaryGlowColor}" BlurRadius="16" Opacity="0.48"/></Setter></Style>
  <Style Selector="hui|HavenExpander"><Setter Property="Background" Value="{DynamicResource HavenBackgroundSecondaryBrush}"/><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="18"/><Setter Property="FontWeight" Value="Bold"/></Style>

  <!-- Slide 4: input family. -->
  <Style Selector=":is(hui|HavenTextInput)">
    <Setter Property="MinHeight" Value="52" /><Setter Property="Padding" Value="20,0" />
    <Setter Property="CornerRadius" Value="26" /><Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="{DynamicResource HavenInputSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(hui|HavenTextInput):focus"><Setter Property="BorderBrush" Value="{DynamicResource HavenAccentPrimaryBrush}"/><Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentPrimaryGlowColor}" BlurRadius="14" Opacity="0.38"/></Setter></Style>
  <!-- Fluent's inner template focus border must use HavenUI tokens too. -->
  <Style Selector=":is(hui|HavenTextInput):focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource HavenAccentPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource HavenInputSurfaceBrush}" />
  </Style>
  <Style Selector=":is(hui|HavenTextInput):focus-visible /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource HavenAccentPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector=":is(hui|HavenTextInput):pointerover">
    <Setter Property="Background" Value="{DynamicResource HavenStateHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenAccentTertiaryBrush}" />
  </Style>
  <Style Selector=":is(hui|HavenTextInput):pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource HavenStateHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenAccentTertiaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=":is(hui|HavenTextInput) /template/ Button"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="hui|HavenSearchInput"><Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="18,0"/><Setter Property="CornerRadius" Value="23"/></Style>
  <Style Selector="hui|HavenMultilineInput"><Setter Property="MinHeight" Value="112"/><Setter Property="Padding" Value="18,15"/><Setter Property="CornerRadius" Value="24"/><Setter Property="VerticalContentAlignment" Value="Top"/></Style>
  <Style Selector="hui|HavenComboBox, hui|HavenNumericInput, hui|HavenSelect"><Setter Property="MinHeight" Value="48"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Background" Value="{DynamicResource HavenInputSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="18,0"/></Style>
  <Style Selector="hui|HavenSelect:pointerover"><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryHoverBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenAccentSecondaryBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="hui|HavenSlider">
    <Setter Property="MinHeight" Value="44"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource HavenBackgroundElevatedBrush}"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="hui:HavenSlider">
        <Grid Height="44" HorizontalAlignment="Stretch">
          <hui:HavenSliderTrack Name="HavenSliderVisibleTrack"
                                Height="18" Margin="8,0"
                                VerticalAlignment="Center"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                Value="{TemplateBinding Value}"
                                ActiveBrush="{DynamicResource HavenAccentPrimaryBrush}"
                                InactiveBrush="{DynamicResource HavenBackgroundElevatedBrush}" />
          <Track Name="PART_Track" Height="44"
                 HorizontalAlignment="Stretch"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}" Orientation="{TemplateBinding Orientation}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Background="Transparent" BorderThickness="0">
                <RepeatButton.Template>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="22" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Background="Transparent" BorderThickness="0">
                <RepeatButton.Template>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="22" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
            <Track.Thumb>
              <Thumb Width="34" Height="34">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#FFF8F0EC"
                            BorderBrush="{DynamicResource HavenAccentSecondaryBrush}" BorderThickness="2"
                            BoxShadow="0 4 14 0 #66000000" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="hui|HavenSlider:pointerover /template/ Thumb"><Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentPrimaryGlowColor}" BlurRadius="14" Opacity="0.48"/></Setter></Style>

  <Style Selector="hui|HavenProgressBar">
    <Setter Property="Height" Value="42"/><Setter Property="CornerRadius" Value="21"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource HavenBackgroundElevatedBrush}"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="hui:HavenProgressBar">
        <Border Height="42" CornerRadius="21" Background="{TemplateBinding Background}" ClipToBounds="True">
          <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="21"
                  Background="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="hui|HavenSwitch">
    <Setter Property="MinHeight" Value="40"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/><Setter Property="OnContent" Value=""/><Setter Property="OffContent" Value=""/>
    <Setter Property="Template">
      <ControlTemplate TargetType="hui:HavenSwitch">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Name="HavenSwitchTrack" Width="58" Height="30" CornerRadius="15"
                  Background="{DynamicResource HavenAccentSecondaryBrush}" Opacity="0.58">
            <Grid Name="PART_MovingKnobs">
              <Border Name="HavenSwitchThumb" Width="22" Height="22" CornerRadius="11"
                      Margin="4" HorizontalAlignment="Left" Background="#FFF8F0EC"
                      RenderTransformOrigin="50%,50%">
                <Border.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                  </Transitions>
                </Border.Transitions>
              </Border>
            </Grid>
          </Border>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="hui|HavenSwitch:checked /template/ Border#HavenSwitchTrack"><Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}"/><Setter Property="Opacity" Value="1"/><Setter Property="Effect"><DropShadowEffect Color="{DynamicResource HavenAccentPrimaryGlowColor}" BlurRadius="12" Opacity="0.40"/></Setter></Style>
  <Style Selector="hui|HavenSwitch:checked /template/ Border#HavenSwitchThumb"><Setter Property="RenderTransform" Value="translate(28px,0px)"/></Style>
  <Style Selector="hui|HavenCheckBox, hui|HavenRadioButton"><Setter Property="MinHeight" Value="38"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/></Style>
  <Style Selector="hui|HavenDatePicker, hui|HavenCalendarPicker, hui|HavenTimePicker"><Setter Property="MinHeight" Value="48"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Background" Value="{DynamicResource HavenInputSurfaceBrush}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>

  <!-- Slide 5: dropdown cards and rows. -->
  <Style Selector=":is(Button).havenDropdownItem">
    <Setter Property="MinHeight" Value="64"/><Setter Property="Padding" Value="18,12"/><Setter Property="CornerRadius" Value="16"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="{DynamicResource HavenBackgroundSecondaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/>
  </Style>
  <Style Selector=":is(Button).havenDropdownItem:pointerover"><Setter Property="Background" Value="{DynamicResource HavenAccentSecondaryHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}"/></Style>
  <Style Selector=":is(Button).havenDropdownItem.selected"><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenAccentSecondaryBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector=":is(Button).havenDropdownItem.important"><Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}"/></Style>
  <Style Selector=":is(Button).havenDropdownItem.negative"><Setter Property="Foreground" Value="{DynamicResource HavenDangerBrush}"/></Style>
  <Style Selector=":is(Button).havenDropdownItem.invisible"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="hui|HavenStickyDropdownHeader"><Setter Property="Background" Value="{DynamicResource HavenOverlaySurfaceBrush}"/><Setter Property="Padding" Value="14,12"/></Style>
  <Style Selector="hui|HavenContextMenu"><Setter Property="MinWidth" Value="220"/><Setter Property="Padding" Value="8"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Background" Value="{DynamicResource HavenOverlaySurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="hui|HavenMenuItem"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="12,8"/><Setter Property="CornerRadius" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="hui|HavenListBox"><Setter Property="Padding" Value="6"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="{DynamicResource HavenBackgroundSecondaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="hui|HavenListBoxItem"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="14,10"/><Setter Property="CornerRadius" Value="14"/></Style>
  <Style Selector="hui|HavenListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/></Style>

  <!-- Common surfaces, popups and mobile sheets. -->
  <Style Selector=":is(hui|HavenCard)">
    <Setter Property="Background" Value="{DynamicResource HavenCardSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="18"/><Setter Property="BoxShadow" Value="0 14 34 0 #66000000"/>
  </Style>
  <Style Selector=":is(hui|HavenCard):pointerover">
    <Setter Property="Background" Value="{DynamicResource HavenStateHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HavenAccentTertiaryBrush}" />
  </Style>
  <Style Selector="hui|HavenAdaptiveSurface.card, hui|HavenAdaptiveSurface.report-panel">
    <Setter Property="Background" Value="{DynamicResource HavenCardSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="18"/>
  </Style>
  <Style Selector="hui|HavenAdaptiveSurface.card:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource HavenAccentTertiaryBrush}"/><Setter Property="BoxShadow" Value="0 13 34 0 #52000000"/></Style>
  <Style Selector="hui|HavenAdaptiveSurface.soft"><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/><Setter Property="CornerRadius" Value="18"/></Style>
  <Style Selector="hui|HavenAdaptiveSurface.permission"><Setter Property="Background" Value="{DynamicResource HavenCardSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenAccentTertiaryBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/></Style>
  <Style Selector="hui|HavenAdaptiveSurface.statusPill"><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/><Setter Property="CornerRadius" Value="999"/></Style>
  <Style Selector="hui|HavenDropdownCard"><Setter Property="MinWidth" Value="360"/><Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="22"/><Setter Property="BoxShadow" Value="0 18 50 0 #88000000"/></Style>
  <Style Selector="hui|HavenPopupCard"><Setter Property="MinWidth" Value="520"/><Setter Property="MaxWidth" Value="760"/><Setter Property="MinHeight" Value="245"/><Setter Property="Padding" Value="22"/><Setter Property="CornerRadius" Value="24"/><Setter Property="BoxShadow" Value="0 24 70 0 #A8000000"/></Style>
  <Style Selector="hui|HavenMobileSheet"><Setter Property="MinWidth" Value="280"/><Setter Property="Padding" Value="20,18,20,28"/><Setter Property="CornerRadius" Value="26,26,0,0"/><Setter Property="BoxShadow" Value="0 -12 44 0 #99000000"/></Style>
  <Style Selector="hui|HavenPill"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="12,5"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/></Style>
  <Style Selector="hui|HavenDragHandle"><Setter Property="Width" Value="58"/><Setter Property="Height" Value="5"/><Setter Property="CornerRadius" Value="99"/><Setter Property="Background" Value="{DynamicResource HavenAccentSecondaryBrush}"/><Setter Property="Opacity" Value="0.72"/></Style>
  <Style Selector="hui|HavenSelectionIndicator"><Setter Property="Height" Value="2"/><Setter Property="CornerRadius" Value="1"/><Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}"/></Style>
  <Style Selector="hui|HavenComposerShell"><Setter Property="MinHeight" Value="58"/><Setter Property="Padding" Value="7"/><Setter Property="CornerRadius" Value="29"/><Setter Property="Background" Value="{DynamicResource HavenInputSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BoxShadow" Value="0 12 34 0 #70000000"/></Style>
  <Style Selector="hui|HavenSidebarSurface"><Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Background" Value="{DynamicResource HavenBackgroundSecondaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="hui|HavenEmptyState"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="28"/></Style>
  <Style Selector="hui|HavenPageSurface"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="32,24"/></Style>
  <Style Selector="tokens|HavenAccentScope"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style>
  <Style Selector="hui|HavenPanel"><Setter Property="Padding" Value="18"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="{DynamicResource HavenBackgroundSecondaryBrush}"/></Style>
  <Style Selector="floating|HavenFloatingSurface"><Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="28"/><Setter Property="Background" Value="{DynamicResource HavenOverlaySurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BoxShadow" Value="0 18 52 0 #70000000"/></Style>
  <Style Selector="floating|HavenFloatingSurface.voice"><Setter Property="MinWidth" Value="520"/><Setter Property="MaxWidth" Value="760"/></Style>
  <Style Selector="hui|HavenToolbar"><Setter Property="MinHeight" Value="54"/><Setter Property="Padding" Value="8"/><Setter Property="CornerRadius" Value="27"/><Setter Property="Background" Value="{DynamicResource HavenBackgroundSecondaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BoxShadow" Value="0 10 28 0 #66000000"/></Style>
  <Style Selector="hui|HavenNavigationRail"><Setter Property="Padding" Value="10"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Background" Value="{DynamicResource HavenBackgroundSecondaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="hui|HavenHeader"><Setter Property="MinHeight" Value="64"/><Setter Property="Padding" Value="18,10"/></Style>
  <Style Selector="hui|HavenFooter"><Setter Property="MinHeight" Value="58"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/></Style>
  <Style Selector="hui|HavenOverlay"><Setter Property="Background" Value="#99000000"/><Setter Property="Padding" Value="24"/></Style>

  <Style Selector="hui|HavenNotification"><Setter Property="Padding" Value="16,12"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Background" Value="{DynamicResource HavenOverlaySurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenAccentTertiaryBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="hui|HavenBadge"><Setter Property="MinWidth" Value="20"/><Setter Property="MinHeight" Value="20"/><Setter Property="Padding" Value="6,1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="{DynamicResource HavenAccentPrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentForegroundBrush}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="ExtraBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style Selector="hui|HavenStatusChip"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="11,4"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Background" Value="{DynamicResource HavenAccentTertiaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="hui|HavenLoadingState"><Setter Property="Padding" Value="30"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource HavenTextSecondaryBrush}"/></Style>
  <Style Selector="hui|HavenErrorState"><Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Background" Value="#28FF1825"/><Setter Property="Foreground" Value="#FFFF737B"/></Style>
  <Style Selector="hui|HavenProgressRing"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="{DynamicResource HavenAccentPrimaryBrush}"/></Style>

  <Style Selector="FlyoutPresenter.havenPopupPresenter, FlyoutPresenter.havenDropdownPresenter, FlyoutPresenter.havenMobilePopupPresenter, MenuFlyoutPresenter.havenMenuFlyoutPresenter"><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="FlyoutPresenter.havenAdaptivePopupPresenter">
    <Setter Property="Padding" Value="12"/><Setter Property="Background" Value="{DynamicResource HavenOverlaySurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HavenBorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="22"/>
  </Style>
  <Style Selector="ToolTip"><Setter Property="Background" Value="{DynamicResource HavenOverlaySurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource HavenTextPrimaryBrush}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="10,7"/></Style>

  <Style Selector="Separator"><Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}" /></Style>
</Styles>
