<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Styles/MagicalTheme.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs a resource-only Avalonia component. Its visual vocabulary includes: Styles, Style, Setter, Transitions, BrushTransition.
  Data flow: Binding expressions read or update these view-model paths: no direct Binding expressions; values are static or resource-driven.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Keep this file lightweight: app-wide visual defaults live here, while the moving
       aurora is drawn by MagicalBackdrop. Avoid shell-wide descendant selectors so page
       switches do not restyle every control in Chat and Settings. -->

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="Border.card">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="#94101A2D" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderBrush" Value="#3E8CF7EA" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderThickness" Value="1" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="CornerRadius" Value="18" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BoxShadow" Value="0 14 34 0 #48000000" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="Border.dashboardTile">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="#86101A2D" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderBrush" Value="#3A8CF7EA" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderThickness" Value="1" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="CornerRadius" Value="18" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BoxShadow" Value="0 12 30 0 #40000000" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="Border.permission">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="#50386CFF" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderBrush" Value="#66A45CFF" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderThickness" Value="1" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="Border.composer">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="#9510192B" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderBrush" Value="#408CF7EA" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="Border.magicalFloatingRail">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="#080A1120" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderBrush" Value="#5A86F7EA" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderThickness" Value="1" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="CornerRadius" Value="22" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BoxShadow" Value="0 18 52 0 #76000000" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="Button">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="Button.captionButton">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="Transparent" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderBrush" Value="Transparent" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderThickness" Value="0" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="CornerRadius" Value="10" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Foreground" Value="{DynamicResource HavenTextSoftBrush}" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="Button.captionButton:pointerover /template/ ContentPresenter">
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="Button.captionClose:pointerover /template/ ContentPresenter">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="#D9E44737" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="Button.captionClose:pointerover PathIcon">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="TextBox">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="#9A0D182B" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderBrush" Value="#3C8CF7EA" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="ComboBox">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="#9A0D182B" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderBrush" Value="#3C8CF7EA" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="FlyoutPresenter">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="#E0101A2D" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderBrush" Value="#5A86F7EA" />
  </Style>

  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <Style Selector="MenuFlyoutPresenter">
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="Background" Value="#E0101A2D" />
    <!-- Section: Hosts the Setter portion of this view at this position in the visual tree. -->
    <Setter Property="BorderBrush" Value="#5A86F7EA" />
  </Style>
</Styles>
