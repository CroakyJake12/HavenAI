<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Haven.Desktop.Controls">

  <!-- Floating glass rails. The live Gaussian backdrop blur is supplied by AcrylicSurface;
       these hosts add edge-light, separation and a quiet coloured glow. -->
  <Style Selector="Border.magicalFloatingRail">
    <Setter Property="Background" Value="#080A1120" />
    <Setter Property="BorderBrush" Value="#5A86F7EA" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="BoxShadow" Value="0 18 52 0 #76000000" />
  </Style>

  <Style Selector="Button.captionButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource HavenTextSoftBrush}" />
  </Style>

  <Style Selector="Button.captionButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#28FFFFFF" />
  </Style>

  <Style Selector="Button.captionClose:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#D9E44737" />
  </Style>

  <Style Selector="Button.captionClose:pointerover PathIcon">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Motion is opt-in through the shell's motionEnabled class. Removing that class makes
       every state change below immediate and also stops the animated aurora. -->
  <Style Selector="controls|WorkspaceChromeHost.motionEnabled Button">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.20" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.20" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.20" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|WorkspaceChromeHost.motionEnabled Button:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.018)" />
  </Style>

  <Style Selector="controls|WorkspaceChromeHost.motionEnabled Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.975)" />
  </Style>

  <Style Selector="controls|WorkspaceChromeHost.motionEnabled Button.workspaceTab:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.025)" />
  </Style>

  <Style Selector="controls|WorkspaceChromeHost.motionEnabled Button.captionButton:pointerover">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <Style Selector="controls|WorkspaceChromeHost.motionEnabled Border.card">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.24" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.24" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.20" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|WorkspaceChromeHost.motionEnabled TextBox">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
