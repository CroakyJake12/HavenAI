<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Controls.MessageBubble">

    <hui:HavenAdaptiveSurface x:Name="Bubble"
            MaxWidth="900"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource HavenCardSurfaceBrush}"
            BorderBrush="{DynamicResource HavenBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="22,18">
        <StackPanel Spacing="9">
            <TextBlock x:Name="RoleLabel"
                       FontWeight="Bold"
                       FontSize="12"
                       Foreground="{DynamicResource HavenTextBrush}" />
            <controls:ProductionMarkdownView x:Name="Body"
                                             Foreground="{DynamicResource HavenTextPrimaryBrush}" />
        </StackPanel>
    </hui:HavenAdaptiveSurface>
</UserControl>
