<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Controls.MessageBubble">

    <Border x:Name="Bubble"
            MaxWidth="900"
            HorizontalAlignment="Stretch"
            Background="#D2FFFFFF"
            BorderBrush="#2D000000"
            BorderThickness="1"
            CornerRadius="18"
            Padding="22,18">
        <StackPanel Spacing="9">
            <TextBlock x:Name="RoleLabel"
                       FontWeight="Bold"
                       FontSize="12"
                       Foreground="{DynamicResource HavenTextBrush}" />
            <controls:MarkdownView x:Name="Body"
                                   Foreground="{DynamicResource HavenTextBrush}" />
        </StackPanel>
    </Border>
</UserControl>
