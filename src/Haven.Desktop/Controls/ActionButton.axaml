<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Controls.ActionButton">

    <Button x:Name="Button"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            MinHeight="48"
            Padding="12,10"
            CornerRadius="14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <controls:HavenIcon x:Name="Icon"
                                Width="20" Height="20"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource HavenTextBrush}" />
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock x:Name="Label"
                           FontSize="14"
                           FontWeight="ExtraBold"
                           Foreground="{DynamicResource HavenTextBrush}" />
                <TextBlock x:Name="Description"
                           Classes="muted"
                           FontSize="10"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
