<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Haven.Desktop.Controls.ContextUsageFlyout">

  <StackPanel Width="250" Spacing="8">
    <TextBlock Text="Context" FontWeight="SemiBold" />
    <TextBlock x:Name="ContextLabel" Classes="muted" />
    <ProgressBar x:Name="ContextProgress" Maximum="100" />
    <Button x:Name="CompactButton" Content="Compact now" />
  </StackPanel>
</UserControl>
