<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Haven.Desktop.Views.ProviderConnectionsView">
  <Border Classes="card">
    <StackPanel Spacing="11">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="CLOUD PROVIDERS" Classes="eyebrow" />
          <TextBlock Text="Provider connections" Classes="sectionHeading" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
      </Grid>

      <TextBlock Text="Connect cloud accounts without replacing Ollama. API keys are stored in Windows Credential Manager and are never written to the provider settings file."
                 Classes="muted" FontSize="11" />

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemWidth="500" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="490" Margin="0,0,10,10" Classes="dashboardTile">
              <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding KindLabel}" Classes="muted2" FontSize="9" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="statusPill" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionLabel}" FontSize="10" />
                  </Border>
                </Grid>

                <StackPanel Spacing="4">
                  <TextBlock Text="Endpoint" Classes="muted" FontSize="10" />
                  <TextBox Text="{Binding Endpoint}" PlaceholderText="https://api.example.com/v1/" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="API key" Classes="muted" FontSize="10" />
                  <TextBox Text="{Binding ApiKey}" PasswordChar="●" PlaceholderText="{Binding ApiKeyHint}" />
                </StackPanel>

                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="7">
                  <Button Content="{Binding ConnectLabel}"
                          Classes="accent"
                          Command="{Binding $parent[UserControl].DataContext.ConnectCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding !IsBusy}" />
                  <Button Grid.Column="1" Content="Test"
                          Command="{Binding $parent[UserControl].DataContext.TestCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding IsConnected}" />
                  <Button Grid.Column="2" Content="Disconnect"
                          Classes="danger"
                          Command="{Binding $parent[UserControl].DataContext.DisconnectCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding IsConnected}" />
                  <TextBlock Grid.Column="3" Text="{Binding ModelSummary}" Classes="muted" FontSize="10"
                             HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding Status}" Classes="muted" FontSize="10" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding Status}" Classes="muted" />
    </StackPanel>
  </Border>
</UserControl>
