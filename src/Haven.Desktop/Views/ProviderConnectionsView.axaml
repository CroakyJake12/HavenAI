<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/ProviderConnectionsView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.ProviderConnectionsView. Its visual vocabulary includes: Border, StackPanel, Grid, TextBlock, Button, ItemsControl, ItemsControl.ItemsPanel, ItemsPanelTemplate, WrapPanel, ItemsControl.ItemTemplate, DataTemplate, TextBox, ProgressBar.
  Data flow: Binding expressions read or update these view-model paths: RefreshCommand, Items, DisplayName, KindLabel, ConnectionLabel, Endpoint, ApiKey, ApiKeyHint, ConnectLabel, CanConnect, CanTest, CanDisconnect, ModelSummary, IsBusy, Status.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             x:Class="Haven.Desktop.Views.ProviderConnectionsView">
  <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
  <hui:HavenAdaptiveSurface Classes="card">
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
    <StackPanel Spacing="11">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="CONNECTED SERVICES" Classes="eyebrow" />
          <TextBlock Text="Accounts and integrations" Classes="sectionHeading" Margin="0,4,0,0" />
        </StackPanel>
        <hui:HavenButton Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
      </Grid>
      <TextBlock Text="Haven opens the provider sign-in flow. Enter passwords, MFA or CAPTCHA and approve consent with the provider; Haven never asks you to type those credentials here."
                 Classes="muted" FontSize="11" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Services}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemWidth="500" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <hui:HavenAdaptiveSurface Width="490" Margin="0,0,10,10" Classes="dashboardTile">
              <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding CapabilityLabel}" Classes="muted2" FontSize="9" />
                  </StackPanel>
                  <hui:HavenAdaptiveSurface Grid.Column="1" Classes="statusPill">
                    <TextBlock Text="{Binding ConnectionLabel}" FontSize="10" />
                  </hui:HavenAdaptiveSurface>
                </Grid>
                <TextBlock Text="{Binding AccountLabel}" FontSize="12" />
                <TextBlock Text="{Binding LastSyncLabel}" Classes="muted2" FontSize="10" />
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="7">
                  <hui:HavenButton Content="Connect"
                                  Classes="accent"
                                  Command="{Binding $parent[UserControl].DataContext.ConnectServiceCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding CanConnect}" />
                  <hui:HavenButton Grid.Column="1" Content="Disconnect"
                                  Classes="danger"
                                  Command="{Binding $parent[UserControl].DataContext.DisconnectServiceCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding CanDisconnect}" />
                </Grid>
                <hui:HavenProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding Status}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </hui:HavenAdaptiveSurface>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding ServicesStatus}" Classes="muted" />

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="CLOUD MODEL PROVIDERS" Classes="eyebrow" />
          <TextBlock Text="API model providers" Classes="sectionHeading" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Configure model API providers without replacing local models. API keys are stored in Windows Credential Manager and are never written to the provider settings file."
                 Classes="muted" FontSize="11" />

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemWidth="500" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <hui:HavenAdaptiveSurface Width="490" Margin="0,0,10,10" Classes="dashboardTile">
              <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding KindLabel}" Classes="muted2" FontSize="9" />
                  </StackPanel>
                  <hui:HavenAdaptiveSurface Grid.Column="1" Classes="statusPill" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionLabel}" FontSize="10" />
                  </hui:HavenAdaptiveSurface>
                </Grid>

                <StackPanel Spacing="4">
                  <TextBlock Text="Endpoint" Classes="muted" FontSize="10" />
                  <hui:HavenTextInput Text="{Binding Endpoint}" PlaceholderText="https://api.example.com/v1/" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="API key" Classes="muted" FontSize="10" />
                  <hui:HavenTextInput Text="{Binding ApiKey}" PasswordChar="*" PlaceholderText="{Binding ApiKeyHint}" />
                </StackPanel>

                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="7">
                  <hui:HavenButton Content="{Binding ConnectLabel}"
                          Classes="accent"
                          Command="{Binding $parent[UserControl].DataContext.ConnectCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding CanConnect}" />
                  <hui:HavenButton Grid.Column="1" Content="Test"
                          Command="{Binding $parent[UserControl].DataContext.TestCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding CanTest}" />
                  <hui:HavenButton Grid.Column="2" Content="Disconnect"
                          Classes="danger"
                          Command="{Binding $parent[UserControl].DataContext.DisconnectCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding CanDisconnect}" />
                  <TextBlock Grid.Column="3" Text="{Binding ModelSummary}" Classes="muted" FontSize="10"
                             HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <hui:HavenProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding Status}" Classes="muted" FontSize="10" />
              </StackPanel>
            </hui:HavenAdaptiveSurface>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding Status}" Classes="muted" />
    </StackPanel>
  </hui:HavenAdaptiveSurface>
</UserControl>
