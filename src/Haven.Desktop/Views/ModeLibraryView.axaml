<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Haven.Desktop.ViewModels"
             x:Class="Haven.Desktop.Views.ModeLibraryView"
             x:DataType="vm:ModeLibraryPageViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Mode Library" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HavenTextBrush}" />
      <TextBlock Text="Discover, pin, and create Haven modes." FontSize="12" Foreground="{DynamicResource HavenMutedBrush}" />
    </StackPanel>

    <!-- Toolbar -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource HavenPanelBrush}" Padding="8,0" MaxWidth="300">
        <TextBox Text="{Binding SearchQuery}" PlaceholderText="Search modes..." Background="Transparent" BorderThickness="0" Foreground="{DynamicResource HavenTextBrush}" />
      </Border>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Classes="ghost" Margin="8,0" />
      <Button Grid.Column="2" Content="+ Create in Studio" Command="{Binding CreateInStudioCommand}" Classes="accent" />
    </Grid>

    <!-- Mode Cards -->
    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModeCardViewModel">
            <Border CornerRadius="8" Background="{DynamicResource HavenPanelBrush}" Padding="14" Margin="0,0,0,8">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                <!-- Icon -->
                <Border Grid.Row="0" Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource HavenAccentSoftBrush}" VerticalAlignment="Top">
                  <TextBlock Text="{Binding IconKey}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource HavenAccentBrush}" />
                </Border>
                <!-- Name + Description -->
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HavenTextBrush}" />
                    <Border CornerRadius="4" Background="{DynamicResource HavenAccentSoftBrush}" Padding="6,2" IsVisible="{Binding IsPinned}">
                      <TextBlock Text="Pinned" FontSize="9" Foreground="{DynamicResource HavenAccentBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Border CornerRadius="4" Background="#20FFFFFF" Padding="6,2">
                      <TextBlock Text="{Binding SourceLabel}" FontSize="9" Foreground="{DynamicResource HavenMutedBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource HavenTextSoftBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <!-- Actions -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                  <Button Command="{Binding $parent[ItemsControl].DataContext.PinCommand}" CommandParameter="{Binding}"
                          Classes="ghost" Padding="6" ToolTip.Tip="{Binding PinLabel}">
                    <TextBlock Text="{Binding PinLabel}" FontSize="12" />
                  </Button>
                </StackPanel>
                <!-- Meta -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                  <TextBlock FontSize="11" Foreground="{DynamicResource HavenMutedBrush}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="v{0} · by {1} · {2} uses">
                        <Binding Path="Version" />
                        <Binding Path="Author" />
                        <Binding Path="UseCount" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Status Bar -->
    <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource HavenMutedBrush}" Margin="0,8,0,0" />
  </Grid>
</UserControl>
