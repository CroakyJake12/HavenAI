<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/ModeLibraryView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.ModeLibraryView. Its visual vocabulary includes: Grid, StackPanel, TextBlock, Border, TextBox, Button, ScrollViewer, ItemsControl, ItemsControl.ItemTemplate, DataTemplate, TextBlock.Text, MultiBinding, Binding.
  Data flow: Binding expressions read or update these view-model paths: SearchQuery, RefreshCommand, CreateInStudioCommand, Items, IconKey, Name, IsPinned, SourceLabel, Description, PinLabel, Status.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:vm="using:Haven.Desktop.ViewModels"
             x:Class="Haven.Desktop.Views.ModeLibraryView"
             x:DataType="vm:ModeLibraryPageViewModel">
  <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20">

    <!-- Header -->
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="App Library" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HavenTextBrush}" />
      <TextBlock Text="Discover, pin, and create Haven apps." FontSize="12" Foreground="{DynamicResource HavenMutedBrush}" />
    </StackPanel>

    <!-- Toolbar -->
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <hui:HavenAdaptiveSurface Grid.Column="0" CornerRadius="6" Background="{DynamicResource HavenPanelBrush}" Padding="8,0" MaxWidth="300">
        <hui:HavenTextInput Text="{Binding SearchQuery}" PlaceholderText="Search apps..." Background="Transparent" BorderThickness="0" Foreground="{DynamicResource HavenTextBrush}" />
      </hui:HavenAdaptiveSurface>
      <hui:HavenButton Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Classes="ghost" Margin="8,0" />
      <hui:HavenButton Grid.Column="2" Content="+ Create in Studio" Command="{Binding CreateInStudioCommand}" Classes="accent" />
    </Grid>

    <!-- Mode Cards -->
    <!-- Section: Keeps the region usable when content exceeds the available window size. -->
    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModeCardViewModel">
            <hui:HavenAdaptiveSurface CornerRadius="8" Background="{DynamicResource HavenPanelBrush}" Padding="14" Margin="0,0,0,8">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                <!-- Icon -->
                <hui:HavenAdaptiveSurface Grid.Row="0" Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource HavenAccentSoftBrush}" VerticalAlignment="Top">
                  <TextBlock Text="{Binding IconKey}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource HavenAccentBrush}" />
                </hui:HavenAdaptiveSurface>
                <!-- Name + Description -->
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HavenTextBrush}" />
                    <hui:HavenAdaptiveSurface CornerRadius="4" Background="{DynamicResource HavenAccentSoftBrush}" Padding="6,2" IsVisible="{Binding IsPinned}">
                      <TextBlock Text="Pinned" FontSize="9" Foreground="{DynamicResource HavenAccentBrush}" FontWeight="SemiBold" />
                    </hui:HavenAdaptiveSurface>
                    <hui:HavenAdaptiveSurface CornerRadius="4" Background="#20FFFFFF" Padding="6,2">
                      <TextBlock Text="{Binding SourceLabel}" FontSize="9" Foreground="{DynamicResource HavenMutedBrush}" />
                    </hui:HavenAdaptiveSurface>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource HavenTextSoftBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <!-- Actions -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                  <hui:HavenButton Command="{Binding $parent[ItemsControl].DataContext.PinCommand}" CommandParameter="{Binding}"
                          Classes="ghost" Padding="6" ToolTip.Tip="{Binding PinLabel}">
                    <TextBlock Text="{Binding PinLabel}" FontSize="12" />
                  </hui:HavenButton>
                </StackPanel>
                <!-- Meta -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                  <TextBlock FontSize="11" Foreground="{DynamicResource HavenMutedBrush}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="v{0} · by {1} · {2} uses">
                        <Binding Path="Version" />
                        <Binding Path="Author" />
                        <Binding Path="UseCount" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </hui:HavenAdaptiveSurface>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Status Bar -->
    <!-- Section: Hosts the TextBlock portion of this view at this position in the visual tree. -->
    <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource HavenMutedBrush}" Margin="0,8,0,0" />
  </Grid>
</UserControl>
