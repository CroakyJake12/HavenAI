<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/WorkspaceEditorView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.WorkspaceEditorView. Its visual vocabulary includes: Grid, StackPanel, TextBlock, Button, ComboBox, ComboBox.ItemTemplate, DataTemplate, Border, TextBox, ScrollViewer, ItemsControl, ItemsControl.ItemTemplate.
  Data flow: Binding expressions read or update these view-model paths: Title, ProjectName, RelativePath, UndoCommand, RedoCommand, Versions, SelectedVersion, Label, Changes, RollbackCommand, RollforwardCommand, ToggleDiffCommand, SaveCommand, Content, RequiresBranchAfterRollback, BranchAfterRollbackCommand, SelectedSnippet, CommentPrompt, AddCommentCommand, Comments, Prompt, Snippet, Changelog, DirtyLabel, Status, ReloadCommand, InterruptCommand, ShowDiff, DiffText.
  Interaction: Direct event handlers in this file are: OnEditorSelectionChanged.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Haven.Desktop.Views.WorkspaceEditorView">
  <!-- Main layout: 4 rows — Toolbar, Editor+Sidebar, Status Bar, Diff Panel -->
  <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">

    <!-- ============================================================
         ROW 0: TOOLBAR
         File title, undo/redo, version history, rollback/rollforward,
         diff toggle, and save button. All on one horizontal line.
         ============================================================ -->
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="7">
      <!-- File title + project/path breadcrumb -->
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="{Binding ProjectName}" Classes="muted" />
          <TextBlock Text="·" Classes="muted" />
          <TextBlock Text="{Binding RelativePath}" Classes="muted" />
        </StackPanel>
      </StackPanel>
      <!-- Undo: reverts to the previous edit (from undo stack) -->
      <Button Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" />
      <!-- Redo: reapplies an undone edit (from redo stack) -->
      <Button Grid.Column="2" Content="Redo" Command="{Binding RedoCommand}" />
      <!-- Version history dropdown: select any past version to rollback to -->
      <ComboBox Grid.Column="3" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" MinWidth="190">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Label}" />
              <TextBlock Text="{Binding Changes}" Classes="muted" FontSize="10" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <!-- Rollback: revert the file to the selected historical version -->
      <Button Grid.Column="4" Content="Rollback" Command="{Binding RollbackCommand}" />
      <!-- Roll forward: re-apply a rollback (only available after rollback) -->
      <Button Grid.Column="5" Content="Roll forward" Command="{Binding RollforwardCommand}" />
      <!-- Diff toggle: show/hide a side-by-side diff panel below the editor -->
      <Button Grid.Column="6" Content="Diff" Command="{Binding ToggleDiffCommand}" />
      <!-- Save: write current content to disk (atomic write) -->
      <Button Grid.Column="7" Content="Save" Classes="accent" Command="{Binding SaveCommand}" />
    </Grid>

    <!-- ============================================================
         ROW 1: EDITOR + SIDEBAR
         Left (3/4 width): the code/text editor (TextBox with monospace font)
         Right (1/4 width): sidebar with inline comment, comment list, changelog
         ============================================================ -->
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
    <Grid Grid.Row="1" ColumnDefinitions="3*,*" ColumnSpacing="14" Margin="0,14,0,10">

      <!-- LEFT: Main text editor
           Full-featured text editor with:
           - Monospace font (Cascadia Code / Consolas)
           - Read-only when in rollback mode (RequiresBranchAfterRollback)
           - AcceptsReturn + AcceptsTab for multi-line editing
           - Horizontal and vertical scrollbars
           - Selection change events for inline comment feature -->
      <Border Classes="card" Padding="0" ClipToBounds="True">
        <TextBox x:Name="EditorTextBox"
                 Text="{Binding Content}"
                 IsReadOnly="{Binding !CanEdit}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Code, Consolas"
                 FontSize="13"
                 BorderThickness="0"
                 CornerRadius="14"
                 Padding="16"
                 VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PointerReleased="OnEditorSelectionChanged"
                 KeyUp="OnEditorSelectionChanged" />
      </Border>

      <!-- RIGHT: Sidebar panels — stacked vertically in a scrollable area -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">

          <!-- Rollback branch warning — shown when editing after a rollback
               Prompts user to create a branch so the rollback remains recoverable -->
          <Border Classes="permission" IsVisible="{Binding RequiresBranchAfterRollback}">
            <StackPanel Spacing="7">
              <TextBlock Text="Rollback checkpoint" FontWeight="SemiBold" />
              <TextBlock Text="Branch before editing so the rollback remains recoverable." Classes="muted" FontSize="11" />
              <Button Content="Branch and continue" Classes="accent" Command="{Binding BranchAfterRollbackCommand}" />
            </StackPanel>
          </Border>

          <!-- Inline project comment — select text in the editor, then register
               it as a context comment for the chat agent to reference -->
          <Border Classes="card">
            <StackPanel Spacing="7">
              <TextBlock Text="Inline project comment" Classes="sectionHeading" />
              <TextBlock Text="{Binding SelectedSnippet}" Classes="muted" FontFamily="Cascadia Code, Consolas" FontSize="10" MaxLines="4" />
              <TextBox Text="{Binding CommentPrompt}" PlaceholderText="Ask Haven about this selection" AcceptsReturn="True" MinHeight="65" />
              <Button Content="Register in chat context" Command="{Binding AddCommentCommand}" />
            </StackPanel>
          </Border>

          <!-- Comments list — all registered inline comments for this file -->
          <Border Classes="card">
            <StackPanel Spacing="7">
              <TextBlock Text="Comments" Classes="sectionHeading" />
              <ItemsControl ItemsSource="{Binding Comments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource HavenPanel2Brush}" CornerRadius="8" Padding="8" Margin="0,3">
                      <StackPanel>
                        <TextBlock Text="{Binding Prompt}" />
                        <TextBlock Text="{Binding Snippet}" Classes="muted" FontSize="10" MaxLines="3" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Changelog — timestamped list of edits, saves, and external changes -->
          <Border Classes="card">
            <StackPanel Spacing="7">
              <TextBlock Text="Changelog" Classes="sectionHeading" />
              <ItemsControl ItemsSource="{Binding Changelog}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Classes="muted" FontSize="11" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ============================================================
         ROW 2: STATUS BAR
         Shows dirty state, status message, reload button, and interrupt.
         ============================================================ -->
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9">
      <!-- Dirty indicator — "Unsaved changes" in yellow or "Saved" -->
      <TextBlock Text="{Binding DirtyLabel}" Foreground="{DynamicResource HavenWarningBrush}" VerticalAlignment="Center" />
      <!-- Status message — shows live feedback like "Loading file…" or "Saved" -->
      <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" />
      <!-- Reload from disk — discards unsaved changes and re-reads the file -->
      <Button Grid.Column="2" Content="Reload from disk" Command="{Binding ReloadCommand}" />
      <!-- Interrupt run — asks Haven to stop after the current safe boundary -->
      <Button Grid.Column="3" Content="Interrupt run" Classes="stop" Command="{Binding InterruptCommand}" />
    </Grid>

    <!-- ============================================================
         ROW 3: DIFF PANEL (toggle-able)
         Shows a line-by-side diff between the saved version and current edits.
         Lines prefixed with "- " are removed, "+ " are added, "  " are unchanged.
         Only visible when the "Diff" button is clicked.
         Max height 250px, scrollable.
         ============================================================ -->
    <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
    <Border Grid.Row="3" Classes="card" Padding="0" IsVisible="{Binding ShowDiff}" Margin="0,10,0,0" MaxHeight="250">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="Diff (saved ↔ current)" FontWeight="SemiBold" FontSize="12" Margin="14,10,14,6"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding DiffText}" FontFamily="Cascadia Code, Consolas" FontSize="11"
                     TextWrapping="Wrap" Margin="14,0,14,10"/>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
