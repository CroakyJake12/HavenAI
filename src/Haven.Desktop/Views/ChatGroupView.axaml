<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Haven.Desktop.Views.ChatGroupView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32" Spacing="20" MaxWidth="1100" HorizontalAlignment="Center">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <Button x:Name="BackButton" Content="Back" Classes="secondary" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="Chat Group" Classes="eyebrow" />
          <TextBlock x:Name="NameText" FontSize="28" FontWeight="SemiBold" />
          <TextBlock x:Name="StatusText" Classes="muted" Margin="0,4,0,0" />
        </StackPanel>
        <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Classes="secondary" />
        <Button x:Name="SettingsButton" Grid.Column="3" Content="Settings" Classes="secondary" />
        <Button x:Name="NewChatButton" Grid.Column="4" Content="New chat" Classes="primary" />
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel>
              <TextBlock Text="Chats" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="ChatCountLabel" Classes="muted"/>
            </StackPanel>
            <TextBlock x:Name="PinnedCountLabel" Grid.Column="1" Classes="muted" VerticalAlignment="Center" />
            <TextBlock x:Name="LastActivityLabel" Grid.Column="2" Classes="muted" VerticalAlignment="Center" />
          </Grid>
          <TextBlock x:Name="NoChatsText" Text="No chats in this group yet." Classes="muted" />
          <ItemsControl x:Name="RecentChatsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="sidebar" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}"/>
                    <TextBlock Grid.Column="1" Text="{Binding UpdatedLabel}" Classes="muted"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Button x:Name="ArchiveButton" Content="Archive Chat Group" Classes="secondary" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
