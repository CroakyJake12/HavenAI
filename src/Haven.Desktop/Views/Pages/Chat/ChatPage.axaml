<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             x:Class="Haven.Desktop.Views.Pages.Chat.ChatPage"
             AttachedToVisualTree="OnFinalCodeBehindAttached"
             DetachedFromVisualTree="OnFinalCodeBehindDetached">
  <Grid>
    <Grid x:Name="CodeBehindHost" />

    <!-- Compatibility controls retained for the existing ChatPage code-behind.
         They are never rendered; the visible surface is built in C#. -->
    <StackPanel IsVisible="False" IsHitTestVisible="False">
      <hui:HavenListBox x:Name="MessageScroller" />
      <hui:HavenButton x:Name="DismissOverlay" />
      <hui:HavenTextInput x:Name="ComposerBox" />
      <hui:HavenButton x:Name="AttachButton" />
      <hui:HavenButton x:Name="PluginButton" />
      <hui:HavenButton x:Name="PromptButton" />
      <hui:HavenButton x:Name="StopButton" />
      <hui:HavenButton x:Name="SendButton" />
    </StackPanel>
  </Grid>
</UserControl>
