<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             xmlns:topRail="using:Haven.Desktop.Views.Shell.TopRail"
             x:Class="Haven.Desktop.Views.Pages.Chat.NewChatPage">

	<Grid x:Name="SurfaceGrid" ClipToBounds="True" Background="Transparent" ColumnDefinitions="0,*">
		<Border x:Name="TasksSidebarHost"
				Grid.Column="0"
				IsVisible="False"
				Margin="16,18,0,18"
				Padding="12"
				CornerRadius="20"
				Background="#EFFFFFFF"
				BorderBrush="{DynamicResource HavenLineBrush}"
				BorderThickness="1" />

		<Grid Grid.Column="1" Margin="36,24,36,28" RowDefinitions="Auto,*,Auto" RowSpacing="16" Background="Transparent">
			<TextBlock x:Name="SurfaceTitle"
					   IsVisible="False"
					   Text="Run Task"
					   FontSize="42"
					   FontWeight="ExtraBold"
					   Foreground="#FF050505" />
			<ScrollViewer x:Name="MessagesScroll"
						  Grid.Row="1"
						  HorizontalScrollBarVisibility="Disabled"
						  VerticalScrollBarVisibility="Auto">
				<StackPanel x:Name="MessagesPanel" Spacing="18" MaxWidth="980" HorizontalAlignment="Stretch" />
			</ScrollViewer>

			<StackPanel Grid.Row="2" Spacing="8">
				<Button x:Name="ResolveProblemsButton"
						HorizontalAlignment="Center"
						Classes="chip"
						IsVisible="False"
						MinHeight="38"
						Padding="15,8"
						CornerRadius="19"
						Background="#DFFFFFFF"
						BorderBrush="{DynamicResource HavenLineBrush}"
						BorderThickness="1">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<controls:HavenIcon IconKey="warning" Width="16" Height="16"
											Foreground="{DynamicResource HavenTextBrush}" />
						<TextBlock Text="Resolve Problems"
								   FontWeight="Bold"
								   VerticalAlignment="Center" />
					</StackPanel>
				</Button>
				<TextBlock x:Name="StatusText"
						   HorizontalAlignment="Center"
						   Foreground="#FF4D4D4D"
						   FontSize="11" />
				<Grid HorizontalAlignment="Center" ColumnDefinitions="Auto,640,Auto" ColumnSpacing="10">
				<topRail:AddMenu x:Name="AddButton"
									 Width="58" Height="58" CornerRadius="29"
									 Background="{DynamicResource HavenAccentSoftBrush}"
									 BorderBrush="{DynamicResource HavenLineBrush}"
									 BorderThickness="1"
									 Foreground="{DynamicResource HavenTextBrush}" />
					<TextBox x:Name="InstructionBox"
							 Grid.Column="1"
							 MinHeight="58" MaxHeight="150"
							 AcceptsReturn="True"
							 TextWrapping="Wrap"
							 CornerRadius="18"
							 Background="{DynamicResource HavenPanelBrush}"
							 BorderBrush="{DynamicResource HavenLineBrush}"
							 BorderThickness="1"
							 Foreground="#FF222222"
							 PlaceholderText="Ask Haven Anything"
							 FontWeight="Bold"
							 VerticalContentAlignment="Center"
							 FontSize="15"
							 Padding="22,0" />
					<Button x:Name="SendButton"
							Grid.Column="2"
							Width="64" Height="58" CornerRadius="20"
							Background="{DynamicResource HavenAccentBrush}"
							BorderBrush="{DynamicResource HavenAccentBorderBrush}"
							BorderThickness="1">
						<controls:HavenIcon IconKey="send" Width="27" Height="27" Foreground="{DynamicResource HavenAccentInkBrush}" />
					</Button>
				</Grid>
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
