<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:topRail="using:Haven.Desktop.Views.Shell.TopRail"
             x:Class="Haven.Desktop.Views.Pages.Chat.NewChatPage">

  <Grid x:Name="SurfaceGrid"
        ClipToBounds="True"
        Background="Transparent"
        ColumnDefinitions="0,*"
        ColumnSpacing="18">

    <hui:HavenSidebarSurface x:Name="TasksSidebarHost"
            Grid.Column="0"
            IsVisible="False"
            Padding="16"
            CornerRadius="22" />

    <Grid x:Name="ChatWorkspace" Grid.Column="1"
          Margin="32,10,32,4"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="12"
          Background="Transparent">

      <TextBlock x:Name="SurfaceTitle"
                 IsVisible="False"
                 Text="Tasks"
                 FontSize="38"
                 FontWeight="ExtraBold"
                 Foreground="{DynamicResource HavenTextBrush}"
                 HorizontalAlignment="Center" />

      <hui:HavenEmptyState x:Name="EmptyState"
                  Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,0,0,42">
        <StackPanel Spacing="10">
          <TextBlock Text="How can I help?" FontSize="40" FontWeight="ExtraBold" HorizontalAlignment="Center" />
          <TextBlock Text="Start a conversation or attach context below." FontSize="13"
                     Foreground="{DynamicResource HavenTextSoftBrush}" HorizontalAlignment="Center" />
        </StackPanel>
      </hui:HavenEmptyState>

      <ScrollViewer x:Name="MessagesScroll"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="MessagesPanel"
                    Spacing="14"
                    MaxWidth="980"
                    HorizontalAlignment="Stretch" />
      </ScrollViewer>

      <StackPanel Grid.Row="2" Spacing="7">
        <hui:HavenChipButton x:Name="ResolveProblemsButton"
                HorizontalAlignment="Center"
                IsVisible="False"
                MinHeight="34">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:HavenIcon IconKey="warning" Width="15" Height="15" />
            <TextBlock Text="Resolve problems" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </hui:HavenChipButton>

        <TextBlock x:Name="StatusText"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource HavenTextSoftBrush}"
                   FontSize="11" />

        <StackPanel x:Name="AttachmentBar"
                    IsVisible="False"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8" />

        <hui:HavenComposerShell HorizontalAlignment="Stretch" MaxWidth="900">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <topRail:AddMenu x:Name="AddButton" Classes="accent" Width="44" Height="44" />
            <hui:HavenMultilineInput x:Name="InstructionBox" Grid.Column="1"
                                     MinWidth="0" MinHeight="44" MaxHeight="144"
                                     PlaceholderText="Ask Haven anything"
                                     VerticalContentAlignment="Center" />
            <hui:HavenIconButton x:Name="SendButton" Grid.Column="2" Classes="accent"
                                 Width="44" Height="44">
              <controls:HavenIcon IconKey="arrow-up" Width="20" Height="20" Foreground="White" />
            </hui:HavenIconButton>
          </Grid>
        </hui:HavenComposerShell>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
