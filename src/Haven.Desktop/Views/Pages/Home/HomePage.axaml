<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Pages.Home.HomePage">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="34,28,34,48" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="24" MaxWidth="1260" HorizontalAlignment="Stretch">

      <!-- Row 0: Header -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="5">
          <TextBlock x:Name="GreetingText" Classes="heading" />
          <TextBlock x:Name="DateText" Classes="soft" FontSize="15" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <hui:HavenAdaptiveSurface Classes="statusPill"><TextBlock x:Name="ModelStatusText" FontSize="11" /></hui:HavenAdaptiveSurface>
            <hui:HavenAdaptiveSurface Classes="statusPill"><TextBlock x:Name="LastUpdatedText" Classes="muted" FontSize="11" /></hui:HavenAdaptiveSurface>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <hui:HavenButton Classes="subtle" x:Name="CustomizeButton">
            <StackPanel Orientation="Horizontal" Spacing="7"><controls:HavenIcon IconKey="settings" Width="16" Height="16" /><TextBlock Text="Customise" /></StackPanel>
          </hui:HavenButton>
          <hui:HavenButton Classes="icon" x:Name="RefreshButton" ToolTip.Tip="Refresh dashboard">
            <controls:HavenIcon IconKey="refresh" Width="18" Height="18" />
          </hui:HavenButton>
        </StackPanel>
      </Grid>

      <!-- Row 1: Quick Access Tiles -->
      <StackPanel Grid.Row="1" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Quick access" Classes="sectionHeading" />
          <TextBlock x:Name="StatusText" Grid.Column="1" Classes="muted" VerticalAlignment="Center" />
        </Grid>
        <WrapPanel x:Name="TilesPanel" />

        <!-- Customize panel (hidden tiles) -->
        <hui:HavenAdaptiveSurface x:Name="CustomizePanel" Classes="card" IsVisible="False" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Hidden tiles" FontWeight="SemiBold" />
            <TextBlock Text="Choose a tile to return it to Home. Tile order is saved locally." Classes="muted" FontSize="11" />
            <WrapPanel x:Name="HiddenTilesPanel" />
            <TextBlock x:Name="NoHiddenTilesText" Text="No tiles are hidden." Classes="muted" />
          </StackPanel>
        </hui:HavenAdaptiveSurface>
      </StackPanel>

      <!-- Row 2: Agenda + Recent Work -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="18">
        <hui:HavenAdaptiveSurface Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Today" Classes="sectionHeading" />
            <StackPanel x:Name="AgendaPanel" Spacing="4" />
            <TextBlock x:Name="NoAgendaText" Text="Nothing scheduled. Your day is clear." Classes="muted" />
          </StackPanel>
        </hui:HavenAdaptiveSurface>
        <hui:HavenAdaptiveSurface Grid.Column="1" Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Recent work" Classes="sectionHeading" />
            <StackPanel x:Name="RecentWorkPanel" Spacing="4" />
            <TextBlock x:Name="NoRecentWorkText" Text="No recent activity." Classes="muted" />
          </StackPanel>
        </hui:HavenAdaptiveSurface>
      </Grid>

    </Grid>
  </ScrollViewer>

</UserControl>
