<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Pages.ModeLibrary.ModeLibraryPage"
             Loaded="OnLoaded">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="App Library" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HavenTextBrush}" />
      <TextBlock Text="Discover, pin, and create Haven apps." FontSize="12" Foreground="{DynamicResource HavenMutedBrush}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource HavenPanelBrush}" Padding="8,0" MaxWidth="300">
        <TextBox x:Name="SearchBox" PlaceholderText="Search modes..." Background="Transparent" BorderThickness="0" Foreground="{DynamicResource HavenTextBrush}" />
      </Border>
      <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Classes="ghost" Margin="8,0" />
      <Button Grid.Column="2" x:Name="CreateInStudioButton" Content="+ Create in Studio" Classes="accent" />
    </Grid>

    <ScrollViewer Grid.Row="2">
      <StackPanel x:Name="ItemsPanel" Spacing="8" />
    </ScrollViewer>

    <TextBlock Grid.Row="3" x:Name="StatusText" FontSize="11" Foreground="{DynamicResource HavenMutedBrush}" Margin="0,8,0,0" />
  </Grid>

</UserControl>
