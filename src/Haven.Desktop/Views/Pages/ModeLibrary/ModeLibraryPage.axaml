<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Pages.ModeLibrary.ModeLibraryPage"
             Loaded="OnLoaded">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="36,28" MaxWidth="1560" HorizontalAlignment="Center">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="App Library" FontSize="38" FontWeight="ExtraBold" Foreground="{DynamicResource HavenTextBrush}" />
      <TextBlock Text="Discover, pin, and create Haven apps." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HavenMutedBrush}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <hui:HavenSearchInput Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search apps" MaxWidth="520" HorizontalAlignment="Left" />
      <hui:HavenTextButton Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Margin="8,0" />
      <hui:HavenPrimaryButton Grid.Column="2" x:Name="CreateInStudioButton" Content="+ Create in Studio" />
    </Grid>

    <ScrollViewer Grid.Row="2">
      <WrapPanel x:Name="ItemsPanel" Orientation="Horizontal" HorizontalAlignment="Left" />
    </ScrollViewer>

    <TextBlock Grid.Row="3" x:Name="StatusText" FontSize="11" Foreground="{DynamicResource HavenMutedBrush}" Margin="0,8,0,0" />
  </Grid>

</UserControl>
