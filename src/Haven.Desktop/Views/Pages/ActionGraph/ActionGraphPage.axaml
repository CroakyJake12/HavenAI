<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:backend="using:Haven.Desktop.HavenUI.Backend"
             x:Class="Haven.Desktop.Views.Pages.ActionGraph.ActionGraphPage">
  <!-- Thin platform host: all Action Graph UI is owned by the HavenUI scene (ActionGraphHavenScene). -->
  <backend:HavenSceneControl x:Name="Scene" />
</UserControl>
