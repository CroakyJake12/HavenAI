<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Pages.ChatGroup.ChatGroupPage">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32" Spacing="20" MaxWidth="1100" HorizontalAlignment="Center">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <Button x:Name="BackButton" Content="Back" Classes="secondary" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="Chat Group" Classes="eyebrow" />
          <TextBlock x:Name="NameText" FontSize="28" FontWeight="SemiBold" />
          <TextBlock x:Name="StatusText" Classes="muted" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="2" x:Name="RefreshButton" Content="Refresh" Classes="secondary" />
        <Button Grid.Column="3" x:Name="SettingsButton" Content="Settings" Classes="secondary" />
        <Button Grid.Column="4" x:Name="NewChatButton" Content="New chat" Classes="primary" />
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel><TextBlock Text="Chats" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ChatCountText" Classes="muted"/></StackPanel>
            <TextBlock Grid.Column="1" x:Name="PinnedCountText" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" x:Name="LastActivityText" Classes="muted" VerticalAlignment="Center" />
          </Grid>
          <TextBlock x:Name="NoChatsText" Text="No chats in this group yet." Classes="muted" />
          <StackPanel x:Name="RecentChatsPanel" Spacing="4" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Button x:Name="AddReferencesButton" Content="Add references" Classes="secondary" HorizontalAlignment="Left" />
        <Button Grid.Column="1" x:Name="ArchiveButton" Content="Archive Chat Group" Classes="secondary" HorizontalAlignment="Left" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
