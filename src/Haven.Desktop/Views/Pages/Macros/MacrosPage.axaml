<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Pages.Macros.MacrosPage"
             Loaded="OnLoaded">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="930" Margin="34,30" Spacing="18">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Macros" Classes="heading" />
          <TextBlock Text="Explicit, click-to-run reusable actions. Macros never run on a schedule." Classes="muted" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" />
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Create macro" Classes="sectionHeading" />
          <TextBox x:Name="NewNameBox" PlaceholderText="Name" />
          <TextBox x:Name="NewDescriptionBox" PlaceholderText="Description" />
          <TextBox x:Name="NewInstructionBox" PlaceholderText="Exact action to send to Haven" AcceptsReturn="True" MinHeight="80" />
          <Button x:Name="CreateButton" Content="Create macro" Classes="accent" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <StackPanel x:Name="ItemsPanel" Spacing="9" />

      <TextBlock x:Name="StatusText" Classes="muted" />
    </StackPanel>
  </ScrollViewer>

</UserControl>
