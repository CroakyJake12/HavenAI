<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Pages.Catalog.CatalogPage"
             Loaded="OnLoaded">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="30,25">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
      <StackPanel>
        <TextBlock x:Name="TitleText" Classes="heading" />
        <TextBlock x:Name="SubtitleText" Classes="muted" Margin="0,4,0,0" />
      </StackPanel>
      <hui:HavenButton Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Classes="chrome" Margin="0,0,8,0" />
      <hui:HavenButton Grid.Column="2" x:Name="UploadPluginButton" Content="Upload plugin" Classes="chrome" Margin="0,0,8,0" />
      <hui:HavenButton Grid.Column="3" x:Name="CreateToggleButton" Classes="accent" />
    </Grid>

    <hui:HavenAdaptiveSurface Grid.Row="1" Classes="card" Margin="0,20,0,12" x:Name="CreatePanel" IsVisible="False">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10" ColumnSpacing="10">
        <Grid ColumnDefinitions="*,Auto" Grid.ColumnSpan="2">
          <TextBlock x:Name="BuilderTitleText" Classes="eyebrow" VerticalAlignment="Center" />
          <hui:HavenButton Grid.Column="1" Classes="icon" x:Name="CloseCreateButton" ToolTip.Tip="Close creator">
            <controls:HavenIcon IconKey="close" Width="14" Height="14" />
          </hui:HavenButton>
        </Grid>
        <hui:HavenTextInput Grid.Row="1" x:Name="BuilderPromptBox" MinHeight="38" />
        <hui:HavenButton Grid.Row="1" Grid.Column="1" x:Name="BuildWithAiButton" Content="Build with AI" />
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="1*,1.5*" ColumnSpacing="10">
          <hui:HavenTextInput x:Name="NewNameBox" PlaceholderText="Name" />
          <hui:HavenTextInput Grid.Column="1" x:Name="NewDescriptionBox" PlaceholderText="Short description" />
        </Grid>
        <hui:HavenTextInput Grid.Row="3" Grid.ColumnSpan="2" x:Name="NewInstructionsBox"
                 PlaceholderText="Instructions" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="105" MaxHeight="230" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" x:Name="AgentFields">
          <TextBlock Text="Preferred model" Classes="muted" VerticalAlignment="Center" />
          <hui:HavenTextInput x:Name="NewModelBox" PlaceholderText="Use current model" Width="230" />
        </StackPanel>
        <hui:HavenCheckBox Grid.Row="4" x:Name="PluginPersistsCheck" Content="Keep active between messages" IsVisible="False" VerticalAlignment="Center" />
        <hui:HavenButton Grid.Row="4" Grid.Column="1" x:Name="CreateItemButton" Classes="accent" MinWidth="120" />
      </Grid>
    </hui:HavenAdaptiveSurface>

    <TextBlock Grid.Row="2" x:Name="StatusText" Classes="muted" FontSize="11" Margin="2,2,0,12" />

    <ScrollViewer Grid.Row="3">
      <WrapPanel x:Name="ItemsPanel" ItemWidth="340" />
    </ScrollViewer>
  </Grid>

</UserControl>
