<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Pages.LessonSettings.LessonSettingsPage"
             Loaded="OnLoaded">

  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="15" MaxWidth="880" HorizontalAlignment="Left">
      <TextBlock Text="LESSON SETTINGS" Classes="eyebrow" />
      <TextBlock x:Name="NameHeading" Classes="heading" />
      <TextBlock Text="Organise the lesson and preserve its structured Study outline." Classes="muted" />

      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="Lesson name" Classes="muted" FontSize="11" />
          <hui:HavenTextInput x:Name="NameBox" />
          <TextBlock Text="Topic group" Classes="muted" FontSize="11" Margin="0,5,0,0" />
          <hui:HavenTextInput x:Name="TopicGroupBox" PlaceholderText="General" />
        </StackPanel>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="STRUCTURE" Classes="eyebrow" />
          <TextBlock Text="JSON outline used to preserve sections, objectives, and progress metadata." Classes="muted" FontSize="11" />
          <hui:HavenTextInput x:Name="StructureJsonBox"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Cascadia Code, Consolas"
                   MinHeight="190" />
        </StackPanel>
      </hui:HavenAdaptiveSurface>

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Classes="muted" VerticalAlignment="Center" />
        <hui:HavenButton Grid.Column="1" x:Name="SaveButton" Content="Save lesson" Classes="accent" />
      </Grid>
    </StackPanel>
  </ScrollViewer>

</UserControl>
