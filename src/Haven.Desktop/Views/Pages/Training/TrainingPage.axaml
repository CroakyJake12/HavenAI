<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Pages.Training.TrainingPage">

  <hui:HavenAdaptiveSurface Padding="20">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
        <hui:HavenButton x:Name="BackButton" Background="Transparent" Foreground="{DynamicResource HavenTextBrush}"
                BorderBrush="{DynamicResource HavenLineBrush}" CornerRadius="10" Padding="10,5">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:HavenIcon IconKey="chevron-left" Width="13" Height="13" />
            <TextBlock Text="Back" />
          </StackPanel>
        </hui:HavenButton>
        <TextBlock Text="Haven Training" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>

      <hui:HavenAdaptiveSurface x:Name="SetupPanel" Grid.Row="1" Background="{DynamicResource HavenPanel2Brush}"
              CornerRadius="8" Padding="16" Margin="0,0,0,16">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Task Instruction" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <hui:HavenTextInput Grid.Row="1" Grid.ColumnSpan="2" x:Name="TaskPromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" Margin="0,0,0,8"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Workspace Directory" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
          <hui:HavenTextInput Grid.Row="3" Grid.Column="0" x:Name="WorkspacePathBox" MinWidth="300"/>

          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Spacing="4">
            <TextBlock Text="Model" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="Duration (minutes)" FontWeight="SemiBold" FontSize="14"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Spacing="8">
            <hui:HavenComboBox x:Name="ModelCombo" MinWidth="200"/>
            <hui:HavenNumericInput x:Name="DurationBox" Minimum="1" Maximum="480" Increment="5" FormatString="F0" MinWidth="120"/>
          </StackPanel>

          <hui:HavenButton Grid.Row="5" Grid.ColumnSpan="2" x:Name="StartButton" Content="Start Training"
                  Background="{DynamicResource HavenAccentBrush}" Foreground="White"
                  HorizontalAlignment="Left" Margin="0,12,0,0" Padding="20,8"/>
        </Grid>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface x:Name="ProgressPanel" Grid.Row="1" Background="{DynamicResource HavenPanel2Brush}"
              CornerRadius="8" Padding="16" Margin="0,0,0,12" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" x:Name="StatusText" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AttemptLabel" FontWeight="Bold"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <hui:HavenButton x:Name="StopButton" Content="Stop" Background="#E53935" Foreground="White" Padding="12,6"/>
          </StackPanel>
          <hui:HavenAdaptiveSurface Grid.Row="3" Background="{DynamicResource HavenPanel2Brush}" CornerRadius="6"
                  Padding="10" Margin="0,8,0,0" IsVisible="False" x:Name="ReasoningBorder">
            <ScrollViewer MaxHeight="150">
              <TextBlock x:Name="ReasoningText" TextWrapping="Wrap" FontSize="11" FontFamily="Cascadia Code, Consolas" Opacity="0.8"/>
            </ScrollViewer>
          </hui:HavenAdaptiveSurface>
        </Grid>
      </hui:HavenAdaptiveSurface>

      <Grid Grid.Row="2" ColumnDefinitions="220,8,*" Margin="0,0,0,12">
        <hui:HavenAdaptiveSurface Grid.Column="0" Background="{DynamicResource HavenPanel2Brush}" CornerRadius="8"
                Padding="16" Margin="0,0,8,0">
          <StackPanel>
            <TextBlock Text="Attempts" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
            <StackPanel x:Name="AttemptsPanel" Spacing="6"/>
          </StackPanel>
        </hui:HavenAdaptiveSurface>
        <Grid Grid.Column="2" RowDefinitions="*,Auto">
          <hui:HavenAdaptiveSurface Grid.Row="0" Background="{DynamicResource HavenPanel2Brush}" CornerRadius="8"
                  Padding="16" Margin="0,0,0,8">
            <ScrollViewer>
              <SelectableTextBlock x:Name="ReportText" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas" FontSize="12"/>
            </ScrollViewer>
          </hui:HavenAdaptiveSurface>
          <hui:HavenAdaptiveSurface Grid.Row="1" Background="{DynamicResource HavenPanel2Brush}" CornerRadius="8"
                  Padding="16" IsVisible="False" x:Name="FeedbackPanel">
            <StackPanel Spacing="8">
              <TextBlock Text="Provide feedback for this attempt (or skip):" FontWeight="SemiBold"/>
              <hui:HavenTextInput x:Name="FeedbackBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" PlaceholderText="Enter feedback or leave empty to skip..."/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <hui:HavenButton x:Name="SubmitFeedbackButton" Content="Submit Feedback" Background="{DynamicResource HavenAccentBrush}" Foreground="White" Padding="14,6"/>
                <hui:HavenButton x:Name="SkipFeedbackButton" Content="Skip" Background="{DynamicResource HavenLineBrush}" Foreground="{DynamicResource HavenTextBrush}" Padding="14,6"/>
              </StackPanel>
            </StackPanel>
          </hui:HavenAdaptiveSurface>
        </Grid>
      </Grid>

      <hui:HavenAdaptiveSurface Grid.Row="3" Background="{DynamicResource HavenPanel2Brush}" CornerRadius="8" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="BottomStatus" VerticalAlignment="Center" Opacity="0.8"/>
          <TextBlock Grid.Column="1" x:Name="BottomAttemptCount" VerticalAlignment="Center" Opacity="0.5"/>
        </Grid>
      </hui:HavenAdaptiveSurface>
    </Grid>
  </hui:HavenAdaptiveSurface>
</UserControl>
