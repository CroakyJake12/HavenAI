<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Pages.ActivityLog.ActivityLogPage"
             Loaded="OnLoaded">

  <Border Padding="20">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
        <TextBlock Text="Activity Log" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
        <Button x:Name="RefreshButton" Content="Refresh" Background="{DynamicResource HavenAccentBrush}" Foreground="White" Padding="12,5" />
      </StackPanel>

      <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="Search conversations…" Margin="0,0,0,12" />

      <Border Grid.Row="2" Background="{DynamicResource HavenPanel2Brush}" CornerRadius="8" Padding="8">
        <ScrollViewer>
          <StackPanel x:Name="ItemsPanel" Spacing="2" />
        </ScrollViewer>
      </Border>

      <Border Grid.Row="3" Background="{DynamicResource HavenPanel2Brush}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
        <TextBlock x:Name="StatusText" Opacity="0.7" />
      </Border>
    </Grid>
  </Border>

</UserControl>
