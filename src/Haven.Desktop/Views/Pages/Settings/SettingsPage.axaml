<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:views="using:Haven.Desktop.Views"
             xmlns:local="using:Haven.Desktop.Views.Pages.Settings"
             xmlns:havenUi="using:Haven.Desktop.HavenUI.Components.Buttons"
             x:Class="Haven.Desktop.Views.Pages.Settings.SettingsPage">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,18,16,120" Spacing="14" MaxWidth="860">
      <TextBlock Text="Settings" Classes="heading" />
      <TextBlock Text="Appearance, models, permissions and reliability."
                 Classes="muted"
                 TextWrapping="Wrap" />

      <local:HavenAppearanceSettingsView />

      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel>
              <TextBlock Text="LOCAL MODELS" Classes="eyebrow" />
              <TextBlock Text="Model manager" Classes="sectionHeading" Margin="0,4,0,0" />
            </StackPanel>
            <hui:HavenButton Grid.Column="1" x:Name="RefreshModelsButton" Content="Refresh" />
          </Grid>

          <hui:HavenTextInput x:Name="ModelSearchBox"
                   PlaceholderText="Search installed models" />

          <WrapPanel x:Name="ModelsPanel" />

          <StackPanel Spacing="8">
            <TextBlock Text="Active model" Classes="muted" />
            <hui:HavenComboBox x:Name="ModelCombo" HorizontalAlignment="Stretch" />
            <TextBlock Text="Reasoning effort" Classes="muted" />
            <hui:HavenComboBox x:Name="EffortCombo" HorizontalAlignment="Stretch" />
            <hui:HavenButton x:Name="SaveDefaultsButton"
                    Content="Save defaults"
                    Classes="accent"
                    HorizontalAlignment="Stretch" />
            <hui:HavenButton x:Name="DeleteModelButton"
                    Content="Delete selected model"
                    Classes="danger"
                    HorizontalAlignment="Stretch" />
          </StackPanel>

          <hui:HavenAdaptiveSurface x:Name="DeleteConfirmBorder"
                  Classes="permission"
                  IsVisible="False">
            <StackPanel Spacing="8">
              <TextBlock Text="Permanently remove the selected model from Ollama?"
                         TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <hui:HavenButton x:Name="CancelDeleteButton" Content="Cancel" />
                <havenUi:HoldToConfirmButton Grid.Column="1"
                                             x:Name="ConfirmDeleteButton"
                                             Content="Delete model"
                                             ActionLabel="delete model" />
              </Grid>
            </StackPanel>
          </hui:HavenAdaptiveSurface>

          <Separator />

          <TextBlock Text="Install a model" Classes="sectionHeading" />
          <TextBlock Text="Enter an Ollama model name or choose a recommended model."
                     Classes="muted"
                     TextWrapping="Wrap" />
          <hui:HavenTextInput x:Name="InstallModelBox"
                   PlaceholderText="e.g. qwen3:4b" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <hui:HavenButton x:Name="BrowseModelsButton"
                    Content="Browse models" />
            <hui:HavenButton Grid.Column="1"
                    x:Name="InstallModelButton"
                    Content="Install"
                    Classes="accent" />
          </Grid>
          <hui:HavenProgressBar x:Name="InstallProgress"
                       Value="0"
                       Minimum="0"
                       Maximum="1"
                       Height="8" />

          <hui:HavenAdaptiveSurface x:Name="RecommendedModelsBorder"
                  Classes="permission"
                  IsVisible="False">
            <StackPanel Spacing="8">
              <TextBlock Text="Recommended for mobile" Classes="sectionHeading" />
              <TextBlock Text="These smaller models are practical starting points on phones. Exact speed depends on memory and chipset."
                         Classes="muted"
                         TextWrapping="Wrap" />
              <WrapPanel x:Name="RecommendedModelsPanel" />
              <hui:HavenButton x:Name="HuggingFaceSearchButton"
                      Content="Search public Hugging Face GGUF models"
                      HorizontalAlignment="Stretch" />
            </StackPanel>
          </hui:HavenAdaptiveSurface>
        </StackPanel>
      </hui:HavenAdaptiveSurface>

      <views:ProviderConnectionsView />
      <views:ReliabilityStatusView />

      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="ADVANCED GENERATION" Classes="eyebrow" />
          <TextBlock Text="Temperature (0–2)" Classes="muted" />
          <hui:HavenNumericInput x:Name="TemperatureBox"
                         Minimum="0"
                         Maximum="2"
                         Increment="0.1"
                         FormatString="0.0" />
          <TextBlock Text="Context limit" Classes="muted" />
          <hui:HavenNumericInput x:Name="ContextLimitBox"
                         Minimum="2048"
                         Maximum="262144"
                         Increment="1024" />
          <TextBlock Text="Maximum tool actions per turn" Classes="muted" />
          <hui:HavenNumericInput x:Name="ActionLimitBox"
                         Minimum="1"
                         Maximum="100" />
          <hui:HavenButton x:Name="SaveAdvancedButton"
                  Content="Save advanced limits"
                  HorizontalAlignment="Stretch" />
        </StackPanel>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="FEATURES" Classes="eyebrow" />
          <hui:HavenCheckBox x:Name="AutoSwitchCheck"
                    Content="Automatically switch to a compatible model" />
          <hui:HavenCheckBox x:Name="AgenticInChatCheck"
                    Content="Show agentic plugins in Haven Chat" />
          <hui:HavenCheckBox x:Name="ConfidenceCheck"
                    Content="Show confidence indicators" />
          <hui:HavenCheckBox x:Name="AutoCompactCheck"
                    Content="Compact context automatically" />
          <TextBlock Text="Compact when context reaches this percent"
                     Classes="muted"
                     TextWrapping="Wrap" />
          <hui:HavenNumericInput x:Name="CompactPercentBox"
                         Minimum="50"
                         Maximum="95" />
          <hui:HavenCheckBox x:Name="AdaptiveHelpCheck"
                    Content="Adaptive project help" />
          <hui:HavenCheckBox x:Name="BrowserSideCheck"
                    Content="Browser side assistant" />
          <hui:HavenCheckBox x:Name="AutoWakeCheck"
                    Content="Wake Ollama automatically when a local model is offline" />
          <hui:HavenButton x:Name="SaveFeaturesButton"
                  Content="Save feature settings"
                  HorizontalAlignment="Stretch" />
        </StackPanel>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="TOOL PERMISSIONS" Classes="eyebrow" />
          <TextBlock Text="Ask is the safest default. Device Use replaces Computer Use on mobile."
                     Classes="muted"
                     TextWrapping="Wrap" />
          <TextBlock Text="Files" Classes="muted" />
          <hui:HavenComboBox x:Name="FilePermCombo" />
          <TextBlock Text="Commands" Classes="muted" />
          <hui:HavenComboBox x:Name="CommandPermCombo" />
          <TextBlock Text="Browser" Classes="muted" />
          <hui:HavenComboBox x:Name="BrowserPermCombo" />
          <TextBlock Text="Device Use" Classes="muted" />
          <hui:HavenComboBox x:Name="ComputerPermCombo" />
          <hui:HavenButton x:Name="SavePermissionsButton"
                  Content="Save permissions"
                  Classes="accent"
                  HorizontalAlignment="Stretch" />
        </StackPanel>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="7">
          <TextBlock Text="LOCAL DATA" Classes="eyebrow" />
          <TextBlock x:Name="DataStatement"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="Haven stores data locally in your user profile. Nothing leaves your device without a provider you explicitly configure." />
        </StackPanel>
      </hui:HavenAdaptiveSurface>
      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="7">
          <TextBlock Text="ISOLATED BROWSER" Classes="eyebrow" />
          <TextBlock x:Name="BrowserStatement"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="The browser runs in an isolated profile. Cookies, history and logins never leak between sessions." />
        </StackPanel>
      </hui:HavenAdaptiveSurface>
      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="7">
          <TextBlock Text="WORKSPACE SAFETY" Classes="eyebrow" />
          <TextBlock x:Name="SafetyStatement"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="Haven never modifies files outside the active workspace without explicit permission." />
        </StackPanel>
      </hui:HavenAdaptiveSurface>

      <TextBlock x:Name="StatusText"
                 Classes="muted"
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
