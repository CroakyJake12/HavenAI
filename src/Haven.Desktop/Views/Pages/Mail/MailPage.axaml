<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Pages.Mail.MailPage"
             SizeChanged="OnSizeChanged">
  <Grid RowDefinitions="Auto,Auto,*" Background="Transparent">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="18,14,18,10">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Mail" FontSize="28" FontWeight="SemiBold" />
        <ComboBox Width="230" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Address}" FontSize="11" Opacity="0.7"/>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox x:Name="CompactFolderPicker" Width="180" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" IsVisible="False" DisplayMemberBinding="{Binding DisplayName}"/>
      </StackPanel>

      <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" MaxWidth="650" Margin="24,0">
        <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search mail"/>
        <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
        <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
      </Grid>

      <Button Grid.Column="2" Content="New message" Command="{Binding ComposeCommand}" Padding="18,9"/>
    </Grid>

    <Grid Grid.Row="1" Margin="18,0,18,10" ColumnDefinitions="Auto,Auto,*,Auto">
      <CheckBox Grid.Column="0" Content="Unread" IsChecked="{Binding UnreadOnly, Mode=TwoWay}" VerticalAlignment="Center"/>
      <CheckBox Grid.Column="1" Content="Flagged" IsChecked="{Binding FlaggedOnly, Mode=TwoWay}" Margin="14,0,0,0" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="18,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Showing cached mail · refresh failed" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding IsStale}"/>
        <TextBlock Text="{Binding LastUpdatedLabel}" FontSize="12" Opacity="0.65"/>
        <ProgressBar Width="70" Height="4" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid Margin="18,0,18,18">
        <Grid x:Name="MailboxGrid" ColumnDefinitions="220,390,*">
          <Border x:Name="FolderPanel" Grid.Column="0" Padding="10" CornerRadius="18" Background="{DynamicResource HavenPanelBrush}">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid ColumnDefinitions="*,Auto" Margin="8,4,8,8">
                <TextBlock Text="Folders &amp; labels" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="+" Command="{Binding OpenCreateFolderCommand}" IsVisible="{Binding CanManageFolders}" Padding="8,2"/>
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="8,0,8,6" IsVisible="{Binding CanManageSelectedFolder}">
                <Button Content="Rename" Command="{Binding OpenRenameFolderCommand}" Padding="8,3"/>
                <Button Content="Delete" Command="{Binding RequestDeleteFolderCommand}" Padding="8,3"/>
              </StackPanel>
              <ListBox Grid.Row="2" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" SelectionChanged="OnFolderSelectionChanged" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="4,7">
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1" Text="{Binding UnreadCount}" Margin="8,0,2,0" FontSize="12" Opacity="0.7"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border x:Name="MessagePanel" Grid.Column="1" Margin="10,0" Padding="8" CornerRadius="18" Background="{DynamicResource HavenPanelBrush}">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid ColumnDefinitions="*,Auto" Margin="6,4,6,8">
                <TextBlock Text="{Binding FolderLabel}" FontWeight="SemiBold" FontSize="17"/>
                <TextBlock Grid.Column="1" Text="{Binding Messages.Count, StringFormat='{}{0} messages'}" FontSize="12" Opacity="0.65" VerticalAlignment="Center"/>
              </Grid>
              <Border Grid.Row="1" Padding="8" Margin="2,0,2,6" CornerRadius="12" Background="{DynamicResource HavenAccentSoftBrush}" IsVisible="{Binding HasBulkSelection}">
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                  <TextBlock Text="{Binding BulkSelectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <Button Content="Archive" Command="{Binding BulkArchiveCommand}" IsVisible="{Binding CanArchive}"/>
                  <Button Content="Delete" Command="{Binding RequestBulkDeleteCommand}" IsVisible="{Binding CanDelete}"/>
                  <Button Content="Read" Command="{Binding BulkMarkReadCommand}" IsVisible="{Binding CanChangeReadState}"/>
                  <Button Content="Unread" Command="{Binding BulkMarkUnreadCommand}" IsVisible="{Binding CanChangeReadState}"/>
                  <Button Content="Star" Command="{Binding BulkFlagCommand}" IsVisible="{Binding CanFlag}"/>
                  <Button Content="Spam" Command="{Binding BulkSpamCommand}" IsVisible="{Binding CanSpam}"/>
                  <Button Content="Important" Command="{Binding BulkImportantCommand}" IsVisible="{Binding CanImportant}"/>
                  <ComboBox Width="150" ItemsSource="{Binding MoveTargets}" SelectedItem="{Binding SelectedMoveTarget, Mode=TwoWay}" DisplayMemberBinding="{Binding DisplayName}" IsVisible="{Binding CanMove}"/>
                  <Button Content="Move" Command="{Binding MoveMessagesCommand}" IsVisible="{Binding CanMove}"/>
                </WrapPanel>
              </Border>
              <ListBox x:Name="MessageList" Grid.Row="2" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedSummary, Mode=TwoWay}" SelectionMode="Multiple,Toggle" SelectionChanged="OnMessageSelectionChanged" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid RowDefinitions="Auto,Auto,Auto" Margin="6,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="●" FontSize="8" VerticalAlignment="Center" IsVisible="{Binding !IsRead}"/>
                          <TextBlock Text="{Binding From.Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ReceivedAt, StringFormat='{}{0:dd MMM HH:mm}'}" FontSize="11" Opacity="0.65" Margin="8,0,0,0"/>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Subject}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="2" Text="{Binding Preview}" FontSize="12" Opacity="0.68" TextTrimming="CharacterEllipsis" MaxHeight="38"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border x:Name="ReadingPanel" Grid.Column="2" Padding="18" CornerRadius="18" Background="{DynamicResource HavenPanelBrush}">
            <Grid>
              <StackPanel IsVisible="{Binding HasSelectedMessage}" Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Button x:Name="BackToListButton" Grid.Column="0" Content="← Messages" Click="OnBackToListClick" IsVisible="False" Margin="0,0,10,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding SelectedMessage.Subject}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedMessage.From.Label}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding SelectedMessage.ReceivedAt, StringFormat='{}{0:dddd d MMMM yyyy, HH:mm}'}" FontSize="12" Opacity="0.65"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                    <Button Content="Reply" Command="{Binding ReplyCommand}"/>
                    <Button Content="Reply all" Command="{Binding ReplyAllCommand}"/>
                    <Button Content="Forward" Command="{Binding ForwardCommand}"/>
                  </StackPanel>
                </Grid>

                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                  <Button Content="Archive" Command="{Binding ArchiveCommand}" IsVisible="{Binding CanArchive}"/>
                  <Button Content="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"/>
                  <Button Content="{Binding ReadActionLabel}" Command="{Binding ToggleReadCommand}" IsVisible="{Binding CanChangeReadState}"/>
                  <Button Content="{Binding FlagActionLabel}" Command="{Binding ToggleFlagCommand}" IsVisible="{Binding CanFlag}"/>
                  <Button Content="{Binding SpamActionLabel}" Command="{Binding ToggleSpamCommand}" IsVisible="{Binding CanSpam}"/>
                  <Button Content="{Binding ImportantActionLabel}" Command="{Binding ToggleImportantCommand}" IsVisible="{Binding CanImportant}"/>
                  <ComboBox Width="170" ItemsSource="{Binding MoveTargets}" SelectedItem="{Binding SelectedMoveTarget, Mode=TwoWay}" DisplayMemberBinding="{Binding DisplayName}" IsVisible="{Binding CanMove}"/>
                  <Button Content="Move" Command="{Binding MoveMessagesCommand}" IsVisible="{Binding CanMove}"/>
                  <Button Content="Summarize" Command="{Binding SummarizeCommand}"/>
                  <Button Content="Draft reply" Command="{Binding DraftWithAiCommand}"/>
                </WrapPanel>

                <ItemsControl ItemsSource="{Binding SelectedMessage.Attachments}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding FileName}" Click="OnDownloadAttachmentClick" Margin="0,0,6,6"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border IsVisible="{Binding IsAiPanelVisible}" Padding="14" CornerRadius="14" Background="{DynamicResource HavenAccentSoftBrush}">
                  <Grid RowDefinitions="Auto,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding AiTitle}" FontWeight="SemiBold"/>
                      <Button Grid.Column="1" Content="×" Command="{Binding CloseAiCommand}"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding AiText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding ThreadMessages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="14" Margin="0,0,0,10" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource HavenBorderBrush}">
                          <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding From.Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Grid.Column="1" Text="{Binding ReceivedAt, StringFormat='{}{0:dd MMM yyyy, HH:mm}'}" FontSize="11" Opacity="0.65" Margin="10,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding PlainTextBody}" TextWrapping="Wrap" FontSize="14" LineHeight="21"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>

              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !HasSelectedMessage}">
                <TextBlock Text="Select a message" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="The message will open here without turning Mail into a chat." Opacity="0.65" TextAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" CornerRadius="18" Background="{DynamicResource HavenPanelBrush}" IsVisible="{Binding ShowConnectionRequired}">
          <StackPanel Spacing="8" MaxWidth="520">
            <TextBlock Text="Connect a mail account" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Mail reuses Haven's Google and Microsoft connected accounts. Open Settings → Connected services, connect an account, then return and refresh." TextWrapping="Wrap"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" CornerRadius="18" Background="{DynamicResource HavenPanelBrush}" IsVisible="{Binding ShowPermissionRequired}">
          <StackPanel Spacing="8" MaxWidth="520">
            <TextBlock Text="Mail permission needed" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="This account was connected before Mail permissions were added. Reconnect it in Settings to grant mail access; Haven will not pretend the old token can read or send mail." TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" CornerRadius="18" Background="{DynamicResource HavenPanelBrush}" IsVisible="{Binding ShowOffline}">
          <StackPanel Spacing="8" MaxWidth="520">
            <TextBlock Text="Mail is offline" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            <Button Content="Try again" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" CornerRadius="18" Background="{DynamicResource HavenPanelBrush}" IsVisible="{Binding ShowError}">
          <StackPanel Spacing="8" MaxWidth="520">
            <TextBlock Text="Mail couldn't load" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            <Button Content="Try again" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border x:Name="ComposePanel" Width="720" MaxWidth="720" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="22" Padding="18" CornerRadius="20" Background="{DynamicResource HavenPanelBrush}" BoxShadow="0 10 36 0 #55000000" IsVisible="{Binding IsComposeOpen}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Compose" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="Drafts save automatically · formatting is sent as HTML" FontSize="11" Opacity="0.65"/>
            </StackPanel>
            <Button Grid.Column="1" Content="×" Click="OnCloseComposeClick"/>
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding ComposeTo, Mode=TwoWay}" TextChanged="OnComposeTextChanged" Watermark="To (separate recipients with ; )" Margin="0,10,0,0"/>
          <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,8,0,0">
            <TextBox Grid.Column="0" Text="{Binding ComposeCc, Mode=TwoWay}" TextChanged="OnComposeTextChanged" Watermark="Cc" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Text="{Binding ComposeBcc, Mode=TwoWay}" TextChanged="OnComposeTextChanged" Watermark="Bcc" Margin="4,0,0,0"/>
          </Grid>
          <TextBox Grid.Row="3" Text="{Binding ComposeSubject, Mode=TwoWay}" TextChanged="OnComposeTextChanged" Watermark="Subject" Margin="0,8,0,0"/>
          <Border Grid.Row="4" Margin="0,8,0,0" CornerRadius="12" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource HavenBorderBrush}">
            <controls:MailRichTextEditor x:Name="ComposeEditor"/>
          </Border>
          <ItemsControl Grid.Row="5" ItemsSource="{Binding ComposeAttachments}" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,5" Margin="0,0,6,6" CornerRadius="10" Background="{DynamicResource HavenAccentSoftBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding FileName}"/>
                    <TextBlock Text="{Binding SizeLabel}" FontSize="11" Opacity="0.65"/>
                    <Button Content="×" Command="{Binding $parent[UserControl].DataContext.RemoveComposeAttachmentCommand}" CommandParameter="{Binding}" Padding="5,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="Attach" Click="OnAddAttachmentClick" IsVisible="{Binding CanUseAttachments}"/>
            <TextBlock Grid.Column="1" Text="{Binding ComposeStatus}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Content="Discard" Command="{Binding DiscardDraftCommand}" IsVisible="{Binding CanSaveDraft}"/>
            <Button Grid.Column="3" Content="Close" Click="OnCloseComposeClick" Margin="7,0,0,0"/>
            <Button Grid.Column="4" Content="Send" Click="OnRequestSendClick" Margin="7,0,0,0" Padding="18,8" IsVisible="{Binding CanSend}"/>
          </Grid>

          <Border Grid.RowSpan="7" IsVisible="{Binding IsSendConfirmationOpen}" Background="#99000000" CornerRadius="16">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" CornerRadius="16" Background="{DynamicResource HavenPanelBrush}" MaxWidth="440">
              <StackPanel Spacing="12">
                <TextBlock Text="Send this email?" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Sending is a real external action. Check the recipients and subject before confirming." TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ComposeTo}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ComposeSubject}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button Content="Go back" Command="{Binding CancelSendCommand}"/>
                  <Button Content="Confirm send" Command="{Binding ConfirmSendCommand}" Padding="18,8"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Border>
        </Grid>
      </Border>

      <Border IsVisible="{Binding IsFolderEditorOpen}" Background="#88000000" Padding="24">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" MaxWidth="420" Padding="20" CornerRadius="18" Background="{DynamicResource HavenPanelBrush}">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding FolderEditorTitle}" FontSize="21" FontWeight="SemiBold"/>
            <TextBox Text="{Binding FolderName, Mode=TwoWay}" Watermark="Name"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="Cancel" Command="{Binding CloseFolderEditorCommand}"/>
              <Button Content="Save" Command="{Binding SaveFolderCommand}" Padding="18,8"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <Border IsVisible="{Binding IsFolderDeleteConfirmationOpen}" Background="#88000000" Padding="24">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="430" MaxWidth="430" Padding="20" CornerRadius="18" Background="{DynamicResource HavenPanelBrush}">
          <StackPanel Spacing="12">
            <TextBlock Text="Delete this folder or label?" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedFolder.DisplayName}" FontWeight="SemiBold"/>
            <TextBlock Text="This changes the connected mail provider, not just Haven's local view." TextWrapping="Wrap" Opacity="0.75"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="Keep it" Command="{Binding CancelDeleteFolderCommand}"/>
              <Button Content="Delete" Command="{Binding ConfirmDeleteFolderCommand}" Padding="18,8"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <Border IsVisible="{Binding IsBulkDeleteConfirmationOpen}" Background="#88000000" Padding="24">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="430" MaxWidth="430" Padding="20" CornerRadius="18" Background="{DynamicResource HavenPanelBrush}">
          <StackPanel Spacing="12">
            <TextBlock Text="Delete selected messages?" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding BulkSelectionLabel}" FontWeight="SemiBold"/>
            <TextBlock Text="This is a real action on the connected mailbox." TextWrapping="Wrap" Opacity="0.75"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="Cancel" Command="{Binding CancelBulkDeleteCommand}"/>
              <Button Content="Delete" Command="{Binding ConfirmBulkDeleteCommand}" Padding="18,8"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Grid>
</UserControl>
