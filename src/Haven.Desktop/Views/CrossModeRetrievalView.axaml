<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/CrossModeRetrievalView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.CrossModeRetrievalView. Its visual vocabulary includes: Border, StackPanel, Grid, TextBlock, Button, TextBox, ProgressBar, ItemsControl, ItemsControl.ItemTemplate, DataTemplate.
  Data flow: Binding expressions read or update these view-model paths: ContextLabel, IndexLabel, IndexCommand, Query, ScopeAvailable, SearchCommand, ClearCommand, Status, IsBusy, Results, Number, Title, Score, Excerpt, Source, Location, InsertCommand.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Haven.Desktop.Views.CrossModeRetrievalView">
  <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
  <Border Background="{DynamicResource HavenPanel2Brush}"
          BorderBrush="{DynamicResource HavenLineBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="12">
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
    <StackPanel Spacing="9">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel>
          <TextBlock Text="PROJECT / SUBJECT RETRIEVAL" Classes="eyebrow" />
          <TextBlock Text="{Binding ContextLabel}" FontWeight="SemiBold" />
          <TextBlock Text="Indexes only the selected Studio root or Teach subject. Other projects and subjects are excluded." Classes="muted" FontSize="9" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding IndexLabel}" Command="{Binding IndexCommand}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
        <TextBox Text="{Binding Query}" PlaceholderText="Search the active project or subject" IsEnabled="{Binding ScopeAvailable}" />
        <Button Grid.Column="1" Content="Search" Classes="accent" Command="{Binding SearchCommand}" />
        <Button Grid.Column="2" Content="Clear" Command="{Binding ClearCommand}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Width="70" Height="4" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Results}" MaxHeight="170">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource HavenPanel3Brush}" CornerRadius="9" Padding="9" Margin="0,3,0,0">
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <TextBlock Text="{Binding Number}" Foreground="{DynamicResource HavenBlueBrush}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Score}" Classes="muted2" FontSize="9" />
                </Grid>
                <TextBlock Text="{Binding Excerpt}" FontSize="10" MaxLines="4" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Source}" Classes="muted2" FontSize="9" />
                  <TextBlock Text="·" Classes="muted2" FontSize="9" />
                  <TextBlock Text="{Binding Location}" Classes="muted2" FontSize="9" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="Insert scoped citations into composer" Command="{Binding InsertCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </Border>
</UserControl>
