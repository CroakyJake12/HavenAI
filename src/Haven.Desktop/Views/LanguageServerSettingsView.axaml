<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/LanguageServerSettingsView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.LanguageServerSettingsView. Its visual vocabulary includes: Border, StackPanel, Grid, TextBlock, Button, ItemsControl, ItemsControl.ItemTemplate, DataTemplate, TextBox, CheckBox, NumericUpDown, ProgressBar.
  Data flow: Binding expressions read or update these view-model paths: AddCommand, RefreshCommand, Items, DisplayName, Id, IsEnabled, Command, Arguments, LanguageId, ExtensionsText, RequestTimeoutSeconds, InitializationOptionsJson, Status, IsBusy.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:havenUi="using:Haven.Desktop.HavenUI.Components.Buttons"
             x:Class="Haven.Desktop.Views.LanguageServerSettingsView">
  <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
  <hui:HavenAdaptiveSurface Classes="card">
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
    <StackPanel Spacing="11">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <StackPanel>
          <TextBlock Text="LANGUAGE SERVERS" Classes="eyebrow" />
          <TextBlock Text="Trusted external code-intelligence processes" Classes="sectionHeading" Margin="0,4,0,0" />
        </StackPanel>
        <hui:HavenButton Grid.Column="1" Content="Add custom" Command="{Binding AddCommand}" />
        <hui:HavenButton Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" />
      </Grid>
      <TextBlock Text="Definitions are stored in Haven's app-data settings, not loaded from repositories. Built-in suggestions are disabled until you review and enable them. Commands run only for matching files inside the selected Studio project."
                 Classes="muted" FontSize="10" TextWrapping="Wrap" />

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <hui:HavenAdaptiveSurface Background="{DynamicResource HavenPanel2Brush}"
                    BorderBrush="{DynamicResource HavenLineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,8">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="7">
                  <hui:HavenTextInput Text="{Binding DisplayName}" PlaceholderText="Display name" />
                  <hui:HavenTextInput Grid.Column="1" Text="{Binding Id}" PlaceholderText="Stable identifier" />
                  <hui:HavenCheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Command" Classes="muted" FontSize="9" />
                    <hui:HavenTextInput Text="{Binding Command}" PlaceholderText="Executable or absolute path" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="Arguments" Classes="muted" FontSize="9" />
                    <hui:HavenTextInput Text="{Binding Arguments}" PlaceholderText="e.g. --stdio" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="7">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Language ID" Classes="muted" FontSize="9" />
                    <hui:HavenTextInput Text="{Binding LanguageId}" PlaceholderText="csharp" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="Extensions" Classes="muted" FontSize="9" />
                    <hui:HavenTextInput Text="{Binding ExtensionsText}" PlaceholderText=".cs, .csx" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="Timeout (seconds)" Classes="muted" FontSize="9" />
                    <hui:HavenNumericInput Value="{Binding RequestTimeoutSeconds}" Minimum="2" Maximum="120" Increment="1" Width="110" />
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="3">
                  <TextBlock Text="Initialization options JSON" Classes="muted" FontSize="9" />
                  <hui:HavenTextInput Text="{Binding InitializationOptionsJson}"
                           AcceptsReturn="True"
                           TextWrapping="NoWrap"
                           FontFamily="Cascadia Mono, Consolas, monospace"
                           MinHeight="52"
                           MaxHeight="140"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                  <TextBlock Text="{Binding Status}" Classes="muted" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <hui:HavenProgressBar Grid.Column="1" Width="52" Height="4" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                  <havenUi:HoldToConfirmButton Grid.Column="2"
                                               Content="Delete"
                                               Command="{Binding $parent[UserControl].DataContext.DeleteCommand}"
                                               CommandParameter="{Binding}" />
                  <hui:HavenButton Grid.Column="3"
                          Content="Save"
                          Classes="accent"
                          Command="{Binding $parent[UserControl].DataContext.SaveCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </StackPanel>
            </hui:HavenAdaptiveSurface>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Status}" Classes="muted" />
      <hui:HavenProgressBar Height="4" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    </StackPanel>
  </hui:HavenAdaptiveSurface>
</UserControl>
