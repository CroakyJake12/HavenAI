<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.CallView"
             Loaded="OnLoaded">
  <Border Padding="24">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:HavenIcon IconKey="call" Width="24" Height="24"
                      Foreground="{DynamicResource HavenAccentBrush}"/>
            <TextBlock Text="Haven Call" FontSize="24" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock Text="A private local voice conversation with your Ollama model"
                     Foreground="{DynamicResource HavenMutedBrush}"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource HavenPanel2Brush}"
                BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                CornerRadius="999" Padding="12,6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource HavenAccentBrush}"/>
            <TextBlock x:Name="StateLabel" FontWeight="SemiBold" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="18">
        <ScrollViewer Grid.Column="0">
          <StackPanel Spacing="14">
            <Border Background="{DynamicResource HavenPanel2Brush}"
                    BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="Call setup" FontSize="16" FontWeight="SemiBold"/>

                <StackPanel Spacing="5">
                  <TextBlock Text="Ollama model" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                  <ComboBox x:Name="ModelSelector" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="Conversation mode" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                  <ComboBox x:Name="InputModeSelector"/>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="Microphone" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                  <ComboBox x:Name="InputDeviceSelector"/>
                  <TextBlock x:Name="SpeechInputStatus" TextWrapping="Wrap" FontSize="11"
                             Foreground="{DynamicResource HavenMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="Speech model" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                  <ComboBox x:Name="SpeechModelSelector"/>
                  <TextBlock x:Name="SpeechModelStatus" FontSize="11"
                             Foreground="{DynamicResource HavenMutedBrush}"/>
                  <StackPanel x:Name="SpeechModelSetupPanel" Spacing="7" IsVisible="False">
                    <ProgressBar x:Name="SpeechModelProgress" IsVisible="False" Maximum="100"/>
                    <Button x:Name="DownloadSpeechModelButton" Content="Download model"
                            Classes="secondary" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="Voice" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                  <ComboBox x:Name="VoiceSelector"/>
                  <TextBlock x:Name="SelectedVoiceDescription" TextWrapping="Wrap" FontSize="10"
                             Foreground="{DynamicResource HavenMutedBrush}" />
                  <CheckBox x:Name="EnableSpeechOutputCheckBox" Content="Speak Haven responses"/>
                  <TextBlock x:Name="SpeechOutputStatus" TextWrapping="Wrap" FontSize="11"
                             Foreground="{DynamicResource HavenMutedBrush}"/>
                </StackPanel>

                <Button x:Name="StartCallButton" Content="Start local call"
                        Classes="primary" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource HavenPanel2Brush}"
                    BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="14">
              <StackPanel Spacing="6">
                <TextBlock Text="Privacy" FontWeight="SemiBold"/>
                <TextBlock Text="Audio and screen frames stay in memory only. Haven stores the text transcript and call metadata, never raw media."
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                <TextBlock x:Name="ScreenShareStatus" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource HavenMutedBrush}"/>
                <StackPanel x:Name="ScreenSharePanel" Spacing="8" Margin="0,6,0,0" IsVisible="False">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="8" Height="8" Fill="#EF4444"/>
                    <TextBlock Text="Screen sharing is on" FontSize="11" FontWeight="SemiBold"/>
                  </StackPanel>
                  <Border x:Name="ScreenPreviewBorder" CornerRadius="10" ClipToBounds="True"
                          BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                          Background="#FF000000" MinHeight="96" MaxHeight="160" IsVisible="False">
                    <Image x:Name="ScreenPreview" Stretch="Uniform"/>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource HavenPanel2Brush}"
                BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                CornerRadius="14">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Padding="18,14" BorderBrush="{DynamicResource HavenLineBrush}"
                    BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Live transcript" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource HavenMutedBrush}"/>
                </StackPanel>
                <Button x:Name="InterruptButton" Grid.Column="1" Content="Interrupt"
                        Classes="subtle" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <StackPanel x:Name="EmptyTranscriptPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                <Border Width="72" Height="72" CornerRadius="36"
                        Background="{DynamicResource HavenAccentSoftBrush}">
                  <controls:HavenIcon IconKey="call" Width="32" Height="32"
                            Foreground="{DynamicResource HavenAccentBrush}" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Start a call, then speak or type below" FontWeight="SemiBold"/>
                <TextBlock Text="Typed transcript mode works even when optional audio components are unavailable."
                           FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
              </StackPanel>

              <ListBox x:Name="TranscriptScroller" Padding="18" IsVisible="False"
                       BorderThickness="0" Background="Transparent"/>
            </Grid>

            <Border Grid.Row="2" Padding="16" BorderBrush="{DynamicResource HavenLineBrush}"
                    BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox x:Name="TypedTranscriptBox" Grid.Column="0"
                         PlaceholderText="Type what you want to say…"/>
                <Button x:Name="SendTranscriptButton" Grid.Column="1" Content="Send"
                        Classes="primary" MinWidth="76"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource HavenPanel2Brush}"
              BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
              CornerRadius="14" Padding="14">
        <Grid ColumnDefinitions="*,Auto,*">
          <ItemsControl x:Name="WaveformBars" Grid.Column="0"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="3" Height="{Binding Height}" CornerRadius="2"
                        Background="{DynamicResource HavenAccentBrush}" VerticalAlignment="Center"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="MuteButton" Content="Mute" Classes="secondary"/>
            <Button x:Name="PushToTalkButton" Content="Hold to talk" Classes="primary"
                    PointerPressed="OnPushToTalkPressed" PointerReleased="OnPushToTalkReleased"
                    PointerCaptureLost="OnPushToTalkCaptureLost"/>
            <Button x:Name="PauseButton" Content="Pause" Classes="secondary"/>
            <Button x:Name="ShareButton" Content="Share screen" Classes="secondary"/>
            <Button x:Name="EndCallButton" Content="End call" Classes="danger"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
