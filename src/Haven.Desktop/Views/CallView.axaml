<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Haven.Desktop.ViewModels"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.CallView"
             x:DataType="vm:CallPageViewModel"
             Loaded="OnLoaded">
  <Border Padding="24">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:HavenIcon IconKey="call" Width="24" Height="24"
                      Foreground="{DynamicResource HavenAccentBrush}"/>
            <TextBlock Text="Haven Call" FontSize="24" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock Text="A private local voice conversation with your Ollama model"
                     Foreground="{DynamicResource HavenMutedBrush}"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource HavenPanel2Brush}"
                BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                CornerRadius="999" Padding="12,6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource HavenAccentBrush}"/>
            <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="18">
        <ScrollViewer Grid.Column="0">
          <StackPanel Spacing="14">
            <Border Background="{DynamicResource HavenPanel2Brush}"
                    BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="Call setup" FontSize="16" FontWeight="SemiBold"/>

                <StackPanel Spacing="5">
                  <TextBlock Text="Ollama model" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                  <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}"
                            IsEnabled="{Binding IsNotActive}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="Conversation mode" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                  <ComboBox ItemsSource="{Binding InputModes}" SelectedItem="{Binding InputMode}"
                            IsEnabled="{Binding IsNotActive}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="Microphone" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                  <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice}"
                            IsEnabled="{Binding IsNotActive}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding SpeechInputStatus}" TextWrapping="Wrap" FontSize="11"
                             Foreground="{DynamicResource HavenMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="Speech model" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                  <ComboBox ItemsSource="{Binding AvailableSpeechModels}" SelectedItem="{Binding SelectedSpeechModel}"
                            IsEnabled="{Binding IsNotActive}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding SpeechModelStatus}" FontSize="11"
                             Foreground="{DynamicResource HavenMutedBrush}"/>
                  <StackPanel IsVisible="{Binding ShowSpeechModelSetup}" Spacing="7">
                    <ProgressBar IsVisible="{Binding IsDownloadingSpeechModel}"
                                 Value="{Binding SpeechModelDownloadProgress}" Maximum="100"/>
                    <Button Content="Download model" Command="{Binding DownloadSpeechModelCommand}"
                            Classes="secondary" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="Voice" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                  <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"
                            IsEnabled="{Binding IsNotActive}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox Content="Speak Haven responses" IsChecked="{Binding EnableSpeechOutput}"
                            IsEnabled="{Binding IsNotActive}"/>
                  <TextBlock Text="{Binding SpeechOutputStatus}" TextWrapping="Wrap" FontSize="11"
                             Foreground="{DynamicResource HavenMutedBrush}"/>
                </StackPanel>

                <Button Content="Start local call" Command="{Binding StartCallCommand}"
                        Classes="primary" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource HavenPanel2Brush}"
                    BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="14">
              <StackPanel Spacing="6">
                <TextBlock Text="Privacy" FontWeight="SemiBold"/>
                <TextBlock Text="Audio and screen frames stay in memory only. Haven stores the text transcript and call metadata, never raw media."
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
                <TextBlock Text="{Binding ScreenShareStatus}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource HavenMutedBrush}"/>
                <StackPanel IsVisible="{Binding IsSharing}" Spacing="8" Margin="0,6,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="8" Height="8" Fill="#EF4444"/>
                    <TextBlock Text="Screen sharing is on" FontSize="11" FontWeight="SemiBold"/>
                  </StackPanel>
                  <Border IsVisible="{Binding HasScreenPreview}" CornerRadius="10" ClipToBounds="True"
                          BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                          Background="#FF000000" MinHeight="96" MaxHeight="160">
                    <Image Source="{Binding ScreenPreview}" Stretch="Uniform"/>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource HavenPanel2Brush}"
                BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                CornerRadius="14">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Padding="18,14" BorderBrush="{DynamicResource HavenLineBrush}"
                    BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Live transcript" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource HavenMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Interrupt" Command="{Binding InterruptCommand}"
                        Classes="subtle" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9"
                          IsVisible="{Binding !HasTranscript}">
                <Border Width="72" Height="72" CornerRadius="36"
                        Background="{DynamicResource HavenAccentSoftBrush}">
                  <controls:HavenIcon IconKey="call" Width="32" Height="32"
                            Foreground="{DynamicResource HavenAccentBrush}" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Start a call, then speak or type below" FontWeight="SemiBold"/>
                <TextBlock Text="Typed transcript mode works even when optional audio components are unavailable."
                           FontSize="12" Foreground="{DynamicResource HavenMutedBrush}"/>
              </StackPanel>

              <ScrollViewer x:Name="TranscriptScroller" Padding="18" IsVisible="{Binding HasTranscript}">
                <ItemsControl ItemsSource="{Binding Transcript}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CallTranscriptItemViewModel">
                      <Border Margin="0,0,0,14" Padding="14"
                              Background="{DynamicResource HavenPanel3Brush}"
                              BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
                              CornerRadius="12">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontSize="11"
                                       Foreground="{DynamicResource HavenMutedBrush}"/>
                          </Grid>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Live…" IsVisible="{Binding IsPartial}" FontSize="11"
                                       Foreground="{DynamicResource HavenAccentBrush}"/>
                            <TextBlock Text="Interrupted" IsVisible="{Binding WasInterrupted}" FontSize="11"
                                       Foreground="{DynamicResource HavenMutedBrush}"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Padding="16" BorderBrush="{DynamicResource HavenLineBrush}"
                    BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Grid.Column="0" Text="{Binding TypedTranscript}"
                         PlaceholderText="Type what you want to say…" IsEnabled="{Binding IsActive}"/>
                <Button Grid.Column="1" Content="Send" Command="{Binding SendTranscriptCommand}"
                        Classes="primary" MinWidth="76"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource HavenPanel2Brush}"
              BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1"
              CornerRadius="14" Padding="14">
        <Grid ColumnDefinitions="*,Auto,*">
          <ItemsControl Grid.Column="0" ItemsSource="{Binding WaveformBars}"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WaveformBarViewModel">
                <Border Width="3" Height="{Binding Height}" CornerRadius="2"
                        Background="{DynamicResource HavenAccentBrush}" VerticalAlignment="Center"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}" Classes="secondary"/>
            <Button x:Name="PushToTalkButton" Content="{Binding PushToTalkLabel}" Classes="primary"
                    IsEnabled="{Binding IsActive}"
                    PointerPressed="OnPushToTalkPressed" PointerReleased="OnPushToTalkReleased"
                    PointerCaptureLost="OnPushToTalkCaptureLost"/>
            <Button Content="{Binding PauseLabel}" Command="{Binding PauseResumeCommand}" Classes="secondary"/>
            <Button Content="{Binding ShareLabel}" Command="{Binding ToggleScreenShareCommand}" Classes="secondary"/>
            <Button Content="End call" Command="{Binding EndCallCommand}" Classes="danger"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
