<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/HomeView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.HomeView. Its visual vocabulary includes: ScrollViewer, Grid, StackPanel, TextBlock, Border, Button, HavenIcon, ItemsControl, ItemsControl.ItemsPanel, ItemsPanelTemplate, WrapPanel, ItemsControl.ItemTemplate, DataTemplate.
  Data flow: Binding expressions read or update these view-model paths: Greeting, DateLabel, ModelStatus, LastUpdatedLabel, ToggleCustomizeCommand, RefreshCommand, Status, Tiles, IconKey, Title, HasBadge, Badge, Primary, Secondary, Description, IsCustomizing, HiddenTiles, Agenda, Detail, TimeLabel, RecentWork, UpdatedLabel.
  Interaction: Direct event handlers in this file are: Tile_PointerPressed, Tile_PointerReleased.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:vm="using:Haven.Desktop.ViewModels"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.HomeView"
             x:DataType="vm:HomePageViewModel">
  <!-- Section: Keeps the region usable when content exceeds the available window size. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
    <Grid Margin="34,28,34,48" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="24" MaxWidth="1260" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding Greeting}" Classes="heading" />
          <TextBlock Text="{Binding DateLabel}" Classes="soft" FontSize="15" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <hui:HavenAdaptiveSurface Classes="statusPill"><TextBlock Text="{Binding ModelStatus}" FontSize="11" /></hui:HavenAdaptiveSurface>
            <hui:HavenAdaptiveSurface Classes="statusPill"><TextBlock Text="{Binding LastUpdatedLabel}" Classes="muted" FontSize="11" /></hui:HavenAdaptiveSurface>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <hui:HavenButton Classes="subtle" Command="{Binding ToggleCustomizeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7"><controls:HavenIcon IconKey="settings" Width="16" Height="16" /><TextBlock Text="Customise" /></StackPanel>
          </hui:HavenButton>
          <hui:HavenButton Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh dashboard">
            <controls:HavenIcon IconKey="refresh" Width="18" Height="18" />
          </hui:HavenButton>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="12">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Quick access" Classes="sectionHeading" /><TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" /></Grid>
        <ItemsControl ItemsSource="{Binding Tiles}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DashboardTileViewModel">
              <hui:HavenAdaptiveSurface Classes="dashboardTile" Width="270" MinHeight="150" Margin="0,0,12,12" Tag="{Binding}"
                      PointerPressed="Tile_PointerPressed" PointerEntered="Tile_PointerEntered" PointerReleased="Tile_PointerReleased"
                      ToolTip.Tip="Turn on Customise, then drag to reorder">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <hui:HavenAdaptiveSurface Classes="iconPlate"><controls:HavenIcon IconKey="{Binding IconKey}" Width="20" Height="20" /></hui:HavenAdaptiveSurface>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <hui:HavenAdaptiveSurface Grid.Column="2" Classes="warningPill" IsVisible="{Binding HasBadge}"><TextBlock Text="{Binding Badge}" FontSize="10" /></hui:HavenAdaptiveSurface>
                  </Grid>
                  <StackPanel Grid.Row="1" Spacing="3">
                    <TextBlock Text="{Binding Primary}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Secondary}" Classes="muted" />
                    <TextBlock Text="{Binding Description}" Classes="muted2" FontSize="11" />
                  </StackPanel>
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                    <hui:HavenButton Classes="subtle" Command="{Binding $parent[UserControl].DataContext.OpenTileCommand}" CommandParameter="{Binding}">Open</hui:HavenButton>
                    <hui:HavenButton Grid.Column="1" Classes="icon compact" Command="{Binding $parent[UserControl].DataContext.MoveEarlierCommand}" CommandParameter="{Binding}" ToolTip.Tip="Move earlier"><controls:HavenIcon IconKey="chevron-left" Width="14" Height="14" /></hui:HavenButton>
                    <hui:HavenButton Grid.Column="2" Classes="icon compact" Command="{Binding $parent[UserControl].DataContext.MoveLaterCommand}" CommandParameter="{Binding}" ToolTip.Tip="Move later"><controls:HavenIcon IconKey="chevron-left" RenderTransform="rotate(180deg)" Width="14" Height="14" /></hui:HavenButton>
                    <hui:HavenButton Grid.Column="3" Classes="icon compact" Command="{Binding $parent[UserControl].DataContext.ToggleTileCommand}" CommandParameter="{Binding}" ToolTip.Tip="Hide tile"><controls:HavenIcon IconKey="close" Width="13" Height="13" /></hui:HavenButton>
                  </Grid>
                </Grid>
              </hui:HavenAdaptiveSurface>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <hui:HavenAdaptiveSurface Classes="card" IsVisible="{Binding IsCustomizing}" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Hidden tiles" FontWeight="SemiBold" />
            <TextBlock Text="Choose a tile to return it to Home. Tile order is saved locally." Classes="muted" FontSize="11" />
            <ItemsControl ItemsSource="{Binding HiddenTiles}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DashboardTileViewModel"><hui:HavenButton Classes="chip" Margin="0,0,6,6" Command="{Binding $parent[UserControl].DataContext.ToggleTileCommand}" CommandParameter="{Binding}"><StackPanel Orientation="Horizontal" Spacing="6"><controls:HavenIcon IconKey="{Binding IconKey}" Width="14" Height="14" /><TextBlock Text="{Binding Title}" /></StackPanel></hui:HavenButton></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No tiles are hidden." Classes="muted" IsVisible="{Binding !HasHiddenTiles}" />
          </StackPanel>
        </hui:HavenAdaptiveSurface>
      </StackPanel>

      <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="18">
        <hui:HavenAdaptiveSurface Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Today" Classes="sectionHeading" />
            <ItemsControl ItemsSource="{Binding Agenda}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DashboardAgendaItemViewModel"><hui:HavenButton Classes="sidebar" Command="{Binding $parent[UserControl].DataContext.OpenAgendaItemCommand}" CommandParameter="{Binding}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><hui:HavenAdaptiveSurface Classes="agendaDot" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding TimeLabel}" Classes="muted" /></Grid></hui:HavenButton></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Nothing scheduled. Your day is clear." Classes="muted" IsVisible="{Binding !HasAgenda}" />
          </StackPanel>
        </hui:HavenAdaptiveSurface>
        <hui:HavenAdaptiveSurface Grid.Column="1" Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Recent work" Classes="sectionHeading" />
            <ItemsControl ItemsSource="{Binding RecentWork}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DashboardWorkItemViewModel"><hui:HavenButton Classes="sidebar" Command="{Binding $parent[UserControl].DataContext.OpenRecentItemCommand}" CommandParameter="{Binding}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><controls:HavenIcon IconKey="{Binding IconKey}" Width="18" Height="18" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding UpdatedLabel}" Classes="muted2" FontSize="10" /></Grid></hui:HavenButton></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Your recent chats and projects will appear here." Classes="muted" IsVisible="{Binding !HasRecentWork}" />
          </StackPanel>
        </hui:HavenAdaptiveSurface>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
