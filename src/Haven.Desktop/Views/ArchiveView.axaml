<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:havenUi="using:Haven.Desktop.HavenUI.Components.Buttons"
             x:Class="Haven.Desktop.Views.ArchiveView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="900" Margin="34,30" Spacing="18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock x:Name="TitleText" Classes="heading" />
          <TextBlock Text="Archived items stay local and can be restored." Classes="muted" />
        </StackPanel>
        <hui:HavenButton x:Name="RefreshButton" Grid.Column="1" Content="Refresh" />
      </Grid>

      <ItemsControl x:Name="ArchivedItemsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <hui:HavenAdaptiveSurface Classes="card" Margin="0,0,0,8">
              <Grid>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsNormal}" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Kind}" Classes="muted" />
                      <TextBlock Text="·" Classes="muted" />
                      <TextBlock Text="{Binding Updated}" Classes="muted" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                    <hui:HavenButton Content="Restore" Classes="accent" />
                    <hui:HavenButton Content="Delete forever" Classes="danger" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsDeleteConfirming}" ColumnSpacing="7">
                  <TextBlock Text="Permanently delete this item? This cannot be undone." Foreground="{DynamicResource HavenDangerBrush}" VerticalAlignment="Center" />
                  <hui:HavenButton Grid.Column="1" Content="Cancel" />
                  <havenUi:HoldToConfirmButton Grid.Column="2"
                                               Content="Delete forever"
                                               ActionLabel="delete forever" />
                </Grid>
              </Grid>
            </hui:HavenAdaptiveSurface>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="StatusText" Classes="muted" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
