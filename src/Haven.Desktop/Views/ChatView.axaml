<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.ChatView">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>

				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush
                        x:Key="PopupTintBrush"
                        Color="#751f1f1c" />

					<SolidColorBrush
                        x:Key="PopupBorderBrush"
                        Color="#ffffff00" />
				</ResourceDictionary>

				<ResourceDictionary x:Key="Light">
					<SolidColorBrush
                        x:Key="PopupTintBrush"
                        Color="#E6F3F5F7" />

					<SolidColorBrush
                        x:Key="PopupBorderBrush"
                        Color="#30000000" />
				</ResourceDictionary>

			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	
  <!-- Chat View — the main conversation interface with messages, composer, and pickers -->
  <Grid>
    <!-- ============================================================
         SCROLLABLE MESSAGE AREA
         Shows either empty state (with starter prompts) or the message list.
         Max width 1020px, centered. Bottom margin leaves room for the composer.
         ============================================================ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid HorizontalAlignment="Stretch" Margin="30,28,30,235">

        <!-- Empty state: shown when no messages exist yet -->
        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" MaxWidth="1020" Margin="0,65,0,30" Spacing="12">
          <Image Source="/Assets/haven-192.png" Width="62" Height="62" />
          <TextBlock Text="{Binding EmptyTitle}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ModeSubtitle}" Classes="muted" TextAlignment="Center" />
        </StackPanel>

        <!-- ============================================================
             MESSAGE LIST
             Each message shows: avatar, display name, model badge, timestamp,
             markdown content, tool activities, confidence indicator, state label.
             ============================================================ -->
        <ItemsControl ItemsSource="{Binding Messages}" IsVisible="{Binding HasMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="38,*" ColumnSpacing="13" Margin="0,0,0,28" Opacity="{Binding ContentOpacity}">
                <!-- Avatar circle with initial letter -->
                <Border Classes="avatar" Width="36" Height="36"><Image Source="/Assets/haven-32.png" Width="36" Height="36" /></Border>
                <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="{Binding Alignment}" MaxWidth="{Binding MaxBubbleWidth}">
                  <!-- Header: display name + model badge + timestamp -->
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><Border Grid.Column="1" Background="{DynamicResource HavenBlueSoftBrush}" CornerRadius="999" Padding="7,2" IsVisible="{Binding HasModelLabel}"><TextBlock Text="{Binding ModelLabel}" Foreground="{DynamicResource HavenBlueBrush}" FontSize="9" /></Border><TextBlock Grid.Column="3" Text="{Binding TimeLabel}" Classes="muted2" FontSize="10" /></Grid>
                  <!-- Message bubble with markdown content -->
                  <Border Background="#18FFFFFF" BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1" CornerRadius="14" Padding="15,12">
                    <controls:MarkdownView Markdown="{Binding Content}"><controls:MarkdownView.ContextMenu><ContextMenu><MenuItem Header="Copy message" Click="OnCopyMessageClicked" /></ContextMenu></controls:MarkdownView.ContextMenu></controls:MarkdownView>
                  </Border>
                  <!-- Tool activity list — shows file edits, commands, etc. -->
                  <ItemsControl ItemsSource="{Binding Activities}" IsVisible="{Binding HasActivities}">
                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource HavenPanel2Brush}" BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,2"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><StackPanel Spacing="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" /><TextBlock Text="{Binding Detail}" Classes="muted" FontFamily="Cascadia Code, Consolas" FontSize="9" MaxLines="4" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Duration}" Classes="muted2" FontSize="9" HorizontalAlignment="Right" /><TextBlock Text="{Binding ChangeLabel}" Foreground="{DynamicResource HavenAccentBrush}" FontSize="9" IsVisible="{Binding HasChanges}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Confidence indicator bar (if shown) -->
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasConfidence}" ColumnSpacing="7"><TextBlock Text="{Binding ConfidenceLabel}" Classes="muted2" FontSize="9" /><Border Grid.Column="1" Height="3" Width="160" Background="{DynamicResource HavenPanel3Brush}" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"><Border Width="{Binding ConfidenceWidth}" Background="{DynamicResource HavenAccentBrush}" CornerRadius="2" HorizontalAlignment="Left" /></Border></Grid>
                  <!-- State label (e.g. "Thinking…") -->
                  <TextBlock Text="{Binding State}" Classes="muted2" FontSize="10" IsVisible="{Binding HasState}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>

    <!-- ============================================================
         OVERLAY BACKDROP BUTTONS
         Transparent buttons that close open pickers when clicked.
         ============================================================ -->
    <Button Background="Transparent" BorderThickness="0"
            IsVisible="{Binding IsPluginPickerOpen}"
            Command="{Binding ClosePickersCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    <Button Background="Transparent" BorderThickness="0"
            IsVisible="{Binding IsPromptPickerOpen}"
            Command="{Binding ClosePickersCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

    <!-- ============================================================
         BOTTOM COMPOSER AREA (anchored to bottom)
         Contains: permission banners, inline question, edit progress, composer box.
         ============================================================ -->
    <Grid Margin="24,0,24,14" MaxWidth="920" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

      <!-- Missing plugin notice — shown when a referenced plugin isn't available -->
      <Border Classes="permission" Margin="0,0,0,8" IsVisible="{Binding HasMissingPluginNotice}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="{Binding MissingPluginName, StringFormat='Missing plugin: @{0}'}" FontWeight="SemiBold" /><TextBlock Text="{Binding MissingPluginReason}" Classes="muted" FontSize="10" /></StackPanel><Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissMissingPluginCommand}" /><Button Grid.Column="2" Content="Enable and retry" Classes="accent" Command="{Binding RetryWithPluginCommand}" /></Grid>
      </Border>

      <!-- Computer Use permission banner — enable Windows UI automation for this pass -->
      <Border Grid.Row="1" Classes="permission" Margin="0,0,0,8" IsVisible="{Binding IsComputerPermissionPending}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9"><Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource HavenAccentSoftBrush}"><TextBlock Text="▣" Foreground="{DynamicResource HavenAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Enable Computer Use" FontWeight="SemiBold" /><TextBlock Text="Target-bound Windows controls for this pass, with inspection and action limits." Classes="muted" FontSize="10" /></StackPanel><Button Grid.Column="2" Content="Remove" Command="{Binding DismissComputerUseCommand}" /><Button Grid.Column="3" Content="Enable for this pass" Classes="accent" Command="{Binding EnableComputerUseCommand}" /></Grid>
      </Border>

      <!-- Tool permission request — agent wants to run a tool, user must approve -->
      <Border Grid.Row="2" Classes="permission" Margin="0,0,0,8" IsVisible="{Binding IsToolPermissionPending}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="Tool permission" FontWeight="SemiBold" /><TextBlock Text="{Binding ToolPermissionRequest}" Classes="muted" FontSize="10" /></StackPanel><Button Grid.Column="1" Content="Deny" Command="{Binding DismissToolPermissionCommand}" /><Button Grid.Column="2" Content="Allow once" Classes="accent" Command="{Binding ApproveToolPermissionCommand}" /></Grid>
      </Border>

      <!-- Inline question — agent asks a clarifying question with option buttons -->
      <Border Grid.Row="3" Classes="card" Margin="0,0,0,8" IsVisible="{Binding HasInlineQuestion}" Padding="12">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Text="{Binding InlineQuestion.Question}" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding InlineQuestion.Options}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Classes="chip" Margin="0,0,6,4" Command="{Binding $parent[UserControl].DataContext.AnswerInlineQuestionCommand}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><Button Grid.Column="1" Classes="chrome" Command="{Binding DismissInlineQuestionCommand}" ToolTip.Tip="Dismiss"><controls:HavenIcon IconKey="close" Width="13" Height="13" /></Button></Grid>
      </Border>

      <!-- Edit progress bar — shown while the agent is editing files -->
      <Border Grid.Row="4" Classes="card" Padding="10" Margin="0,0,0,8" IsVisible="{Binding IsEditProgressVisible}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"><TextBlock Text="Editing" Foreground="{DynamicResource HavenAccentBrush}" FontWeight="SemiBold" /><ProgressBar Grid.Column="1" IsIndeterminate="True" Height="4" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding EditProgressLabel}" Classes="muted" FontSize="10" /></Grid>
      </Border>

      <!-- ============================================================
           COMPOSER BOX
           The main text input area with:
           - Plugin picker dropdown
           - Prompt library dropdown
           - Attachment chips
           - Active plugin/prompt chips
           - Agent + Duo mode bars
           - Text input + toolbar (attach, @, >, temporary, model, effort, send)
           ============================================================ -->
      <Border Grid.Row="5" Classes="composer" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <!-- Plugin picker dropdown -->
          <Border Background="{DynamicResource PopupTintBrush}" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="10" IsVisible="{Binding IsPluginPickerOpen}" CornerRadius="12">
            <StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="PLUGINS" Classes="eyebrow" /><Button Grid.Column="1" Classes="chrome" Command="{Binding ClosePickersCommand}" ToolTip.Tip="Close"><controls:HavenIcon IconKey="close" Width="13" Height="13" /></Button></Grid><ItemsControl ItemsSource="{Binding PluginSuggestions}"><ItemsControl.ItemTemplate><DataTemplate><Button Classes="sidebar" HorizontalAlignment="Stretch" IsVisible="{Binding IsVisibleInPicker}" Command="{Binding $parent[UserControl].DataContext.SelectPluginCommand}" CommandParameter="{Binding}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"><controls:HavenIcon IconKey="{Binding IconKey}" Width="18" Height="18" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding AllowedModesLabel}" Classes="muted2" FontSize="9" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          </Border>
          <!-- Prompt library dropdown -->
          <Border Grid.Row="1" Background="{DynamicResource HavenPanel3Brush}" BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="0,0,0,1" Padding="10" IsVisible="{Binding IsPromptPickerOpen}">
            <StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="PROMPT LIBRARY" Classes="eyebrow" /><Button Grid.Column="1" Classes="chrome" Command="{Binding ClosePickersCommand}" ToolTip.Tip="Close"><controls:HavenIcon IconKey="close" Width="13" Height="13" /></Button></Grid><ItemsControl ItemsSource="{Binding PromptSuggestions}"><ItemsControl.ItemTemplate><DataTemplate><Button Classes="sidebar" HorizontalAlignment="Stretch" IsVisible="{Binding IsVisibleInPicker}" Command="{Binding $parent[UserControl].DataContext.SelectPromptCommand}" CommandParameter="{Binding}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"><controls:HavenIcon IconKey="{Binding IconKey}" Width="18" Height="18" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding AllowedModesLabel}" Classes="muted2" FontSize="9" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          </Border>

          <!-- Attachment chips row -->
          <ItemsControl Grid.Row="2" ItemsSource="{Binding Attachments}" Margin="12,8,12,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource HavenPanel3Brush}" CornerRadius="9" Padding="8,5" Margin="0,0,6,5"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource HavenBlueBrush}" FontSize="9" /><TextBlock Text="{Binding Name}" FontSize="10" MaxWidth="190" TextTrimming="CharacterEllipsis" /><Button Classes="chrome" Command="{Binding $parent[UserControl].DataContext.RemoveAttachmentCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove attachment"><controls:HavenIcon IconKey="close" Width="11" Height="11" /></Button></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

          <!-- Active plugin + prompt chips -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,4,12,0">
            <ItemsControl ItemsSource="{Binding Plugins}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Classes="chip" IsVisible="{Binding IsActive}" Command="{Binding $parent[UserControl].DataContext.TogglePluginCommand}" CommandParameter="{Binding}" Margin="0,0,5,4"><StackPanel Orientation="Horizontal" Spacing="6"><controls:HavenIcon IconKey="{Binding IconKey}" Width="13" Height="13" /><TextBlock Text="{Binding DisplayName}" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <ItemsControl ItemsSource="{Binding Prompts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Classes="chip" IsVisible="{Binding IsActive}" Command="{Binding $parent[UserControl].DataContext.TogglePromptCommand}" CommandParameter="{Binding}" Margin="0,0,5,4"><StackPanel Orientation="Horizontal" Spacing="6"><controls:HavenIcon IconKey="{Binding IconKey}" Width="13" Height="13" /><TextBlock Text="{Binding DisplayName}" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>

          <!-- Agent selection bar (blue tint) — choose which agent to use -->
          <Border Grid.Row="4" Background="{DynamicResource HavenBlueSoftBrush}" BorderBrush="#284B72" BorderThickness="0,1" Padding="11,7" IsVisible="{Binding IsAgentPluginActive}"><Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"><TextBlock Text="AGENT" Classes="eyebrow" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}" MinWidth="170"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><controls:HavenIcon IconKey="{Binding IconKey}" Width="16" Height="16" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Grid.Column="2" Text="{Binding AgentNotice}" Classes="muted" FontSize="10" VerticalAlignment="Center" /></Grid></Border>
          <!-- Duo mode bar (purple tint) — select collaboration mode -->
          <Border Grid.Row="5" Background="#19172A" BorderBrush="#403C72" BorderThickness="0,1" Padding="11,7" IsVisible="{Binding IsDuoPluginActive}"><Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"><TextBlock Text="DUO MODE" Classes="eyebrow" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding DuoModes}" SelectedItem="{Binding SelectedDuo}" MinWidth="130" /><TextBlock Grid.Column="2" Text="Ping Pong alternates, Collaborate plans together, Supervise uses one agent to review the other." Classes="muted" FontSize="10" VerticalAlignment="Center" /></Grid></Border>

          <!-- Text input + toolbar row -->
          <Grid Grid.Row="6" RowDefinitions="Auto,Auto">
            <!-- Main text input — multi-line, auto-growing -->
            <TextBox Text="{Binding Composer}" Classes="composerInput" PlaceholderText="Message Haven…  @ plugins  > prompts  / commands" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78" MaxHeight="205" FontSize="14" KeyDown="OnComposerKeyDown" />
            <!-- Toolbar: attach, @, >, temporary, model, effort, context%, stop/send -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="10,4,10,10" ColumnSpacing="7">
              <Button Classes="icon" ToolTip.Tip="Add to this message">
                <controls:HavenIcon IconKey="plus" Width="14" Height="14" />
                <Button.Flyout><MenuFlyout><MenuItem Header="Attach files or images" Click="OnAttachClicked" /><MenuItem Header="Choose plugin (@)" Command="{Binding OpenPluginPickerCommand}" /><MenuItem Header="Prompt Library (>)" Command="{Binding OpenPromptPickerCommand}" /></MenuFlyout></Button.Flyout>
              </Button>
              <Button Grid.Column="1" Classes="icon" Command="{Binding OpenPluginPickerCommand}" ToolTip.Tip="Plugins">
                <controls:HavenIcon IconKey="plugin" Width="15" Height="15" />
              </Button>
              <Button Grid.Column="2" Classes="icon" Command="{Binding OpenPromptPickerCommand}" ToolTip.Tip="Prompt Library">
                <controls:HavenIcon IconKey="prompt" Width="15" Height="15" />
              </Button>
              <Button Grid.Column="3" Content="{Binding TemporaryLabel}" Classes="chrome" Command="{Binding ToggleTemporaryCommand}" HorizontalAlignment="Left" />
              <!-- Model picker button -->
              <Button Grid.Column="4" Classes="ghost" Command="{Binding OpenModelPickerCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding SelectedModel.Name}" MaxWidth="180" TextTrimming="CharacterEllipsis" /><controls:HavenIcon IconKey="chevron-down" Classes="muted" Width="12" Height="12" /></StackPanel></Button>
              <!-- Effort level selector -->
              <ComboBox Grid.Column="5" ItemsSource="{Binding EffortLevels}" SelectedItem="{Binding SelectedEffort}" MinWidth="88" />
              <!-- Context usage %, stop button, send button -->
              <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                <Button Width="42" Height="40" CornerRadius="20" Padding="0" VerticalContentAlignment="Center" ToolTip.Tip="Context usage"><TextBlock Text="{Binding ContextPercent, StringFormat='{}{0}%'}" FontSize="9" HorizontalAlignment="Center" /><Button.Flyout><Flyout><StackPanel Width="250" Spacing="8"><TextBlock Text="Context" FontWeight="SemiBold" /><TextBlock Text="{Binding ContextLabel}" Classes="muted" /><ProgressBar Value="{Binding ContextPercent}" Maximum="100" /><Button Content="Compact now" Command="{Binding CompactContextCommand}" /></StackPanel></Flyout></Button.Flyout></Button>
                <Button VerticalContentAlignment="Center" Content="Stop" Classes="icon,stop" Command="{Binding StopCommand}" IsVisible="{Binding IsSending}" ToolTip.Tip="Stop" />
                <Button VerticalContentAlignment="Center" Content="Send" Classes="send" Command="{Binding SendCommand}" IsVisible="{Binding IsNotSending}" ToolTip.Tip="Send (Ctrl+Enter)" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ============================================================
         MODEL PICKER OVERLAY (full-screen backdrop)
         Search bar + scrollable list of installed Ollama models.
         Each model shows name, family, RAM estimate, parameter size, quantization.
         ============================================================ -->
    <Border Background="#99000000" IsVisible="{Binding IsModelPickerOpen}">
      <Grid><Button Background="Transparent" BorderThickness="0" Command="{Binding CloseModelPickerCommand}" /><Border Background="#E8181E2A" BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1" CornerRadius="16" Width="650" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20"><Grid RowDefinitions="Auto,Auto,*" RowSpacing="10"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7"><StackPanel><TextBlock Text="Choose local model" Classes="sectionHeading" /><TextBlock Text="Search installed Ollama models and inspect their capabilities." Classes="muted" FontSize="10" /></StackPanel><Button Grid.Column="1" Content="Advanced options" Command="{Binding $parent[Window].DataContext.NavigateSettingsCommand}" /><Button Grid.Column="2" Classes="chrome" Command="{Binding CloseModelPickerCommand}" ToolTip.Tip="Close"><controls:HavenIcon IconKey="close" Width="13" Height="13" /></Button></Grid><TextBox Grid.Row="1" Text="{Binding ModelSearch}" PlaceholderText="Search models" /><ScrollViewer Grid.Row="2"><ItemsControl ItemsSource="{Binding FilteredModels}"><ItemsControl.ItemTemplate><DataTemplate><Button Classes="sidebar" HorizontalAlignment="Stretch" Command="{Binding $parent[UserControl].DataContext.SelectModelCommand}" CommandParameter="{Binding}"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Family}" Classes="muted" FontSize="10" /><TextBlock Text="{Binding EstimatedRamLabel}" Foreground="{DynamicResource HavenWarningBrush}" FontSize="9" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding ParameterSize}" Foreground="{DynamicResource HavenBlueBrush}" FontSize="10" HorizontalAlignment="Right" /><TextBlock Text="{Binding Quantization}" Classes="muted2" FontSize="9" HorizontalAlignment="Right" /><TextBlock Text="{Binding SizeLabel}" Classes="muted2" FontSize="9" HorizontalAlignment="Right" /></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border></Grid>
    </Border>
  </Grid>
</UserControl>
