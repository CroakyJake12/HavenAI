<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/ChatView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.ChatView. Its visual vocabulary includes: UserControl.Resources, ResourceDictionary, ResourceDictionary.ThemeDictionaries, SolidColorBrush, Grid, ScrollViewer, StackPanel, Image, TextBlock, ItemsControl, ItemsControl.ItemTemplate, DataTemplate, Border, MarkdownView, MarkdownView.ContextMenu, ContextMenu, MenuItem, Button, ItemsControl.ItemsPanel, ItemsPanelTemplate, WrapPanel, HavenIcon, ProgressBar, ComboBox, ComboBox.ItemTemplate, TextBox, Button.Flyout, MenuFlyout, GenerativeUiSlot.
  Data flow: Binding expressions read or update these view-model paths: IsEmpty, EmptyTitle, ModeSubtitle, Messages, HasMessages, ContentOpacity, Alignment, MaxBubbleWidth, DisplayName, HasModelLabel, ModelLabel, TimeLabel, Content, Activities, HasActivities, Title, Detail, Duration, ChangeLabel, HasChanges, HasConfidence, ConfidenceLabel, ConfidenceWidth, State, HasState, IsPluginPickerOpen, ClosePickersCommand, IsPromptPickerOpen, HasMissingPluginNotice, MissingPluginName, MissingPluginReason, DismissMissingPluginCommand, RetryWithPluginCommand, IsComputerPermissionPending, DismissComputerUseCommand, EnableComputerUseCommand, IsToolPermissionPending, ToolPermissionRequest, DismissToolPermissionCommand, ApproveToolPermissionCommand, HasInlineQuestion, InlineQuestion.Question, InlineQuestion.Options, DismissInlineQuestionCommand, IsEditProgressVisible, EditProgressLabel, PluginSuggestions, IsVisibleInPicker, IconKey, Description, AllowedModesLabel, PromptSuggestions, Attachments, KindLabel, Name, Plugins, IsActive, Prompts, IsAgentPluginActive, Agents, SelectedAgent, AgentNotice, IsDuoPluginActive, DuoModes, SelectedDuo, Composer, OpenPluginPickerCommand, OpenPromptPickerCommand, StopCommand, IsSending, SendCommand, IsNotSending.
  Interaction: Direct event handlers in this file are: OnCopyMessageClicked, OnComposerKeyDown, OnAttachClicked.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.ChatView">

  <!-- Section: Defines reusable theme resources here so descendant controls resolve consistent values at runtime. -->
  <UserControl.Resources>
    <!-- Section: Defines reusable theme resources here so descendant controls resolve consistent values at runtime. -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PopupTintBrush" Color="#751f1f1c" />
          <SolidColorBrush x:Key="PopupBorderBrush" Color="#ffffff00" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PopupTintBrush" Color="#E6F3F5F7" />
          <SolidColorBrush x:Key="PopupBorderBrush" Color="#30000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- Chat View — the main conversation interface with messages and one unified composer model switcher. -->
  <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
  <Grid>
    <!-- Empty state (shown when no messages) -->
    <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="1020" Margin="30,93,30,235" Spacing="12">
      <Image Source="/Assets/haven-192.png" Width="62" Height="62" />
      <TextBlock Text="{Binding EmptyTitle}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding ModeSubtitle}" Classes="muted" TextAlignment="Center" />
    </StackPanel>

    <!-- Messages (virtualized) -->
    <hui:HavenListBox ItemsSource="{Binding Messages}" IsVisible="{Binding HasMessages}"
             Margin="30,28,30,235" BorderThickness="0" Background="Transparent">
      <hui:HavenListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="38,*" ColumnSpacing="13" Margin="0,0,0,28" Opacity="{Binding ContentOpacity}">
            <hui:HavenAdaptiveSurface Classes="avatar" Width="36" Height="36"><Image Source="/Assets/haven-32.png" Width="36" Height="36" /></hui:HavenAdaptiveSurface>
            <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="{Binding Alignment}" MaxWidth="{Binding MaxBubbleWidth}">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="7"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><hui:HavenAdaptiveSurface Grid.Column="1" Background="{DynamicResource HavenBlueSoftBrush}" CornerRadius="999" Padding="7,2" IsVisible="{Binding HasModelLabel}"><TextBlock Text="{Binding ModelLabel}" Foreground="{DynamicResource HavenAccentSecondaryBrush}" FontSize="9" /></hui:HavenAdaptiveSurface><hui:HavenButton Grid.Column="3" Classes="chrome" Click="OnMessageActionsClicked" ToolTip.Tip="Message actions" Padding="5,2"><controls:HavenIcon IconKey="more" Width="13" Height="13" /></hui:HavenButton><TextBlock Grid.Column="4" Text="{Binding TimeLabel}" Classes="muted2" FontSize="10" VerticalAlignment="Center" /></Grid>
              <hui:HavenAdaptiveSurface Background="{Binding BubbleBackground}" BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1" CornerRadius="{Binding BubbleCornerRadius}" Padding="15,12">
                <controls:MarkdownView Markdown="{Binding Content}"><controls:MarkdownView.ContextMenu><hui:HavenContextMenu><hui:HavenMenuItem Header="Copy message" Click="OnCopyMessageClicked" /><hui:HavenMenuItem Header="Message actions..." Click="OnMessageActionsMenuClicked" /></hui:HavenContextMenu></controls:MarkdownView.ContextMenu></controls:MarkdownView>
              </hui:HavenAdaptiveSurface>
              <ItemsControl ItemsSource="{Binding Activities}" IsVisible="{Binding HasActivities}">
                <ItemsControl.ItemTemplate><DataTemplate><hui:HavenAdaptiveSurface Background="{DynamicResource HavenPanel2Brush}" BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,2"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><StackPanel Spacing="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" /><TextBlock Text="{Binding Detail}" Classes="muted" FontFamily="Cascadia Code, Consolas" FontSize="9" MaxLines="4" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Duration}" Classes="muted2" FontSize="9" HorizontalAlignment="Right" /><TextBlock Text="{Binding ChangeLabel}" Foreground="{DynamicResource HavenAccentBrush}" FontSize="9" IsVisible="{Binding HasChanges}" /></StackPanel></Grid></hui:HavenAdaptiveSurface></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasConfidence}" ColumnSpacing="7"><TextBlock Text="{Binding ConfidenceLabel}" Classes="muted2" FontSize="9" /><hui:HavenAdaptiveSurface Grid.Column="1" Height="3" Width="160" Background="{DynamicResource HavenPanel3Brush}" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"><hui:HavenAdaptiveSurface Width="{Binding ConfidenceWidth}" Background="{DynamicResource HavenAccentBrush}" CornerRadius="2" HorizontalAlignment="Left" /></hui:HavenAdaptiveSurface></Grid>
              <TextBlock Text="{Binding ConfidenceAdvice}" IsVisible="{Binding HasConfidenceAdvice}" Foreground="#F5A623" FontSize="9" TextWrapping="Wrap" />
              <TextBlock Text="{Binding State}" Classes="muted2" FontSize="10" IsVisible="{Binding HasState}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </hui:HavenListBox.ItemTemplate>
    </hui:HavenListBox>

    <!-- Section: Exposes an explicit user action through a command or event handler. -->
    <hui:HavenButton Classes="popupDismissLayer" Background="Transparent" BorderThickness="0" IsVisible="{Binding IsPluginPickerOpen}" Command="{Binding ClosePickersCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    <!-- Section: Exposes an explicit user action through a command or event handler. -->
    <hui:HavenButton Classes="popupDismissLayer" Background="Transparent" BorderThickness="0" IsVisible="{Binding IsPromptPickerOpen}" Command="{Binding ClosePickersCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
    <Grid Margin="24,0,24,14" MaxWidth="920" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
      <hui:HavenAdaptiveSurface Classes="permission" BorderBrush="#D94A4A" Margin="0,0,0,8" IsVisible="{Binding IsOllamaOfflineWarningVisible}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
          <controls:HavenIcon IconKey="warning" Width="18" Height="18" Foreground="#FF6B6B" />
          <TextBlock Grid.Column="1" Text="Ollama not connected - connect to your installation of Ollama to use this local model." Foreground="#FF6B6B" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Grid.Row="1" Classes="permission" Margin="0,0,0,8" IsVisible="{Binding HasMissingPluginNotice}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="{Binding MissingPluginName, StringFormat='Missing capability: @{0}'}" FontWeight="SemiBold" /><TextBlock Text="{Binding MissingPluginReason}" Classes="muted" FontSize="10" /></StackPanel><hui:HavenButton Grid.Column="1" Content="Dismiss" Command="{Binding DismissMissingPluginCommand}" /><hui:HavenButton Grid.Column="2" Content="Enable and retry" Classes="accent" Command="{Binding RetryWithPluginCommand}" /></Grid>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Grid.Row="2" Classes="permission" Margin="0,0,0,8" IsVisible="{Binding IsComputerPermissionPending}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9"><hui:HavenAdaptiveSurface Width="36" Height="36" CornerRadius="10" Background="{DynamicResource HavenAccentSoftBrush}"><TextBlock Text="▣" Foreground="{DynamicResource HavenAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></hui:HavenAdaptiveSurface><StackPanel Grid.Column="1"><TextBlock Text="Enable Computer Use" FontWeight="SemiBold" /><TextBlock Text="Target-bound Windows controls for this pass, with inspection and action limits." Classes="muted" FontSize="10" /></StackPanel><hui:HavenButton Grid.Column="2" Content="Remove" Command="{Binding DismissComputerUseCommand}" /><hui:HavenButton Grid.Column="3" Content="Enable for this pass" Classes="accent" Command="{Binding EnableComputerUseCommand}" /></Grid>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Grid.Row="3" Classes="permission" Margin="0,0,0,8" IsVisible="{Binding IsToolPermissionPending}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="Tool permission" FontWeight="SemiBold" /><TextBlock Text="{Binding ToolPermissionRequest}" Classes="muted" FontSize="10" /></StackPanel><hui:HavenButton Grid.Column="1" Content="Deny" Command="{Binding DismissToolPermissionCommand}" /><hui:HavenButton Grid.Column="2" Content="Allow once" Classes="accent" Command="{Binding ApproveToolPermissionCommand}" /></Grid>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Grid.Row="4" Classes="card" Margin="0,0,0,8" IsVisible="{Binding HasInlineQuestion}" Padding="12">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Text="{Binding InlineQuestion.Question}" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding InlineQuestion.Options}"><ItemsControl.ItemTemplate><DataTemplate><hui:HavenButton Content="{Binding}" Classes="chip" Margin="0,0,6,4" Command="{Binding $parent[UserControl].DataContext.AnswerInlineQuestionCommand}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><hui:HavenButton Grid.Column="1" Classes="chrome" Command="{Binding DismissInlineQuestionCommand}" ToolTip.Tip="Dismiss"><controls:HavenIcon IconKey="close" Width="13" Height="13" /></hui:HavenButton></Grid>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Grid.Row="5" Classes="card" Padding="10" Margin="0,0,0,8" IsVisible="{Binding IsEditProgressVisible}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"><TextBlock Text="Editing" Foreground="{DynamicResource HavenAccentBrush}" FontWeight="SemiBold" /><hui:HavenProgressBar Grid.Column="1" IsIndeterminate="True" Height="4" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding EditProgressLabel}" Classes="muted" FontSize="10" /></Grid>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Grid.Row="6" Classes="composer" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <hui:HavenAdaptiveSurface Background="{DynamicResource PopupTintBrush}" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="10" IsVisible="{Binding IsPluginPickerOpen}" CornerRadius="12">
            <StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="CAPABILITIES" Classes="eyebrow" /><hui:HavenButton Grid.Column="1" Classes="chrome" Command="{Binding ClosePickersCommand}" ToolTip.Tip="Close"><controls:HavenIcon IconKey="close" Width="13" Height="13" /></hui:HavenButton></Grid><ItemsControl ItemsSource="{Binding PluginSuggestions}"><ItemsControl.ItemTemplate><DataTemplate><hui:HavenButton Classes="sidebar" HorizontalAlignment="Stretch" IsVisible="{Binding IsVisibleInPicker}" Command="{Binding $parent[UserControl].DataContext.SelectPluginCommand}" CommandParameter="{Binding}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"><controls:HavenIcon IconKey="{Binding IconKey}" Width="18" Height="18" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding AllowedModesLabel}" Classes="muted2" FontSize="9" /></Grid></hui:HavenButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          </hui:HavenAdaptiveSurface>
          <hui:HavenAdaptiveSurface Grid.Row="1" Background="{DynamicResource HavenPanel3Brush}" BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="0,0,0,1" Padding="10" IsVisible="{Binding IsPromptPickerOpen}">
            <StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="INSTRUCTION LIBRARY" Classes="eyebrow" /><hui:HavenButton Grid.Column="1" Classes="chrome" Command="{Binding ClosePickersCommand}" ToolTip.Tip="Close"><controls:HavenIcon IconKey="close" Width="13" Height="13" /></hui:HavenButton></Grid><ItemsControl ItemsSource="{Binding PromptSuggestions}"><ItemsControl.ItemTemplate><DataTemplate><hui:HavenButton Classes="sidebar" HorizontalAlignment="Stretch" IsVisible="{Binding IsVisibleInPicker}" Command="{Binding $parent[UserControl].DataContext.SelectPromptCommand}" CommandParameter="{Binding}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"><controls:HavenIcon IconKey="{Binding IconKey}" Width="18" Height="18" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding AllowedModesLabel}" Classes="muted2" FontSize="9" /></Grid></hui:HavenButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          </hui:HavenAdaptiveSurface>

          <ItemsControl Grid.Row="2" ItemsSource="{Binding Attachments}" Margin="12,8,12,0"><ItemsControl.ItemTemplate><DataTemplate><hui:HavenAdaptiveSurface Background="{DynamicResource HavenPanel3Brush}" CornerRadius="9" Padding="8,5" Margin="0,0,6,5"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource HavenAccentSecondaryBrush}" FontSize="9" /><TextBlock Text="{Binding Name}" FontSize="10" MaxWidth="190" TextTrimming="CharacterEllipsis" /><hui:HavenButton Classes="chrome" Command="{Binding $parent[UserControl].DataContext.RemoveAttachmentCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove attachment"><controls:HavenIcon IconKey="close" Width="11" Height="11" /></hui:HavenButton></StackPanel></hui:HavenAdaptiveSurface></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,4,12,0">
            <ItemsControl ItemsSource="{Binding Plugins}"><ItemsControl.ItemTemplate><DataTemplate><hui:HavenButton Classes="chip" IsVisible="{Binding IsActive}" Command="{Binding $parent[UserControl].DataContext.TogglePluginCommand}" CommandParameter="{Binding}" Margin="0,0,5,4"><StackPanel Orientation="Horizontal" Spacing="6"><controls:HavenIcon IconKey="{Binding IconKey}" Width="13" Height="13" /><TextBlock Text="{Binding DisplayName}" /></StackPanel></hui:HavenButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <ItemsControl ItemsSource="{Binding Prompts}"><ItemsControl.ItemTemplate><DataTemplate><hui:HavenButton Classes="chip" IsVisible="{Binding IsActive}" Command="{Binding $parent[UserControl].DataContext.TogglePromptCommand}" CommandParameter="{Binding}" Margin="0,0,5,4"><StackPanel Orientation="Horizontal" Spacing="6"><controls:HavenIcon IconKey="{Binding IconKey}" Width="13" Height="13" /><TextBlock Text="{Binding DisplayName}" /></StackPanel></hui:HavenButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>

          <hui:HavenAdaptiveSurface Grid.Row="4" Background="{DynamicResource HavenBlueSoftBrush}" BorderBrush="#284B72" BorderThickness="0,1" Padding="11,7" IsVisible="{Binding IsAgentPluginActive}"><Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"><TextBlock Text="AGENT" Classes="eyebrow" VerticalAlignment="Center" /><hui:HavenComboBox Grid.Column="1" ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}" MinWidth="170"><hui:HavenComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><controls:HavenIcon IconKey="{Binding IconKey}" Width="16" Height="16" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></hui:HavenComboBox.ItemTemplate></hui:HavenComboBox><TextBlock Grid.Column="2" Text="{Binding AgentNotice}" Classes="muted" FontSize="10" VerticalAlignment="Center" /></Grid></hui:HavenAdaptiveSurface>
          <hui:HavenAdaptiveSurface Grid.Row="5" Background="#19172A" BorderBrush="#403C72" BorderThickness="0,1" Padding="11,7" IsVisible="{Binding IsDuoPluginActive}"><Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"><TextBlock Text="DUO MODE" Classes="eyebrow" VerticalAlignment="Center" /><hui:HavenComboBox Grid.Column="1" ItemsSource="{Binding DuoModes}" SelectedItem="{Binding SelectedDuo}" MinWidth="130" /><TextBlock Grid.Column="2" Text="Ping Pong alternates, Collaborate plans together, Supervise uses one agent to review the other." Classes="muted" FontSize="10" VerticalAlignment="Center" /></Grid></hui:HavenAdaptiveSurface>

          <Grid Grid.Row="6" RowDefinitions="Auto,Auto">
            <hui:HavenTextInput Text="{Binding Composer}" Classes="composerInput" PlaceholderText="Message Haven…  @ capabilities  > instructions  / commands" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78" MaxHeight="205" FontSize="14" KeyDown="OnComposerKeyDown" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="10,4,10,10" ColumnSpacing="7">
              <hui:HavenButton Classes="icon" ToolTip.Tip="Add to this message">
                <controls:HavenIcon IconKey="plus" Width="14" Height="14" />
                <hui:HavenButton.Flyout><hui:HavenMenuFlyout><hui:HavenMenuItem Header="Attach files or images" Click="OnAttachClicked" /><hui:HavenMenuItem Header="Choose capability (@)" Command="{Binding OpenPluginPickerCommand}" />                        <hui:HavenMenuItem Header="Instruction Library (>)" Command="{Binding OpenPromptPickerCommand}" /></hui:HavenMenuFlyout></hui:HavenButton.Flyout>
              </hui:HavenButton>
              <hui:HavenButton Grid.Column="1" Classes="icon" Command="{Binding OpenPluginPickerCommand}" ToolTip.Tip="Capabilities"><controls:HavenIcon IconKey="plugin" Width="15" Height="15" /></hui:HavenButton>
              <hui:HavenButton Grid.Column="2" Classes="icon" Command="{Binding OpenPromptPickerCommand}" ToolTip.Tip="Instruction Library"><controls:HavenIcon IconKey="prompt" Width="15" Height="15" /></hui:HavenButton>
              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <hui:HavenButton VerticalContentAlignment="Center" Content="Stop" Classes="icon,stop" Command="{Binding StopCommand}" IsVisible="{Binding IsSending}" ToolTip.Tip="Stop" />
                <hui:HavenButton VerticalContentAlignment="Center" Content="Send" Classes="send" Command="{Binding SendCommand}" IsVisible="{Binding IsNotSending}" ToolTip.Tip="Send (Ctrl+Enter)" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </hui:HavenAdaptiveSurface>
    </Grid>
  </Grid>
</UserControl>
