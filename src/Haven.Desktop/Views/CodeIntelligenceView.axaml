<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             x:Class="Haven.Desktop.Views.CodeIntelligenceView">
  <hui:HavenAdaptiveSurface Background="{DynamicResource HavenPanel2Brush}"
          BorderBrush="{DynamicResource HavenLineBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="12">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel>
          <TextBlock Text="CODE INTELLIGENCE" Classes="eyebrow" />
          <TextBlock Text="LSP diagnostics, project symbols, and reviewed transaction-backed formatting" FontWeight="SemiBold" />
          <TextBlock Text="Language-server commands come only from trusted Haven settings, never from project files." Classes="muted" FontSize="9" />
        </StackPanel>
        <hui:HavenProgressBar x:Name="BusyIndicator" Grid.Column="1" Width="72" Height="4" IsIndeterminate="True" IsVisible="False" VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="2*,Auto,Auto" ColumnSpacing="7">
        <hui:HavenTextInput x:Name="RelativePathBox" PlaceholderText="Workspace-relative file, e.g. src/App.cs" />
        <hui:HavenButton x:Name="InspectButton" Grid.Column="1" Content="Inspect" />
        <hui:HavenButton x:Name="DiagnosticsButton" Grid.Column="2" Content="Diagnostics" Classes="accent" />
      </Grid>
      <TextBlock x:Name="ServerStatusText" Classes="muted2" FontSize="9" />

      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
        <hui:HavenTextInput x:Name="SymbolQueryBox" PlaceholderText="Search project symbols" />
        <hui:HavenButton x:Name="SearchSymbolsButton" Grid.Column="1" Content="Find symbols" />
        <hui:HavenButton x:Name="InsertSymbolsButton" Grid.Column="2" Content="Insert results" />
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel Spacing="5">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBlock Text="DIAGNOSTICS" Classes="eyebrow" />
            <hui:HavenButton x:Name="InsertDiagnosticsButton" Grid.Column="1" Content="Insert into composer" FontSize="9" Padding="7,3" />
          </Grid>
          <ItemsControl x:Name="DiagnosticsList" MaxHeight="180">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <hui:HavenAdaptiveSurface Background="{DynamicResource HavenPanel3Brush}" CornerRadius="8" Padding="8" Margin="0,2">
                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding SeverityLabel}" Foreground="{DynamicResource HavenAccentSecondaryBrush}" FontWeight="SemiBold" FontSize="9" />
                      <TextBlock Grid.Column="1" Text="{Binding Location}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="muted2" FontSize="9" />
                    </Grid>
                    <TextBlock Text="{Binding CodeLabel}" Classes="muted2" FontSize="9" />
                    <TextBlock Text="{Binding Message}" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                </hui:HavenAdaptiveSurface>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="5">
          <TextBlock Text="SYMBOLS" Classes="eyebrow" />
          <ItemsControl x:Name="SymbolsList" MaxHeight="180">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <hui:HavenAdaptiveSurface Background="{DynamicResource HavenPanel3Brush}" CornerRadius="8" Padding="8" Margin="0,2">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource HavenAccentSecondaryBrush}" FontSize="9" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Location}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="muted2" FontSize="9" VerticalAlignment="Center" />
                  </Grid>
                </hui:HavenAdaptiveSurface>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <Separator />

      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="7">
        <hui:HavenNumericInput x:Name="TabSizeBox" Minimum="1" Maximum="16" Increment="1" Width="76" />
        <hui:HavenCheckBox x:Name="InsertSpacesCheckBox" Grid.Column="1" Content="Insert spaces" VerticalAlignment="Center" />
        <hui:HavenButton x:Name="PreviewFormatButton" Grid.Column="2" Content="Preview formatting" />
        <TextBlock x:Name="FormatterText" Grid.Column="3" Classes="muted" VerticalAlignment="Center" />
        <hui:HavenButton x:Name="ApplyFormatButton" Grid.Column="4" Content="Apply reviewed diff" Classes="accent" />
      </Grid>
      <hui:HavenTextInput x:Name="FormatDiffBox"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Cascadia Mono, Consolas, monospace"
               FontSize="10"
               MinHeight="70"
               MaxHeight="260"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               IsVisible="False" />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock x:Name="StatusText" Classes="muted" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
        <hui:HavenButton x:Name="ClearButton" Grid.Column="1" Content="Clear" />
      </Grid>
    </StackPanel>
  </hui:HavenAdaptiveSurface>
</UserControl>
