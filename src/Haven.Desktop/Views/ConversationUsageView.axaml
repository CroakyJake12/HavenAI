<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/ConversationUsageView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.ConversationUsageView. Its visual vocabulary includes: Border, Grid, StackPanel, TextBlock, Button, ProgressBar.
  Data flow: Binding expressions read or update these view-model paths: TokenSummary, MeasurementSummary, CostSummary, Status, RefreshCommand, IsBusy.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             x:Class="Haven.Desktop.Views.ConversationUsageView">
  <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
  <hui:HavenAdaptiveSurface Background="{DynamicResource HavenPanel2Brush}"
          BorderBrush="{DynamicResource HavenLineBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="12">
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <StackPanel Spacing="4">
        <TextBlock Text="USAGE AND CONFIGURED COST" Classes="eyebrow" />
        <TextBlock Text="{Binding TokenSummary}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding MeasurementSummary}" Classes="muted" FontSize="10" />
        <TextBlock Text="{Binding CostSummary}" Classes="muted" FontSize="10" />
        <TextBlock Text="{Binding Status}" Classes="muted2" FontSize="9" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
        <hui:HavenButton Content="Refresh usage" Command="{Binding RefreshCommand}" />
        <hui:HavenProgressBar Width="70" Height="4" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Grid>
  </hui:HavenAdaptiveSurface>
</UserControl>
