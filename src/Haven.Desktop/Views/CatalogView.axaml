<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.CatalogView">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="30,25">

    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
      <StackPanel>
        <TextBlock x:Name="TitleText" Classes="heading" />
        <TextBlock x:Name="SubtitleText" Classes="muted" Margin="0,4,0,0" />
      </StackPanel>
      <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Classes="chrome" Margin="0,0,8,0" />
      <Button x:Name="UploadPluginButton" Grid.Column="2" Content="Upload plugin" Click="OnUploadPluginClicked" Margin="0,0,8,0" />
      <Button x:Name="CreateButton" Grid.Column="3" Classes="accent" />
    </Grid>

    <Border x:Name="CreatePanel" Grid.Row="1" Classes="card" Margin="0,20,0,12" IsVisible="False">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10" ColumnSpacing="10">
        <Grid ColumnDefinitions="*,Auto" Grid.ColumnSpan="2">
          <TextBlock x:Name="BuilderTitle" Classes="eyebrow" VerticalAlignment="Center" />
          <Button x:Name="CloseCreateButton" Grid.Column="1" Classes="icon" ToolTip.Tip="Close creator">
            <controls:HavenIcon IconKey="close" Width="14" Height="14" />
          </Button>
        </Grid>
        <TextBox x:Name="BuilderPromptBox" Grid.Row="1" MinHeight="38" />
        <Button x:Name="BuildWithAiButton" Grid.Row="1" Grid.Column="1" Content="Build with AI" />
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="1*,1.5*" ColumnSpacing="10">
          <TextBox x:Name="NewNameBox" PlaceholderText="Name" />
          <TextBox x:Name="NewDescriptionBox" Grid.Column="1" PlaceholderText="Short description" />
        </Grid>
        <TextBox x:Name="NewInstructionsBox" Grid.Row="3" Grid.ColumnSpan="2"
                 PlaceholderText="Instructions" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="105" MaxHeight="230" />
        <StackPanel x:Name="AgentOptionsPanel" Grid.Row="4" Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Preferred model" Classes="muted" VerticalAlignment="Center" />
          <TextBox x:Name="NewModelBox" PlaceholderText="Use current model" Width="230" />
        </StackPanel>
        <CheckBox x:Name="PersistCheckBox" Grid.Row="4" Content="Keep active between messages" VerticalAlignment="Center" />
        <Button x:Name="FinalCreateButton" Grid.Row="4" Grid.Column="1" Classes="accent" MinWidth="120" />
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="2" Classes="muted" FontSize="11" Margin="2,2,0,12" />

    <ScrollViewer Grid.Row="3">
      <ItemsControl x:Name="CatalogItemsList">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="340" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Width="324" MinHeight="150" Margin="0,0,14,14">
              <Grid RowDefinitions="Auto,*,Auto,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource HavenAccentSoftBrush}">
                    <controls:HavenIcon IconKey="{Binding IconKey}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Background="{DynamicResource HavenAccentSoftBrush}" CornerRadius="999" Padding="8,3">
                    <TextBlock Text="LOCAL" Foreground="{DynamicResource HavenAccentBrush}" FontSize="9" FontWeight="Bold" />
                  </Border>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Description}" Classes="muted" Margin="0,10" />
                <TextBlock Grid.Row="2" Text="{Binding Meta}" Foreground="{DynamicResource HavenAccentSecondaryBrush}" FontSize="11" />
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,9,0,0">
                  <Button Content="Duplicate agent" IsVisible="{Binding CanDuplicate}" />
                  <Button Grid.Column="1" Content="Delete" Classes="danger" IsVisible="{Binding CanDelete}" />
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
