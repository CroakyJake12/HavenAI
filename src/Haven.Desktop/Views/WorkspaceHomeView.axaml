<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/WorkspaceHomeView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.WorkspaceHomeView. Its visual vocabulary includes: ScrollViewer, StackPanel, Grid, TextBlock, Button, Border, ItemsControl, ItemsControl.ItemsPanel, ItemsPanelTemplate, WrapPanel, ItemsControl.ItemTemplate, DataTemplate.
  Data flow: Binding expressions read or update these view-model paths: Title, Subtitle, RefreshCommand, CreateLabel, CreateBlankCommand, CollectionHeading, Items, Name, Accent, Path, LastTask, Branch, WorkState, RecommendedAction, ActiveAutomations, NextRun, ReusableTasks, Description, Status.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             x:Class="Haven.Desktop.Views.WorkspaceHomeView">
  <!-- Workspace Home — project listing dashboard with cards, automations, and macros -->
  <!-- Section: Keeps the region usable when content exceeds the available window size. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
    <StackPanel MaxWidth="1120" Margin="34,30" Spacing="22">

      <!-- ============================================================
           ROW 0: HEADER
           Page title + subtitle (left), Refresh + Create buttons (right)
           ============================================================ -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Classes="heading" />
          <TextBlock Text="{Binding Subtitle}" Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <hui:HavenButton Grid.Column="1" Content="Refresh" Classes="ghost" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        <hui:HavenButton Grid.Column="2" Content="{Binding CreateLabel}" Classes="accent" Command="{Binding CreateBlankCommand}" VerticalAlignment="Center" />
      </Grid>

      <!-- ============================================================
           ROW 1: WORKSPACE CARDS
           Section heading + empty state message + scrollable wrap panel of workspace cards.
           Each card shows: name, accent badge, path, last task, branch/state pills,
           recommended action, Open + Archive buttons.
           ============================================================ -->
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding CollectionHeading}" Classes="sectionHeading" />
        <!-- Empty state: shown when no workspaces exist -->
        <hui:HavenAdaptiveSurface Classes="card" IsVisible="{Binding !HasItems}">
          <TextBlock Text="No workspaces yet. Create one, then connect its folder from settings." Classes="muted" />
        </hui:HavenAdaptiveSurface>
        <!-- Workspace cards — wrap panel, 340px each -->
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="340" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <hui:HavenAdaptiveSurface Classes="card" Width="330" Margin="0,0,12,12">
                <StackPanel Spacing="9">
                  <!-- Name + accent badge -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Accent}" Classes="eyebrow" />
                  </Grid>
                  <!-- File path -->
                  <TextBlock Text="{Binding Path}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <!-- Last task summary -->
                  <TextBlock Text="{Binding LastTask}" Classes="soft" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  <!-- Branch + Work State pills -->
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <hui:HavenAdaptiveSurface Background="{DynamicResource HavenPanel2Brush}" CornerRadius="9" Padding="9">
                      <StackPanel><TextBlock Text="BRANCH" Classes="eyebrow" /><TextBlock Text="{Binding Branch}" FontSize="11" /></StackPanel>
                    </hui:HavenAdaptiveSurface>
                    <hui:HavenAdaptiveSurface Grid.Column="1" Background="{DynamicResource HavenPanel2Brush}" CornerRadius="9" Padding="9">
                      <StackPanel><TextBlock Text="STATE" Classes="eyebrow" /><TextBlock Text="{Binding WorkState}" FontSize="11" /></StackPanel>
                    </hui:HavenAdaptiveSurface>
                  </Grid>
                  <!-- Recommended next action -->
                  <TextBlock Text="{Binding RecommendedAction}" Classes="muted" FontSize="11" />
                  <!-- Open + Archive buttons -->
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                    <hui:HavenButton Content="Open" Classes="accent" HorizontalContentAlignment="Center"
                            Command="{Binding $parent[UserControl].DataContext.OpenCommand}" CommandParameter="{Binding}" />
                    <hui:HavenButton Grid.Column="1" Content="Archive" Classes="ghost"
                            Command="{Binding $parent[UserControl].DataContext.ArchiveCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </StackPanel>
              </hui:HavenAdaptiveSurface>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- ============================================================
           ROW 2: TWO-COLUMN — Automations | Reusable Workflows
           Left: active automations for this workspace
           Right: reusable tasks available to run
           ============================================================ -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <!-- Automations card -->
        <hui:HavenAdaptiveSurface Classes="card">
          <StackPanel Spacing="9">
            <TextBlock Text="Active Automations" Classes="sectionHeading" />
            <TextBlock Text="Nothing scheduled for this workspace." Classes="muted" IsVisible="{Binding !HasAutomations}" />
            <ItemsControl ItemsSource="{Binding ActiveAutomations}">
              <ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,4"><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding NextRun}" Classes="muted" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </hui:HavenAdaptiveSurface>
        <!-- Reusable Tasks card -->
        <hui:HavenAdaptiveSurface Grid.Column="1" Classes="card">
          <StackPanel Spacing="9">
            <TextBlock Text="Reusable Tasks" Classes="sectionHeading" />
            <TextBlock Text="No reusable tasks are shared with this workspace." Classes="muted" IsVisible="{Binding !HasReusableTasks}" />
            <ItemsControl ItemsSource="{Binding ReusableTasks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </hui:HavenAdaptiveSurface>
      </Grid>
      <!-- Status message -->
      <TextBlock Text="{Binding Status}" Classes="muted" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
