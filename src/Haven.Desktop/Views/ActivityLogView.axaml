<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             x:Class="Haven.Desktop.Views.ActivityLogView">

  <UserControl.Styles>
    <Style Selector="TextBlock.section-header">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </UserControl.Styles>

  <hui:HavenAdaptiveSurface Padding="20">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
        <TextBlock Text="Activity Log" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        <hui:HavenButton x:Name="RefreshButton" Content="Refresh"
                Background="{DynamicResource HavenAccentBrush}" Foreground="White" Padding="12,5"/>
      </StackPanel>

      <hui:HavenTextInput x:Name="SearchBox" Grid.Row="1"
               PlaceholderText="Search conversations…"
               Margin="0,0,0,12"/>

      <hui:HavenAdaptiveSurface Grid.Row="2" Background="{DynamicResource HavenPanel2Brush}" CornerRadius="8" Padding="8">
          <hui:HavenListBox x:Name="ConversationList" BorderThickness="0" Background="Transparent">
            <hui:HavenListBox.ItemTemplate>
              <DataTemplate>
                <hui:HavenButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="10,8" Margin="0,0,0,2">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                               MaxLines="1" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <hui:HavenAdaptiveSurface Background="{DynamicResource HavenLineBrush}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding Mode}" FontSize="10" Opacity="0.7"/>
                      </hui:HavenAdaptiveSurface>
                      <TextBlock Text="{Binding MessageCount, StringFormat='{}{0} msgs'}"
                                 FontSize="10" Opacity="0.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LastMessagePreview}"
                               FontSize="11" Opacity="0.6" MaxLines="2" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{Binding UpdatedAt, StringFormat='{}{0:MMM dd, HH:mm}'}"
                               FontSize="10" Opacity="0.4" Margin="0,2,0,0"/>
                  </Grid>
                </hui:HavenButton>
              </DataTemplate>
            </hui:HavenListBox.ItemTemplate>
          </hui:HavenListBox>
      </hui:HavenAdaptiveSurface>

      <hui:HavenAdaptiveSurface Grid.Row="3" Background="{DynamicResource HavenPanel2Brush}"
              CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
        <TextBlock x:Name="StatusMessage" Opacity="0.7"/>
      </hui:HavenAdaptiveSurface>
    </Grid>
  </hui:HavenAdaptiveSurface>
</UserControl>
