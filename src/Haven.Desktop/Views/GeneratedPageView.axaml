<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/GeneratedPageView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.GeneratedPageView. Its visual vocabulary includes: ScrollViewer, StackPanel, TextBlock, ItemsControl, ItemsControl.ItemTemplate, DataTemplate, Border, ItemsControl.ItemsPanel, ItemsPanelTemplate, WrapPanel, Button, Grid, HavenIcon, ProgressBar.
  Data flow: Binding expressions read or update these view-model paths: Title, Description, Widgets, IsText, Text, IsShortcutGrid, Shortcuts, InvokeCommand, IconKey, IsTimer, TimeLabel, TimerProgress, TimerActionLabel, ToggleTimerCommand, ResetTimerCommand, IsTimerComplete, IsCommandButton, CommandButtonLabel, IsDivider.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.GeneratedPageView">
  <!-- Section: Keeps the region usable when content exceeds the available window size. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
    <StackPanel Margin="34,30" Spacing="16" MaxWidth="1080">
      <StackPanel Spacing="5">
        <TextBlock Text="GENERATIVE UI PAGE" Classes="eyebrow" />
        <TextBlock Text="{Binding Title}" Classes="heading" />
        <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Widgets}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="8" Margin="0,0,0,10">
              <Border Classes="card" IsVisible="{Binding IsText}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Title}" Classes="sectionHeading" />
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="card" IsVisible="{Binding IsShortcutGrid}">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding Title}" Classes="sectionHeading" />
                  <ItemsControl ItemsSource="{Binding Shortcuts}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Width="250" MinHeight="92" Margin="0,0,9,9" Padding="13"
                                Command="{Binding InvokeCommand}" HorizontalContentAlignment="Stretch">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource HavenAccentSoftBrush}">
                              <controls:HavenIcon IconKey="{Binding IconKey}" Width="19" Height="19"
                                                  Foreground="{DynamicResource HavenAccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextWrapping="Wrap" MaxLines="2" />
                            </StackPanel>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="card" IsVisible="{Binding IsTimer}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Classes="sectionHeading" />
                      <TextBlock Text="{Binding Text}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </Grid>
                  <ProgressBar Value="{Binding TimerProgress}" Maximum="100" Height="7" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding TimerActionLabel}" Classes="accent" Command="{Binding ToggleTimerCommand}" />
                    <Button Content="Reset" Command="{Binding ResetTimerCommand}" />
                    <TextBlock Text="Complete" Foreground="{DynamicResource HavenAccentBrush}" FontWeight="SemiBold"
                               IsVisible="{Binding IsTimerComplete}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card" IsVisible="{Binding IsCommandButton}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Classes="sectionHeading" />
                    <TextBlock Text="{Binding Text}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{Binding CommandButtonLabel}" Classes="accent" Command="{Binding InvokeCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Height="1" Background="{DynamicResource HavenLineStrongBrush}" IsVisible="{Binding IsDivider}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
