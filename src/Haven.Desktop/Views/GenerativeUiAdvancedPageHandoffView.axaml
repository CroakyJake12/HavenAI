<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Haven.Desktop.Views.GenerativeUiAdvancedPageHandoffView">
  <Border Classes="card">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel>
          <TextBlock Text="ADVANCED GENERATED PAGE" Classes="eyebrow" />
          <TextBlock Text="Build with Haven Studio" Classes="sectionHeading" Margin="0,4,0,0" />
          <TextBlock Text="Theme Studio directly supports safe text, shortcuts, command buttons and local timers. Describe a richer page here to hand it into a fresh Studio chat using Haven's normal reviewed implementation flow."
                     Classes="muted" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource HavenAccentSoftBrush}" CornerRadius="999" Padding="9,4" VerticalAlignment="Top">
          <TextBlock Text="REVIEWED HANDOFF" Foreground="{DynamicResource HavenAccentBrush}" FontSize="8" FontWeight="SemiBold" />
        </Border>
      </Grid>

      <TextBox x:Name="RequestBox"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="92"
               PlaceholderText="Example: Create a study dashboard page with a timetable, subject shortcuts, progress cards and a focus-session history. Reuse Plan and Teach data rather than copying it." />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
        <TextBlock x:Name="StatusText"
                   Text="Nothing is created or installed automatically. The complete specification opens in Studio for review."
                   Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Content="Open reviewed Studio handoff"
                Classes="accent"
                Click="OnOpenStudioClicked" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>