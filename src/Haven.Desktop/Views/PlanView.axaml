<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/PlanView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.PlanView. Its visual vocabulary includes: UserControl.Resources, DateTimeOffsetDateConverter, Grid, Border, StackPanel, TextBlock, ItemsControl, ItemsControl.ItemTemplate, DataTemplate, Button, ScrollViewer, ListBox, ListBox.ItemTemplate, HavenIcon, TextBox, CalendarDatePicker, ComboBox, ComboBox.ItemTemplate, TimePicker, ItemsControl.ItemsPanel, ItemsPanelTemplate, UniformGrid, CheckBox.
  Data flow: Binding expressions read or update these view-model paths: Views, Name, Collections, SelectedCollection, NewCollectionName, CreateCollectionCommand, SelectedCollectionName, RenameCollectionCommand, RequestArchiveCollectionCommand, IsArchiveCollectionConfirming, CancelArchiveCollectionCommand, ArchiveCollectionCommand, Title, PeriodLabel, PreviousPeriodCommand, TodayCommand, NextPeriodCommand, NewTaskTitle, NewTaskDueDate, Priorities, NewTaskPriority, CreateTaskCommand, NewEventTitle, Calendars, SelectedCalendar, NewEventDate, NewEventStart, NewEventEnd, CreateEventCommand, ShowsStandardList, Status, Tasks, Meta, Events, Detail, CanDelete, BoardColumns, ShowsBoard, CountLabel, CalendarDays, ShowsCalendarGrid, DayName, DayNumber, Entries, Time, HasTaskEditor, CloseTaskEditorCommand, TaskEditor.Title, TaskEditor.Notes, TaskEditor.Priorities, TaskEditor.Priority, TaskEditor.Statuses, TaskEditor.Status, TaskEditor.Parents, TaskEditor.SelectedParent, TaskEditor.StartsAt, TaskEditor.DueAt, TaskEditor.ReminderAt, TaskEditor.Tags, TaskEditor.EstimatedMinutes, TaskEditor.RecurrenceRule, TaskEditor.TimeZoneId, TaskEditor.Message, TaskEditor.SaveCommand, HasEventEditor, CloseEventEditorCommand, EventEditor.Title, EventEditor.Notes, EventEditor.Location, EventEditor.Date, EventEditor.StartTime, EventEditor.EndTime, EventEditor.IsAllDay, EventEditor.ReminderAt, EventEditor.RecurrenceRule, EventEditor.TimeZoneId, EventEditor.Message, EventEditor.SaveCommand, EventEditor.CanSave, AiPrompt, AskAiCommand, HasPendingProposal, PendingProposalSummary, PendingChanges, Kind, Description, DismissProposalCommand, ApplyProposalCommand, Providers, HasConflicts, Conflicts, Detected, HavenVersion, ProviderVersion.
  Interaction: Direct event handlers in this file are: TaskDrag_OnPointerPressed, CalendarEntryDrag_OnPointerPressed.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             xmlns:converters="using:Haven.Desktop.Converters"
             x:Class="Haven.Desktop.Views.PlanView">
  <!-- Section: Defines reusable theme resources here so descendant controls resolve consistent values at runtime. -->
  <UserControl.Resources>
    <!-- Section: Hosts the DateTimeOffsetDateConverter portion of this view at this position in the visual tree. -->
    <converters:DateTimeOffsetDateConverter x:Key="DateTimeOffsetDateConverter" />
  </UserControl.Resources>
  <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
  <Grid ColumnDefinitions="220,*,320" Background="{DynamicResource HavenBackgroundBrush}">
    <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
    <Border Grid.Column="0" BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="0,0,1,0" Padding="18,22">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel>
          <TextBlock Text="PLAN" Classes="eyebrow" />
          <TextBlock Text="Views" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,12" />
        </StackPanel>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Views}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Name}"
                      HorizontalContentAlignment="Left"
                      Command="{Binding $parent[UserControl].DataContext.SelectViewCommand}"
                      CommandParameter="{Binding}"
                      Margin="0,0,0,4" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ScrollViewer Grid.Row="2" Margin="0,22,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="COLLECTIONS" Classes="eyebrow" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Local" Classes="muted" FontSize="11" />
          </Grid>
          <ListBox ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" Margin="0,8,0,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Text="{Binding Name}" Margin="8,7" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="icon compact" ToolTip.Tip="Move collection up"
                          Command="{Binding $parent[UserControl].DataContext.MoveCollectionUpCommand}" CommandParameter="{Binding}">
                    <controls:HavenIcon IconKey="chevron-down" RenderTransform="rotate(180deg)" Width="13" Height="13" />
                  </Button>
                  <Button Grid.Column="2" Classes="icon compact" Margin="3,0,0,0" ToolTip.Tip="Move collection down"
                          Command="{Binding $parent[UserControl].DataContext.MoveCollectionDownCommand}" CommandParameter="{Binding}">
                    <controls:HavenIcon IconKey="chevron-down" Width="13" Height="13" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5" Margin="0,9,0,0">
            <TextBox Text="{Binding NewCollectionName}" PlaceholderText="New collection" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding CreateCollectionCommand}" ToolTip.Tip="Create collection">
              <controls:HavenIcon IconKey="plus" Width="14" Height="14" />
            </Button>
          </Grid>
          <TextBox Text="{Binding SelectedCollectionName}" PlaceholderText="Collection name" Margin="0,7,0,5" />
          <Grid ColumnDefinitions="*,Auto">
            <Button Content="Rename" Command="{Binding RenameCollectionCommand}" HorizontalContentAlignment="Left" />
            <Button Grid.Column="1" Content="Archive" Command="{Binding RequestArchiveCollectionCommand}" Margin="5,0,0,0" />
          </Grid>
          <Border Classes="card" Padding="9" Margin="0,7,0,0" IsVisible="{Binding IsArchiveCollectionConfirming}">
            <StackPanel>
              <TextBlock Text="Archive this collection? Tasks remain stored locally." Classes="muted" TextWrapping="Wrap" FontSize="10" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="5" Margin="0,6,0,0">
                <Button Content="Cancel" Command="{Binding CancelArchiveCollectionCommand}" />
                <Button Grid.Column="1" Content="Archive" Classes="danger" Command="{Binding ArchiveCollectionCommand}" />
              </Grid>
            </StackPanel>
          </Border>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Classes="card" Padding="12">
          <TextBlock Text="Tasks stay local. Calendar accounts are optional and sync events only." Classes="muted" TextWrapping="Wrap" FontSize="11" />
        </Border>
      </Grid>
    </Border>

    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" Margin="28,24">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Classes="heading" />
          <TextBlock Text="{Binding PeriodLabel}" Classes="muted" Margin="0,3,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Classes="icon" Command="{Binding PreviousPeriodCommand}" Margin="0,0,6,0" ToolTip.Tip="Previous period">
          <controls:HavenIcon IconKey="chevron-left" Width="14" Height="14" />
        </Button>
        <Button Grid.Column="2" Content="Today" Command="{Binding TodayCommand}" Margin="0,0,6,0" />
        <Button Grid.Column="3" Classes="icon" Command="{Binding NextPeriodCommand}" ToolTip.Tip="Next period">
          <controls:HavenIcon IconKey="chevron-left" RenderTransform="rotate(180deg)" Width="14" Height="14" />
        </Button>
      </Grid>

      <Border Grid.Row="1" Classes="card" Margin="0,18,0,10" Padding="14">
        <Grid ColumnDefinitions="*,160,130,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding NewTaskTitle}" PlaceholderText="Add a task…" />
          <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding NewTaskDueDate, Mode=TwoWay, Converter={StaticResource DateTimeOffsetDateConverter}}" PlaceholderText="Due date" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding Priorities}" SelectedItem="{Binding NewTaskPriority}" />
          <Button Grid.Column="3" Content="Add task" Classes="primary" Command="{Binding CreateTaskCommand}" />
        </Grid>
      </Border>

      <Border Grid.Row="2" Classes="card" Margin="0,0,0,10" Padding="14">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,150,145" ColumnSpacing="8" RowSpacing="8">
          <TextBox Text="{Binding NewEventTitle}" PlaceholderText="Add a calendar event…" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Calendars}" SelectedItem="{Binding SelectedCalendar}" PlaceholderText="Calendar">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CalendarDatePicker Grid.Column="2" SelectedDate="{Binding NewEventDate, Mode=TwoWay, Converter={StaticResource DateTimeOffsetDateConverter}}" PlaceholderText="Date" />
          <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="Auto,140,Auto,140,*,Auto" ColumnSpacing="8">
            <TextBlock Text="Starts" Classes="muted" VerticalAlignment="Center" />
            <TimePicker Grid.Column="1" SelectedTime="{Binding NewEventStart}" ClockIdentifier="24HourClock" MinWidth="140" />
            <TextBlock Grid.Column="2" Text="Ends" Classes="muted" VerticalAlignment="Center" />
            <TimePicker Grid.Column="3" SelectedTime="{Binding NewEventEnd}" ClockIdentifier="24HourClock" MinWidth="140" />
            <Button Grid.Column="5" Content="Add event" Classes="primary" Command="{Binding CreateEventCommand}" HorizontalContentAlignment="Center" />
          </Grid>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="3">
        <Grid>
          <StackPanel IsVisible="{Binding ShowsStandardList}">
            <Grid ColumnDefinitions="*,Auto" Margin="2,6,2,8">
              <TextBlock Text="TASKS" Classes="eyebrow" />
              <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="11" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Tasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Margin="0,0,0,8" Padding="14">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                      <Border Width="24" Height="34" CornerRadius="6" Background="{DynamicResource HavenPanel2Brush}"
                              PointerPressed="TaskDrag_OnPointerPressed" Cursor="SizeAll">
                        <controls:HavenIcon IconKey="more" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
                      </Border>
                      <Button Grid.Column="1" Classes="icon" Width="34" Height="34" Margin="6,0,0,0"
                              Command="{Binding $parent[UserControl].DataContext.CompleteTaskCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="Complete task">
                        <controls:HavenIcon IconKey="check" Width="14" Height="14" />
                      </Button>
                      <StackPanel Grid.Column="2" Margin="12,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="11" Margin="0,3,0,0" />
                      </StackPanel>
                      <Button Grid.Column="3" Content="Edit" Margin="0,0,6,0"
                              Command="{Binding $parent[UserControl].DataContext.EditTaskCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="4" Content="Subtask" Margin="0,0,6,0"
                              Command="{Binding $parent[UserControl].DataContext.AddSubtaskCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="5" Content="Start" Margin="0,0,6,0"
                              Command="{Binding $parent[UserControl].DataContext.StartTaskCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="6" Content="Delete"
                              Command="{Binding $parent[UserControl].DataContext.DeleteTaskCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="CALENDAR" Classes="eyebrow" Margin="2,16,2,8" />
            <ItemsControl ItemsSource="{Binding Events}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Margin="0,0,0,8" Padding="14">
                    <Grid ColumnDefinitions="6,*,Auto,Auto">
                      <Border Background="{DynamicResource HavenAccentBrush}" CornerRadius="3" />
                      <StackPanel Grid.Column="1" Margin="12,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" Margin="0,3,0,0" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="Edit" Margin="0,0,6,0"
                              Command="{Binding $parent[UserControl].DataContext.EditEventCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="3" Content="Delete" IsVisible="{Binding CanDelete}"
                              Command="{Binding $parent[UserControl].DataContext.DeleteEventCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding BoardColumns}" IsVisible="{Binding ShowsBoard}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Margin="4" Padding="12" VerticalAlignment="Stretch"
                        DragDrop.AllowDrop="True" DragDrop.DragOver="PlannerDropTarget_OnDragOver" DragDrop.Drop="BoardColumn_OnDrop">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Classes="muted" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Tasks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource HavenPanel2Brush}" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="5" Background="{DynamicResource HavenPanel3Brush}"
                                        PointerPressed="TaskDrag_OnPointerPressed" Cursor="SizeAll">
                                  <controls:HavenIcon IconKey="more" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
                                </Border>
                              </Grid>
                              <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="10" Margin="0,3,0,7" />
                              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                                <Button Content="Edit" Command="{Binding $parent[UserControl].DataContext.EditTaskCommand}" CommandParameter="{Binding}" />
                                <Button Grid.Column="1" Content="Start" Command="{Binding $parent[UserControl].DataContext.StartTaskCommand}" CommandParameter="{Binding}" />
                                <Button Grid.Column="2" Content="Done" Command="{Binding $parent[UserControl].DataContext.CompleteTaskCommand}" CommandParameter="{Binding}" />
                              </Grid>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding CalendarDays}" IsVisible="{Binding ShowsCalendarGrid}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Margin="3" Padding="9" MinHeight="124" VerticalAlignment="Stretch"
                        DragDrop.AllowDrop="True" DragDrop.DragOver="PlannerDropTarget_OnDragOver" DragDrop.Drop="CalendarDay_OnDrop">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                      <TextBlock Text="{Binding DayName}" Classes="muted" FontSize="10" />
                      <TextBlock Grid.Column="1" Text="{Binding DayNumber}" FontWeight="SemiBold" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Entries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource HavenAccentSoftBrush}" CornerRadius="6" Padding="5,3" Margin="0,0,0,4"
                                  PointerPressed="CalendarEntryDrag_OnPointerPressed" Cursor="SizeAll">
                            <StackPanel>
                              <TextBlock Text="{Binding Time}" FontSize="9" Foreground="{DynamicResource HavenAccentBrush}" />
                              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="10" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
    <Border Grid.Column="2" BorderBrush="{DynamicResource HavenLineBrush}" BorderThickness="1,0,0,0" Padding="18,22">
      <ScrollViewer>
        <StackPanel>
          <Border Classes="card" IsVisible="{Binding HasTaskEditor}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="EDIT TASK" Classes="eyebrow" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon" Width="30" Height="30" Padding="0" Command="{Binding CloseTaskEditorCommand}" ToolTip.Tip="Close task editor"><controls:HavenIcon IconKey="close" Width="13" Height="13" /></Button>
              </Grid>
              <TextBox Text="{Binding TaskEditor.Title}" PlaceholderText="Title" Margin="0,9,0,6" />
              <TextBox Text="{Binding TaskEditor.Notes}" PlaceholderText="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,6,0,0">
                <ComboBox ItemsSource="{Binding TaskEditor.Priorities}" SelectedItem="{Binding TaskEditor.Priority}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TaskEditor.Statuses}" SelectedItem="{Binding TaskEditor.Status}" />
              </Grid>
              <ComboBox ItemsSource="{Binding TaskEditor.Parents}" SelectedItem="{Binding TaskEditor.SelectedParent}" Margin="0,6,0,0">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,6,0,0">
                <CalendarDatePicker SelectedDate="{Binding TaskEditor.StartsAt, Mode=TwoWay, Converter={StaticResource DateTimeOffsetDateConverter}}" PlaceholderText="Start" />
                <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding TaskEditor.DueAt, Mode=TwoWay, Converter={StaticResource DateTimeOffsetDateConverter}}" PlaceholderText="Due" />
              </Grid>
              <CalendarDatePicker SelectedDate="{Binding TaskEditor.ReminderAt, Mode=TwoWay, Converter={StaticResource DateTimeOffsetDateConverter}}" PlaceholderText="Reminder" Margin="0,6,0,0" />
              <TextBox Text="{Binding TaskEditor.Tags}" PlaceholderText="Tags, separated by commas" Margin="0,6,0,0" />
              <TextBox Text="{Binding TaskEditor.EstimatedMinutes}" PlaceholderText="Estimate in minutes" Margin="0,6,0,0" />
              <TextBox Text="{Binding TaskEditor.RecurrenceRule}" PlaceholderText="Recurrence, e.g. FREQ=WEEKLY;BYDAY=MO" Margin="0,6,0,0" />
              <TextBox Text="{Binding TaskEditor.TimeZoneId}" PlaceholderText="Time zone" Margin="0,6,0,0" />
              <TextBlock Text="{Binding TaskEditor.Message}" Classes="muted" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,7" />
              <Button Content="Save task" Classes="primary" Command="{Binding TaskEditor.SaveCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasEventEditor}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="EDIT EVENT" Classes="eyebrow" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon" Width="30" Height="30" Padding="0" Command="{Binding CloseEventEditorCommand}" ToolTip.Tip="Close event editor"><controls:HavenIcon IconKey="close" Width="13" Height="13" /></Button>
              </Grid>
              <TextBox Text="{Binding EventEditor.Title}" PlaceholderText="Title" Margin="0,9,0,6" />
              <TextBox Text="{Binding EventEditor.Notes}" PlaceholderText="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
              <TextBox Text="{Binding EventEditor.Location}" PlaceholderText="Location" Margin="0,6,0,0" />
              <CalendarDatePicker SelectedDate="{Binding EventEditor.Date, Mode=TwoWay, Converter={StaticResource DateTimeOffsetDateConverter}, ConverterParameter=Required}" PlaceholderText="Date" Margin="0,6,0,0" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,6,0,0">
                <TimePicker SelectedTime="{Binding EventEditor.StartTime}" ClockIdentifier="24HourClock" />
                <TimePicker Grid.Column="1" SelectedTime="{Binding EventEditor.EndTime}" ClockIdentifier="24HourClock" />
              </Grid>
              <CheckBox Content="All day" IsChecked="{Binding EventEditor.IsAllDay}" Margin="0,6,0,0" />
              <CalendarDatePicker SelectedDate="{Binding EventEditor.ReminderAt, Mode=TwoWay, Converter={StaticResource DateTimeOffsetDateConverter}}" PlaceholderText="Reminder" Margin="0,6,0,0" />
              <TextBox Text="{Binding EventEditor.RecurrenceRule}" PlaceholderText="Recurrence, e.g. FREQ=MONTHLY" Margin="0,6,0,0" />
              <TextBox Text="{Binding EventEditor.TimeZoneId}" PlaceholderText="Time zone" Margin="0,6,0,0" />
              <TextBlock Text="{Binding EventEditor.Message}" Classes="muted" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,7" />
              <Button Content="Save event" Classes="primary" Command="{Binding EventEditor.SaveCommand}" IsEnabled="{Binding EventEditor.CanSave}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>

          <TextBlock Text="PLAN WITH HAVEN" Classes="eyebrow" />
          <TextBlock Text="AI assistance" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,4" />
          <TextBlock Text="Ask Haven to break down a goal, organise a week, or resolve conflicts. You approve every edit." Classes="muted" TextWrapping="Wrap" />
          <TextBox Text="{Binding AiPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="104" Margin="0,14,0,8"
                   PlaceholderText="Plan my college deadlines around work…" />
          <Button Content="Draft changes" Classes="primary" Command="{Binding AskAiCommand}" HorizontalAlignment="Stretch" />

          <Border Classes="card" Margin="0,14,0,0" IsVisible="{Binding HasPendingProposal}" Padding="14">
            <StackPanel>
              <TextBlock Text="REVIEW PROPOSAL" Classes="eyebrow" />
              <TextBlock Text="{Binding PendingProposalSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,10" />
              <ItemsControl ItemsSource="{Binding PendingChanges}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource HavenAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0">
                <Button Content="Dismiss" Command="{Binding DismissProposalCommand}" />
                <Button Grid.Column="1" Content="Apply" Classes="primary" Command="{Binding ApplyProposalCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="CALENDAR ACCOUNTS" Classes="eyebrow" Margin="0,24,0,8" />
          <ItemsControl ItemsSource="{Binding Providers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Margin="0,0,0,8" Padding="12">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                      <Button Content="Connect"
                              Command="{Binding $parent[UserControl].DataContext.ConnectProviderCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="1" Content="Sync"
                              Command="{Binding $parent[UserControl].DataContext.SyncProviderCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2" Content="Disconnect"
                              Command="{Binding $parent[UserControl].DataContext.DisconnectProviderCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding HasConflicts}" Margin="0,16,0,0">
            <TextBlock Text="SYNC CONFLICTS" Classes="eyebrow" Margin="0,0,0,8" />
            <TextBlock Text="Both Haven and the connected calendar changed these events. Choose which version to keep; nothing is overwritten automatically."
                       Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Conflicts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detected}" Classes="muted" FontSize="10" Margin="0,2,0,8" />
                      <TextBlock Text="{Binding HavenVersion}" TextWrapping="Wrap" FontSize="11" />
                      <TextBlock Text="{Binding ProviderVersion}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,10" />
                      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                        <Button Content="Keep Haven"
                                Command="{Binding $parent[UserControl].DataContext.KeepHavenConflictCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="1" Content="Keep provider"
                                Command="{Binding $parent[UserControl].DataContext.KeepProviderConflictCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Content="Duplicate"
                                Command="{Binding $parent[UserControl].DataContext.DuplicateConflictCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
