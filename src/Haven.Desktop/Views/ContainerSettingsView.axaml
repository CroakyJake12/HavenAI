<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/ContainerSettingsView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.ContainerSettingsView. Its visual vocabulary includes: ScrollViewer, StackPanel, TextBlock, Border, TextBox, Grid, Button.
  Data flow: Binding expressions read or update these view-model paths: Eyebrow, Name, RootPath, Context, Instructions, Status, ArchiveLabel, ArchiveCommand, DeleteLabel, RequestDeleteCommand, SaveCommand, IsDeleteConfirming, CancelDeleteCommand, DeleteCommand.
  Interaction: Direct event handlers in this file are: OnBrowseFolderClicked.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Haven.Desktop.Views.ContainerSettingsView">
  <!-- Container Settings — configure a project/workspace container's name, folder, context, and instructions -->
  <!-- Section: Keeps the region usable when content exceeds the available window size. -->
  <ScrollViewer>
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
    <StackPanel Margin="32,28" Spacing="15" MaxWidth="900" HorizontalAlignment="Left">
      <!-- Page header: eyebrow label + container name + description -->
      <TextBlock Text="{Binding Eyebrow}" Classes="eyebrow" />
      <TextBlock Text="{Binding Name}" Classes="heading" />
      <TextBlock Text="Set the local workspace, persistent context, and instructions used for chats in this project." Classes="muted" />

      <!-- ============================================================
           GENERAL SECTION
           Container name + local folder path with Browse button
           ============================================================ -->
      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="GENERAL" Classes="eyebrow" />
          <TextBlock Text="Name" Classes="muted" FontSize="11" />
          <TextBox Text="{Binding Name}" PlaceholderText="Project name" />
          <TextBlock Text="Local folder" Classes="muted" FontSize="11" Margin="0,5,0,0" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding RootPath}" PlaceholderText="Choose a folder for workspace tools" />
            <Button Grid.Column="1" Content="Browse…" Click="OnBrowseFolderClicked" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============================================================
           CONTEXT SECTION
           Background information included when working in this project
           ============================================================ -->
      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="CONTEXT" Classes="eyebrow" />
          <TextBlock Text="Background information included when working in this project." Classes="muted" FontSize="11" />
          <TextBox Text="{Binding Context}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
        </StackPanel>
      </Border>

      <!-- ============================================================
           INSTRUCTIONS SECTION
           Project-specific behaviour and constraints
           ============================================================ -->
      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="INSTRUCTIONS" Classes="eyebrow" />
          <TextBlock Text="Project-specific behaviour and constraints." Classes="muted" FontSize="11" />
          <TextBox Text="{Binding Instructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
        </StackPanel>
      </Border>

      <!-- ============================================================
           FOOTER: Status + Archive + Delete + Save buttons
           Delete confirmation appears when delete is requested
           ============================================================ -->
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding !IsDeleteConfirming}">
        <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{Binding ArchiveLabel}" Command="{Binding ArchiveCommand}" />
        <Button Grid.Column="2" Content="{Binding DeleteLabel}" Classes="danger" Command="{Binding RequestDeleteCommand}" />
        <Button Grid.Column="3" Content="Discard changes" Command="{Binding DiscardChangesCommand}" />
        <Button Grid.Column="4" Content="Save changes" Classes="accent" Command="{Binding SaveCommand}" />
      </Grid>
      <!-- Delete confirmation banner -->
      <Border Classes="permission" IsVisible="{Binding IsDeleteConfirming}"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7"><TextBlock Text="Permanently delete this group and its settings? Saved conversations remain separately available." VerticalAlignment="Center" /><Button Grid.Column="1" Content="Cancel" Command="{Binding CancelDeleteCommand}" /><Button Grid.Column="2" Content="Delete permanently" Classes="danger" Command="{Binding DeleteCommand}" /></Grid></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
