<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Haven.Desktop.Views.ContainerSettingsView">
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="15" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock x:Name="EyebrowText" Classes="eyebrow" />
      <TextBlock x:Name="NameText" Classes="heading" />
      <TextBlock Text="Set the local workspace, persistent context, and instructions used for chats in this project." Classes="muted" />

      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="GENERAL" Classes="eyebrow" />
          <TextBlock Text="Name" Classes="muted" FontSize="11" />
          <TextBox x:Name="NameBox" PlaceholderText="Project name" />
          <TextBlock Text="Local folder" Classes="muted" FontSize="11" Margin="0,5,0,0" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="RootPathBox" PlaceholderText="Choose a folder for workspace tools" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Click="OnBrowseFolderClicked" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="CONTEXT" Classes="eyebrow" />
          <TextBlock Text="Background information included when working in this project." Classes="muted" FontSize="11" />
          <TextBox x:Name="ContextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="INSTRUCTIONS" Classes="eyebrow" />
          <TextBlock Text="Project-specific behaviour and constraints." Classes="muted" FontSize="11" />
          <TextBox x:Name="InstructionsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
        </StackPanel>
      </Border>

      <Grid x:Name="FooterPanel" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock x:Name="StatusText" Classes="muted" VerticalAlignment="Center" />
        <Button x:Name="ArchiveButton" Grid.Column="1" />
        <Button x:Name="DeleteButton" Grid.Column="2" Classes="danger" />
        <Button x:Name="DiscardButton" Grid.Column="3" Content="Discard changes" />
        <Button x:Name="SaveButton" Grid.Column="4" Content="Save changes" Classes="accent" />
      </Grid>
      <Border x:Name="DeleteConfirmPanel" Classes="permission" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
          <TextBlock Text="Permanently delete this group and its settings? Saved conversations remain separately available." VerticalAlignment="Center" />
          <Button x:Name="CancelDeleteButton" Grid.Column="1" Content="Cancel" />
          <Button x:Name="ConfirmDeleteButton" Grid.Column="2" Content="Delete permanently" Classes="danger" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
