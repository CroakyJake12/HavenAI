<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             xmlns:topRail="using:Haven.Desktop.Views.Shell.TopRail"
             xmlns:sidebar="using:Haven.Desktop.Views.Shell.Sidebar"
             x:Class="Haven.Desktop.Views.Shell.MainView"
             x:Name="MainViewRoot">

    <Grid RowDefinitions="Auto,*"
          Background="Transparent">

        <Border Grid.RowSpan="2"
                Background="{DynamicResource HavenBackgroundBrush}"
                IsHitTestVisible="False" />

        <!-- ROW 0: Top Rail (header with logo, tabs, actions) -->
        <topRail:TopRail x:Name="TopRail" Grid.Row="0" />

        <!-- ROW 1: Main content area -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              Margin="16,4,16,16">

            <!-- Sidebar (conditional) -->
            <sidebar:Sidebar x:Name="SidebarControl"
                             Grid.Column="0"
                             Width="276"
                             IsVisible="True"
                             Margin="0,0,10,0"/>

            <!-- New Haven owns a separate code-behind sidebar. The shell only
                 supplies a named host; no Classic sidebar visuals participate. -->
            <ContentControl x:Name="NativeSidebarHost"
                            Grid.Column="0"
                            Width="286"
                            IsVisible="False"
                            Margin="0,0,10,0"/>

            <!-- Content area -->
            <Grid Grid.Column="1">
                <Border x:Name="ContentArea"
                        Background="{DynamicResource HavenPanelBrush}"
                        BorderBrush="{DynamicResource HavenLineBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Page content owns the full framed workspace. -->
                        <ContentControl x:Name="PageContent" Margin="6"/>

                        <!-- The app switcher and model state belong inside the workspace frame. -->
                        <Grid x:Name="ShellContextBar"
                              ColumnDefinitions="Auto,*,Auto"
                              Margin="18,16,18,0"
                              IsVisible="False"
                              VerticalAlignment="Top">
                            <StackPanel x:Name="GoModeSwitcher"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Border Background="{DynamicResource HavenPanel2Brush}"
                                        BorderBrush="{DynamicResource HavenLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="3">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="GoChatButton"
                                                Classes="icon compact"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="999"
                                                ToolTip.Tip="Chat">
                                            <controls:HavenIcon IconKey="chat" Width="16" Height="16"/>
                                        </Button>
                                        <Button x:Name="GoDashboardButton"
                                                Classes="icon compact"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="999"
                                                ToolTip.Tip="Dashboard">
                                            <controls:HavenIcon IconKey="dashboard" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="GoModeLabel" Text="Go"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"/>
                            </StackPanel>

                            <Button x:Name="StoredChatDropdown"
                                    Grid.Column="1"
                                    Classes="chip"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <controls:HavenIcon IconKey="chat" Width="14" Height="14" Opacity="0.72"/>
                                    <TextBlock x:Name="StoredChatLabel" Text="Saved Chat" VerticalAlignment="Center"/>
                                    <controls:HavenIcon IconKey="chevron-down" Width="11" Height="11" Opacity="0.6"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Spacing="2" MinWidth="160">
                                            <Button x:Name="SavedChatOption" Classes="sidebar" HorizontalAlignment="Stretch">
                                                <TextBlock Text="Saved Chat" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button x:Name="TemporaryChatOption" Classes="sidebar" HorizontalAlignment="Stretch">
                                                <TextBlock Text="Temporary Chat" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="ModelSelectorButton"
                                    Grid.Column="2"
                                    Classes="chip"
                                    Background="{DynamicResource HavenPanel2Brush}"
                                    BorderBrush="{DynamicResource HavenLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="12,5"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Choose the model for this chat">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="ModelNameText"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Text="Qwen 3.6"/>
                                    <TextBlock Text="&#x2022;" Classes="muted" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ContextPercentText" FontSize="13" FontWeight="Medium" Text="100%"/>
                                    <controls:HavenIcon IconKey="chevron-down" Width="11" Height="11" Opacity="0.62"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- New Haven overlays remain in the MainView visual tree. A named
                     code-behind host prevents Popup top-levels from escaping the
                     rounded workspace frame while keeping all behavior binding-free. -->
                <Grid x:Name="NativeOverlayLayer"
                      Panel.ZIndex="20"
                      ClipToBounds="True"/>

                <!-- Overlay host -->
                <Border x:Name="OverlayHost"
                        Background="{DynamicResource HavenBackgroundBrush}"
                        CornerRadius="24"
                        ClipToBounds="True"
                        IsVisible="False"/>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
