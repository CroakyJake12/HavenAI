<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Shell.TopRail.UniversalSearchControl">
  <StackPanel Width="690" Spacing="9">
    <Border Background="{DynamicResource HavenElevatedBrush}"
            BorderBrush="{DynamicResource HavenLineBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="5">
      <Grid>
        <TextBox x:Name="SearchBox"
                 PlaceholderText="Search Haven"
                 Padding="43,13,14,13"
                 FontSize="15"
                 BorderThickness="0"
                 Background="Transparent"/>
        <controls:HavenIcon IconKey="search"
                            Width="20" Height="20"
                            Margin="14,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>
      </Grid>
    </Border>

    <Border Background="{DynamicResource HavenElevatedBrush}"
            BorderBrush="{DynamicResource HavenLineBrush}"
            BorderThickness="1"
            CornerRadius="24"
            Padding="15">
      <ScrollViewer MaxHeight="560"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ResultsPanel" Spacing="5"/>
      </ScrollViewer>
    </Border>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
      <Button x:Name="ViewAllButton"
              Classes="sidebar"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Padding="16,13"
              CornerRadius="18">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <controls:HavenIcon IconKey="chevron-right" Width="18" Height="18"/>
          <TextBlock Text="View all" FontWeight="ExtraBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button x:Name="SearchSettingsButton"
              Grid.Column="1"
              Classes="sidebar"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Padding="16,13"
              CornerRadius="18">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <controls:HavenIcon IconKey="settings" Width="18" Height="18"/>
          <TextBlock Text="Search settings" FontWeight="ExtraBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>
  </StackPanel>
</UserControl>
