<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             xmlns:topRail="using:Haven.Desktop.Views.Shell.TopRail"
             x:Class="Haven.Desktop.Views.Shell.TopRail.TopRail"
             x:Name="TopRailRoot">

  <Grid Height="86">
    <Border Margin="10,8,10,4"
            Background="{DynamicResource HavenPanelBrush}"
            BorderBrush="{DynamicResource HavenBorderBrush}"
            BorderThickness="1"
            CornerRadius="30"
            Padding="9,7">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="8">

        <!-- The product mark intentionally has no adjacent wordmark. -->
        <Button x:Name="LogoButton"
                Grid.Column="0"
                Classes="icon compact"
                Width="54" Height="54"
                Padding="4"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="17"
                ToolTip.Tip="Haven home">
          <Image Source="/Assets/haven-192.png"
                 Width="48" Height="48"
                 Stretch="Uniform"/>
        </Button>

        <!-- Collapsed buttons consume no width, allowing the tab surface to expand. -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
          <Button x:Name="BackButton"
                  Classes="icon compact"
                  Width="42" Height="42"
                  IsVisible="False"
                  ToolTip.Tip="Back">
            <controls:HavenIcon IconKey="chevron-left" Width="18" Height="18"/>
          </Button>
          <Button x:Name="ForwardButton"
                  Classes="icon compact"
                  Width="42" Height="42"
                  IsVisible="False"
                  ToolTip.Tip="Forward">
            <controls:HavenIcon IconKey="chevron-right" Width="18" Height="18"/>
          </Button>
        </StackPanel>

        <Border Grid.Column="2"
                Background="{DynamicResource HavenPanel2Brush}"
                BorderBrush="{DynamicResource HavenLineBrush}"
                BorderThickness="1"
                CornerRadius="23"
                MinWidth="260"
                Height="58"
                Padding="10,5">
          <Grid ColumnDefinitions="*,Auto">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
              <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="3"/>
            </ScrollViewer>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
              <Button x:Name="AddTabButton"
                      Classes="icon compact"
                      Width="42" Height="42"
                      ToolTip.Tip="New tab">
                <controls:HavenIcon IconKey="plus" Width="17" Height="17"/>
              </Button>
              <Button x:Name="TabViewButton"
                      Classes="icon compact"
                      Width="42" Height="42"
                      ToolTip.Tip="All tabs">
                <controls:HavenIcon IconKey="window" Width="18" Height="18"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Button x:Name="AppsButton"
                Grid.Column="3"
                Classes="chrome"
                Height="46"
                Padding="15,7"
                CornerRadius="18"
                VerticalAlignment="Center"
                ToolTip.Tip="Apps">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:HavenIcon IconKey="rocket" Width="19" Height="19"/>
            <TextBlock Text="Apps" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <!-- Actions owns contextual, pinned, and recommended commands. -->
        <topRail:DynamicActionToolbar x:Name="ActionToolbar"
                                      Grid.Column="4"
                                      VerticalAlignment="Center"/>

        <Button x:Name="UniversalModelButton"
                Grid.Column="5"
                Classes="chrome"
                Height="46"
                MinWidth="160"
                MaxWidth="240"
                Padding="14,7"
                CornerRadius="18"
                VerticalAlignment="Center"
                ToolTip.Tip="Model, voice, actions, and reasoning">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock x:Name="UniversalModelName"
                       Text="Local model"
                       FontWeight="ExtraBold"
                       FontSize="13"
                       MaxWidth="118"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock Text="·" Classes="muted" VerticalAlignment="Center"/>
            <TextBlock x:Name="UniversalReasoningValue"
                       Text="60%"
                       FontWeight="ExtraBold"
                       FontSize="13"
                       Foreground="{DynamicResource HavenAccentBrush}"
                       VerticalAlignment="Center"/>
            <controls:HavenIcon IconKey="chevron-down" Width="11" Height="11" Opacity="0.68"/>
          </StackPanel>
        </Button>

        <Button x:Name="NotificationsButton"
                Grid.Column="6"
                Classes="icon compact"
                Width="46" Height="46"
                VerticalAlignment="Center"
                ToolTip.Tip="Notifications">
          <Grid>
            <controls:HavenIcon IconKey="bell" Width="20" Height="20"/>
            <Ellipse x:Name="NotificationBadge"
                     Width="8" Height="8"
                     Fill="#20CEC8"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,3,3"/>
          </Grid>
        </Button>

        <Button x:Name="SearchButton"
                Grid.Column="7"
                Classes="icon compact"
                Width="46" Height="46"
                VerticalAlignment="Center"
                ToolTip.Tip="Search Haven">
          <controls:HavenIcon IconKey="search" Width="21" Height="21"/>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
