<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Shell.TopRail.ActionsFlyoutControl">

  <StackPanel Spacing="9">
    <Border Width="410"
            Background="{DynamicResource HavenElevatedBrush}"
            BorderBrush="{DynamicResource HavenLineBrush}"
            BorderThickness="1"
            CornerRadius="24">
      <StackPanel Spacing="10" Margin="16">
        <TextBlock Text="Actions" FontSize="20" FontWeight="ExtraBold" />
        <Grid>
          <TextBox x:Name="SearchBox"
                   PlaceholderText="Search actions"
                   Padding="38,10,12,10"
                   FontSize="14" />
          <controls:HavenIcon IconKey="search" Width="17" Height="17"
                              Margin="13,0,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Opacity="0.7"
                              IsHitTestVisible="False" />
        </Grid>
        <ScrollViewer MaxHeight="350"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="SectionsPanel" Spacing="4" />
        </ScrollViewer>
      </StackPanel>
    </Border>

    <Border Width="410"
            Background="{DynamicResource HavenElevatedBrush}"
            BorderBrush="{DynamicResource HavenLineBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="4">
      <Button x:Name="EditActionsButton"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Padding="14,11"
              Classes="sidebar">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <controls:HavenIcon IconKey="settings" Width="19" Height="19" />
          <TextBlock Text="Edit Actions &amp; Toolbar" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Border>
  </StackPanel>
</UserControl>
