<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.Shell.TopRail.AddMenuCatalogueControl">

  <StackPanel Width="340" Spacing="9" Margin="10">
    <TextBlock x:Name="TitleText"
               FontSize="20"
               FontWeight="ExtraBold"
               Margin="10,5,10,0" />
    <Grid>
      <TextBox x:Name="SearchBox"
               PlaceholderText="Search"
               HorizontalAlignment="Stretch"
               Padding="38,10,12,10" />
      <controls:HavenIcon IconKey="search" Width="18" Height="18"
                          Margin="13,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          Opacity="0.72" />
    </Grid>
    <ScrollViewer MaxHeight="420"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ResultsPanel" Spacing="3" Margin="6,0,10,6" />
    </ScrollViewer>
    <TextBlock x:Name="FooterText"
               Classes="muted"
               FontSize="11"
               FontStyle="Italic"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="4,8" />
  </StackPanel>
</UserControl>
