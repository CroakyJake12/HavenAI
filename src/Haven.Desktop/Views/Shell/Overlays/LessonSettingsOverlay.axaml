<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Haven.Desktop.Controls"
             xmlns:pages="using:Haven.Desktop.Views.Pages.LessonSettings"
             x:Class="Haven.Desktop.Views.Shell.Overlays.LessonSettingsOverlay"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*"
          Background="{DynamicResource HavenBackgroundBrush}">

        <Border Grid.Row="0"
                Padding="18,12"
                Background="{DynamicResource HavenPanelBrush}"
                BorderBrush="{DynamicResource HavenLineBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button x:Name="BackButton"
                        Classes="chrome"
                        ToolTip.Tip="Return to previous view">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <controls:HavenIcon IconKey="arrow-left"
                                            Width="15"
                                            Height="15" />
                        <TextBlock Text="Back"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="Lesson Settings"
                           FontWeight="SemiBold"
                           FontSize="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <ContentControl x:Name="PageContentHost"
                        Grid.Row="1"
                        Margin="6" />
    </Grid>
</UserControl>
