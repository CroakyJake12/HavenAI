<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/LessonSettingsView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.LessonSettingsView. Its visual vocabulary includes: ScrollViewer, StackPanel, TextBlock, Border, TextBox, Grid, Button.
  Data flow: Binding expressions read or update these view-model paths: Name, TopicGroup, StructureJson, Status, SaveCommand.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             x:Class="Haven.Desktop.Views.LessonSettingsView">
  <!-- Lesson Settings — configure a Study lesson's name, topic group, and JSON structure -->
  <!-- Section: Keeps the region usable when content exceeds the available window size. -->
  <ScrollViewer>
    <!-- Section: Groups related controls in reading order; spacing is owned by the container instead of repeated margins. -->
    <StackPanel Margin="32,28" Spacing="15" MaxWidth="880" HorizontalAlignment="Left">
      <!-- Page header -->
      <TextBlock Text="LESSON SETTINGS" Classes="eyebrow" />
      <TextBlock Text="{Binding Name}" Classes="heading" />
      <TextBlock Text="Organise the lesson and preserve its structured Study outline." Classes="muted" />

      <!-- ============================================================
           LESSON NAME + TOPIC GROUP
           Basic identification fields for the lesson
           ============================================================ -->
      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="Lesson name" Classes="muted" FontSize="11" />
          <hui:HavenTextInput Text="{Binding Name}" />
          <TextBlock Text="Topic group" Classes="muted" FontSize="11" Margin="0,5,0,0" />
          <hui:HavenTextInput Text="{Binding TopicGroup}" PlaceholderText="General" />
        </StackPanel>
      </hui:HavenAdaptiveSurface>

      <!-- ============================================================
           STRUCTURE — JSON outline editor
           Monospace text box for editing the lesson's structured JSON.
           Contains sections, objectives, and progress metadata.
           ============================================================ -->
      <hui:HavenAdaptiveSurface Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="STRUCTURE" Classes="eyebrow" />
          <TextBlock Text="JSON outline used to preserve sections, objectives, and progress metadata." Classes="muted" FontSize="11" />
          <hui:HavenTextInput Text="{Binding StructureJson}"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Cascadia Code, Consolas"
                   MinHeight="190" />
        </StackPanel>
      </hui:HavenAdaptiveSurface>

      <!-- Footer: status + Save button -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" />
        <hui:HavenButton Grid.Column="1" Content="Save lesson" Classes="accent" Command="{Binding SaveCommand}" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
