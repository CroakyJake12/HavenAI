<!--
  FILE DOCUMENTATION
  Where: src/Haven.Desktop/Views/TrainingView.axaml in the Avalonia Desktop visual layer.
  What: This markup constructs Haven.Desktop.Views.TrainingView. Its visual vocabulary includes: UserControl.Styles, Style, Setter, Border, Grid, StackPanel, Button, HavenIcon, TextBlock, TextBox, ComboBox, NumericUpDown, CheckBox, ScrollViewer, ItemsControl, ItemsControl.ItemTemplate, DataTemplate, SelectableTextBlock.
  Data flow: Binding expressions read or update these view-model paths: ExitTrainingCommand, TaskPrompt, WorkspacePath, AvailableModels, SelectedModel, DurationMinutes, PermissionModes, FilePermission, CommandPermission, BrowserPermission, AllowDesktopTools, AllowFileSystemWrites, UseWorkspaceSnapshot, StartSessionCommand, IsRunning, StatusMessage, TotalAttempts, StopSessionCommand, HasLiveReasoning, LiveReasoning, AttemptHistory, AttemptNumber, TotalToolCalls, FilesChanged, CurrentReport, SelectedAttemptReport, IsAwaitingFeedback, FeedbackText, SubmitFeedbackCommand, SkipFeedbackCommand.
  Interaction: Direct event handlers in this file are: no direct code-behind events; interaction is command/binding driven.
  Layout: Parent containers own placement and spacing; child controls own content and local presentation.
  Styling: DynamicResource lookups intentionally allow the active Haven palette to change without rebuilding the visual tree.
  Why XAML: Declarative markup keeps visual structure inspectable and separates it from runtime orchestration in code-behind/view models.
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:vm="using:Haven.Desktop.ViewModels"
             xmlns:svc="using:Haven.Desktop.Services"
             xmlns:controls="using:Haven.Desktop.Controls"
             x:Class="Haven.Desktop.Views.TrainingView"
             x:DataType="vm:TrainingPageViewModel">

  <!-- Shared styles used throughout the training view -->
  <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
  <UserControl.Styles>
    <!-- Section headers: used above input fields and list groups -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="TextBlock.section-header">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <!-- Panel cards: white/dark rounded containers for content groups -->
    <!-- Section: Defines presentation rules here so repeated controls share one visual contract. -->
    <Style Selector="Border.report-panel">
      <Setter Property="Background" Value="{DynamicResource HavenPanel2Brush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
  </UserControl.Styles>

  <!-- Root padding wrapper -->
  <!-- Section: Creates a visual surface that owns background, outline, padding, clipping, or corner treatment. -->
  <hui:HavenAdaptiveSurface Padding="20">
    <!-- Main layout: 4 rows — Header, Setup or Progress, History+Report, Status Bar -->
    <!-- Section: Uses a grid here to make row and column placement explicit and stable as content changes. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- ============================================================
           ROW 0: HEADER
           Back button + page title. Always visible.
           ============================================================ -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
        <hui:HavenButton Command="{Binding ExitTrainingCommand}"
                Background="Transparent" Foreground="{DynamicResource HavenTextBrush}"
                BorderBrush="{DynamicResource HavenLineBrush}" CornerRadius="10" Padding="10,5">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:HavenIcon IconKey="chevron-left" Width="13" Height="13" />
            <TextBlock Text="Back" />
          </StackPanel>
        </hui:HavenButton>
        <TextBlock Text="Haven Training" FontSize="20" FontWeight="Bold"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <!-- ============================================================
           ROW 1: SETUP PANEL (visible when NOT running)
           Contains all inputs to configure a training session:
           - Task prompt (what the agent should do)
           - Workspace directory (where the agent works)
           - Model selector (which local Ollama model to use)
           - Duration (how long the session runs)
           - Start button
           ============================================================ -->
      <hui:HavenAdaptiveSurface Grid.Row="1" Classes="report-panel" IsVisible="{Binding !IsRunning}" Margin="0,0,0,16">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

          <!-- Row 0-1: Task prompt — multi-line text input spanning both columns -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Task Instruction" Classes="section-header"/>
          <hui:HavenTextInput Grid.Row="1" Grid.ColumnSpan="2"
                   Text="{Binding TaskPrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="80" Margin="0,0,0,8"/>

          <!-- Row 2-3, Col 0: Workspace directory path -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Workspace Directory" Classes="section-header"/>
          <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <hui:HavenTextInput Text="{Binding WorkspacePath}" MinWidth="300"/>
          </StackPanel>

          <!-- The universal header owns model selection for every surface. -->
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Spacing="4">
            <TextBlock Text="Universal model" Classes="section-header"/>
            <TextBlock Text="Duration (minutes)" Classes="section-header"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Spacing="8">
            <hui:HavenAdaptiveSurface Classes="statusPill" MinWidth="200" Padding="12,8">
              <TextBlock Text="{Binding SelectedModel}" FontWeight="SemiBold"/>
            </hui:HavenAdaptiveSurface>
            <hui:HavenNumericInput Value="{Binding DurationMinutes}" Minimum="1" Maximum="480"
                          Increment="5" FormatString="F0" MinWidth="120"/>
          </StackPanel>

          <!-- Row 4: Sandbox Permissions — controls for tool access during training -->
          <hui:HavenAdaptiveSurface Grid.Row="4" Grid.ColumnSpan="2" Background="{DynamicResource HavenPanel2Brush}"
                  CornerRadius="8" Padding="12" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                         Text="Sandbox Permissions" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

              <!-- Row 0: File, Command, Browser permission dropdowns -->
              <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Spacing="2" Margin="0,0,12,0">
                <TextBlock Text="File Access" FontSize="11" Opacity="0.6"/>
                <hui:HavenComboBox ItemsSource="{Binding PermissionModes}" SelectedItem="{Binding FilePermission}"
                          MinWidth="120"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Spacing="2" Margin="0,0,12,0">
                <TextBlock Text="Command Access" FontSize="11" Opacity="0.6"/>
                <hui:HavenComboBox ItemsSource="{Binding PermissionModes}" SelectedItem="{Binding CommandPermission}"
                          MinWidth="120"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Spacing="2">
                <TextBlock Text="Browser Access" FontSize="11" Opacity="0.6"/>
                <hui:HavenComboBox ItemsSource="{Binding PermissionModes}" SelectedItem="{Binding BrowserPermission}"
                          MinWidth="120"/>
              </StackPanel>

              <!-- Row 2: Toggles + snapshot checkbox -->
              <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                <hui:HavenCheckBox Content="Desktop tools" IsChecked="{Binding AllowDesktopTools}"/>
                <hui:HavenCheckBox Content="File system writes" IsChecked="{Binding AllowFileSystemWrites}"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                <hui:HavenCheckBox Content="Workspace snapshot (isolation)" IsChecked="{Binding UseWorkspaceSnapshot}"/>
              </StackPanel>
            </Grid>
          </hui:HavenAdaptiveSurface>

          <!-- Row 5: Start Training button — spans both columns -->
          <hui:HavenButton Grid.Row="5" Grid.ColumnSpan="2" Content="Start Training"
                  Command="{Binding StartSessionCommand}"
                  Background="{DynamicResource HavenAccentBrush}" Foreground="White"
                  HorizontalAlignment="Left" Margin="0,12,0,0" Padding="20,8"
                  IsEnabled="{Binding !IsRunning}"/>
        </Grid>
      </hui:HavenAdaptiveSurface>

      <!-- ============================================================
           ROW 1: LIVE PROGRESS PANEL (visible when running)
           Replaces the setup panel while a training session is active.
           Shows: status message, current attempt number, task/model info,
           stop button, and a live stream of the agent's reasoning text.
           ============================================================ -->
      <hui:HavenAdaptiveSurface Grid.Row="1" Classes="report-panel" IsVisible="{Binding IsRunning}" Margin="0,0,0,12">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

          <!-- Row 0: Status message (left) + attempt counter (right) -->
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="section-header"
                     Text="{Binding StatusMessage, StringFormat='Status: {0}'}"/>
          <TextBlock Grid.Row="0" Grid.Column="1"
                     Text="{Binding TotalAttempts, StringFormat='Attempt {0}'}"
                     FontWeight="Bold"/>

          <!-- Row 1: Task and model summary — two-column grid showing what's running -->
          <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Task:" FontSize="12" Opacity="0.6"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TaskPrompt}" FontSize="12"
                       TextTrimming="CharacterEllipsis" MaxLines="2"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Model:" FontSize="12" Opacity="0.6"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedModel}" FontSize="12"/>
          </Grid>

          <!-- Row 2: Stop button — cancels the current session -->
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <hui:HavenButton Content="Stop" Command="{Binding StopSessionCommand}"
                    Background="#E53935" Foreground="White" Padding="12,6"/>
          </StackPanel>

          <!-- Row 3: Live Reasoning Stream
               Shows the agent's thinking in real-time as it streams from the model.
               Clears when a tool call happens (replaced by the tool activity entry).
               Scrollable, monospaced, max 150px height. Only visible when there's text. -->
          <hui:HavenAdaptiveSurface Grid.Row="3" Background="{DynamicResource HavenPanel2Brush}" CornerRadius="6"
                  Padding="10" Margin="0,8,0,0" IsVisible="{Binding HasLiveReasoning}">
            <ScrollViewer MaxHeight="150">
              <TextBlock Text="{Binding LiveReasoning}" TextWrapping="Wrap" FontSize="11"
                         FontFamily="Cascadia Code, Consolas" Opacity="0.8"/>
            </ScrollViewer>
          </hui:HavenAdaptiveSurface>
        </Grid>
      </hui:HavenAdaptiveSurface>

      <!-- ============================================================
           ROW 2: TWO-COLUMN LAYOUT — Attempt History | Report + Feedback
           Left column (220px): scrollable list of past attempts
           Right column (flex): markdown report + feedback input
           ============================================================ -->
      <Grid Grid.Row="2" ColumnDefinitions="220,8,*" Margin="0,0,0,12">

        <!-- LEFT COLUMN: Attempt History List
             Each attempt is a clickable card showing:
             - Attempt number and action count
             - Files changed count
             - "Timed Out" badge if the attempt didn't complete
             Clicking an attempt shows its full report in the right column. -->
        <hui:HavenAdaptiveSurface Grid.Column="0" Classes="report-panel" Margin="0,0,8,0">
          <StackPanel>
            <TextBlock Text="Attempts" Classes="section-header"/>
            <ItemsControl ItemsSource="{Binding AttemptHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="svc:TrainingAttemptResult">
                  <hui:HavenButton Background="{DynamicResource HavenPanel2Brush}" CornerRadius="6"
                          Padding="10,8" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Command="{Binding $parent[UserControl].DataContext.SelectAttemptCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Spacing="2">
                      <!-- Attempt number + action count on same line -->
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding AttemptNumber, StringFormat='Attempt #{0}'}"
                                   FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalToolCalls, StringFormat='{}{0} actions'}"
                                   FontSize="11" Opacity="0.5"/>
                      </Grid>
                      <!-- Files changed count -->
                      <TextBlock FontSize="11" Opacity="0.6"
                                 Text="{Binding FilesChanged, StringFormat='{}{0} files changed'}"/>
                      <!-- "Timed Out" badge — only shown when the attempt didn't finish -->
                      <hui:HavenAdaptiveSurface Background="{DynamicResource HavenLineBrush}" CornerRadius="4"
                              Padding="6,3" IsVisible="{Binding !CompletedBeforeTimeout}">
                        <TextBlock Text="Timed Out" FontSize="10" Opacity="0.7"/>
                      </hui:HavenAdaptiveSurface>
                    </StackPanel>
                  </hui:HavenButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </hui:HavenAdaptiveSurface>

        <!-- RIGHT COLUMN: Report + Feedback
             Shows the selected attempt's markdown report and feedback input. -->
        <Grid Grid.Column="2" RowDefinitions="*,Auto">

          <!-- Current attempt report — shown while the session is running
               Displays the live markdown report for the in-progress attempt -->
          <hui:HavenAdaptiveSurface Grid.Row="0" Classes="report-panel" Margin="0,0,0,8"
                  IsVisible="{Binding IsRunning}">
            <ScrollViewer>
              <SelectableTextBlock Text="{Binding CurrentReport}" TextWrapping="Wrap"
                                   FontFamily="Cascadia Code, Consolas" FontSize="12"/>
            </ScrollViewer>
          </hui:HavenAdaptiveSurface>

          <!-- Selected historical report — shown when the session is stopped
               Displays the full report for any previously completed attempt
               selected from the history list on the left -->
          <hui:HavenAdaptiveSurface Grid.Row="0" Classes="report-panel" Margin="0,0,0,8"
                  IsVisible="{Binding !IsRunning}">
            <ScrollViewer>
              <SelectableTextBlock Text="{Binding SelectedAttemptReport}" TextWrapping="Wrap"
                                   FontFamily="Cascadia Code, Consolas" FontSize="12"/>
            </ScrollViewer>
          </hui:HavenAdaptiveSurface>

          <!-- Feedback Panel — shown after each attempt completes
               User can type feedback about the attempt's quality or skip.
               Auto-times out after 10 seconds of inactivity. -->
          <hui:HavenAdaptiveSurface Grid.Row="1" Classes="report-panel" IsVisible="{Binding IsAwaitingFeedback}">
            <StackPanel Spacing="8">
              <TextBlock Text="Provide feedback for this attempt (or skip):" FontWeight="SemiBold"/>
              <hui:HavenTextInput Text="{Binding FeedbackText}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="60" PlaceholderText="Enter feedback or leave empty to skip..."/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <hui:HavenButton Content="Submit Feedback"
                        Command="{Binding SubmitFeedbackCommand}"
                        Background="{DynamicResource HavenAccentBrush}" Foreground="White"
                        Padding="14,6"/>
                <hui:HavenButton Content="Skip"
                        Command="{Binding SkipFeedbackCommand}"
                        Background="{DynamicResource HavenLineBrush}" Foreground="{DynamicResource HavenTextBrush}"
                        Padding="14,6"/>
              </StackPanel>
            </StackPanel>
          </hui:HavenAdaptiveSurface>
        </Grid>
      </Grid>

      <!-- ============================================================
           ROW 3: BOTTOM STATUS BAR
           Persistent bar showing current status message and total attempts.
           Always visible at the bottom of the page.
           ============================================================ -->
      <hui:HavenAdaptiveSurface Grid.Row="3" Background="{DynamicResource HavenPanel2Brush}"
              CornerRadius="8" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                     VerticalAlignment="Center" Opacity="0.8"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding TotalAttempts, StringFormat='{}{0} attempt(s)'}"
                     VerticalAlignment="Center" Opacity="0.5"/>
        </Grid>
      </hui:HavenAdaptiveSurface>
    </Grid>
  </hui:HavenAdaptiveSurface>
</UserControl>
