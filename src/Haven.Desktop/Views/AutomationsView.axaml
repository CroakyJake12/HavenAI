<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:havenUi="using:Haven.Desktop.HavenUI.Components.Buttons"
             x:Class="Haven.Desktop.Views.AutomationsView">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32,28">

    <Grid ColumnDefinitions="*,Auto,Auto">
      <StackPanel>
        <TextBlock Text="Scheduled Actions" Classes="heading" />
        <TextBlock Text="Scheduled local actions with persistent history, leases, and duplicate-run protection." Classes="muted" Margin="0,4,0,0" />
      </StackPanel>
      <hui:HavenButton x:Name="RegisterWorkerButton" Grid.Column="1" Content="Register background worker" Margin="0,0,8,0" />
      <hui:HavenButton x:Name="RefreshButton" Grid.Column="2" Content="Refresh" />
    </Grid>

    <hui:HavenAdaptiveSurface Grid.Row="1" Classes="card" Margin="0,18,0,14">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="1.2*,1.8*,Auto,Auto,2*,Auto" ColumnSpacing="8" RowSpacing="10">
        <TextBlock Grid.ColumnSpan="6" Text="CREATE SCHEDULED ACTION" Classes="eyebrow" />
        <hui:HavenTextInput x:Name="NewNameBox" Grid.Row="1" PlaceholderText="Name" />
        <hui:HavenTextInput x:Name="NewInstructionBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Instruction" />
        <hui:HavenComboBox x:Name="ModeSelector" Grid.Row="1" Grid.Column="2" MinWidth="100" />
        <hui:HavenComboBox x:Name="ScheduleKindSelector" Grid.Row="1" Grid.Column="3" MinWidth="130" />
        <hui:HavenTextInput x:Name="ScheduleJsonBox" Grid.Row="1" Grid.Column="4" PlaceholderText="Schedule JSON" FontFamily="Cascadia Code, Consolas" />
        <hui:HavenButton x:Name="CreateButton" Grid.Row="1" Grid.Column="5" Content="Create" Classes="primary" />
      </Grid>
    </hui:HavenAdaptiveSurface>

    <hui:HavenAdaptiveSurface Grid.Row="2" Classes="card" Margin="0,0,0,14">
      <TextBlock x:Name="StatusText" Classes="muted" />
    </hui:HavenAdaptiveSurface>

    <ScrollViewer Grid.Row="3">
      <ItemsControl x:Name="AutomationsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <hui:HavenAdaptiveSurface Classes="card" Margin="0,0,0,10">
              <Grid ColumnDefinitions="170,90,*,150,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource HavenAccentBrush}" FontSize="10" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Mode}" Foreground="{DynamicResource HavenAccentSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Instruction}" Classes="muted" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding NextRun}" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <hui:HavenButton Grid.Column="4" Content="Run now" />
                <hui:HavenButton Grid.Column="5" Content="{Binding ToggleLabel}" />
                <havenUi:HoldToConfirmButton Grid.Column="6" Content="Delete" />
              </Grid>
            </hui:HavenAdaptiveSurface>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
