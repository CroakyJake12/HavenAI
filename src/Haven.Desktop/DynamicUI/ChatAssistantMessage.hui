<DynamicUI Name="ChatAssistantMessage">
  <Container Name="MessageRoot" Layout="Horizontal" Width="100%" Gap="10px" Padding="8px 4px">
    <Image Name="Avatar" Source="{{AVATAR}}" Width="28px" Height="28px" Radius="14px" Visibility="{{AVATARVISIBILITY}}" />
    <Container Name="MessageBody" Layout="Vertical" Width="100%" Gap="6px">
      <Text Name="Role" Content="{{AGENT}}" FontSize="11" FontWeight="700" Foreground="TextSecondary" />
      <Text Name="Thinking" Content="{{THINKING}}" FontSize="12" FontWeight="500" Foreground="TextSecondary" Visibility="{{THINKINGVISIBILITY}}" />
      <Markdown Name="Body" Content="{{CONTENT}}" FontWeight="500" />
      <Container Name="GeneratedContent" Layout="Vertical" Gap="10px" />
      <Button Name="MessageMenu" Variant="Icon" IconKey="more" Content="" Width="32px" Height="32px" MinHeight="32px" HorizontalAlignment="End" />
    </Container>
  </Container>
</DynamicUI>
