<DynamicUI Name="ChatUserMessage">
  <Container Name="MessageRoot" Layout="Vertical" Width="100%" Gap="6px" Padding="8px 4px">
    <Text Name="Role" Content="You" FontSize="11" FontWeight="700" Foreground="TextSecondary" />
    <Markdown Name="Body" Content="{{CONTENT}}" />
    <Button Name="MessageMenu" Variant="Icon" IconKey="more" Content="" Width="32px" Height="32px" MinHeight="32px" HorizontalAlignment="End" />
  </Container>
</DynamicUI>
