<DynamicUI Name="ChatSidebarGroupRow">
  <Container Name="RowRoot" Layout="Vertical" Width="100%" Gap="3px">
    <Container Name="Header" Layout="Grid" Columns="32px 1fr 32px" Rows="40px" Width="100%" Gap="4px">
      <Button Name="Toggle" Variant="Icon" IconKey="{{CHEVRON}}" Content="" Column="0" Width="32px" Height="32px" MinHeight="32px" VerticalAlignment="Center" />
      <Button Name="Open" Variant="Navigation" IconKey="folder" Content="{{TITLE}}" Column="1" Width="100%" MinHeight="40px" Background="{{BACKGROUND}}" />
      <Button Name="More" Variant="Icon" IconKey="more" Content="" Column="2" Width="32px" Height="32px" MinHeight="32px" VerticalAlignment="Center" />
    </Container>
  </Container>
</DynamicUI>
