<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.cakemods.haven</ApplicationId>
    <ApplicationVersion>20001</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.1-mobile-preview</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>Haven</AssemblyName>
    <RootNamespace>Haven.Android</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Haven.Core/Haven.Core.csproj" />
    <ProjectReference Include="../Haven.Application/Haven.Application.csproj" />
    <ProjectReference Include="../Haven.Infrastructure/Haven.Infrastructure.csproj" />
    <ProjectReference Include="../Haven.Browser/Haven.Browser.csproj" />
    <ProjectReference Include="../Haven.Automations/Haven.Automations.csproj" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="KokoroSharp.CPU" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AndroidApp.cs" />
    <Compile Remove="AndroidHavenBootstrap.cs" />
    <Compile Remove="DesktopCompatibilityStubs.cs" />
    <Compile Remove="MainActivity.cs" />
    <Compile Remove="MainView.Mobile.Android.cs" />
    <Compile Remove="MainView.Mobile.Drawers.cs" />
    <Compile Remove="MainView.Mobile.Interactions.cs" />
    <Compile Remove="MainView.Mobile.Layout.cs" />
    <Compile Remove="WindowsGraphicsCaptureService.Android.cs" />
    <Compile Remove="WindowsNaturalSpeechOutputService.Android.cs" />
  </ItemGroup>
</Project>
