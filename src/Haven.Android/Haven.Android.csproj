<!--
  Android head for Haven. The existing Haven.Desktop AXAML, styles, controls,
  pages, and view models are linked into this target so Android renders the
  same product UI rather than a separate mobile clone.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>com.cakemods.haven</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0-mobile-preview</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>Haven</AssemblyName>
    <RootNamespace>Haven.Android</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Haven.Core/Haven.Core.csproj" />
    <ProjectReference Include="../Haven.Application/Haven.Application.csproj" />
    <ProjectReference Include="../Haven.Infrastructure/Haven.Infrastructure.csproj" />
    <ProjectReference Include="../Haven.Browser/Haven.Browser.csproj" />
    <ProjectReference Include="../Haven.Automations/Haven.Automations.csproj" />

    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="KokoroSharp.CPU" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Haven.Desktop/**/*.cs"
             Exclude="../Haven.Desktop/bin/**;../Haven.Desktop/obj/**;../Haven.Desktop/Program.cs;../Haven.Desktop/MainWindow.axaml.cs;../Haven.Desktop/MainWindow.DeveloperTools.cs;../Haven.Desktop/Services/WindowsNaturalSpeechOutputService.cs;../Haven.Desktop/Services/WindowsGraphicsCaptureService.cs"
             LinkBase="SharedDesktop" />
    <AvaloniaResource Include="../Haven.Desktop/App.axaml" Link="App.axaml" />
    <AvaloniaResource Include="../Haven.Desktop/Assets/**" LinkBase="Assets" />
    <AvaloniaResource Include="../Haven.Desktop/Styles/**/*.axaml" LinkBase="Styles" />
    <AvaloniaResource Include="../Haven.Desktop/Controls/**/*.axaml" LinkBase="Controls" />
    <AvaloniaResource Include="../Haven.Desktop/Views/**/*.axaml"
                      Exclude="../Haven.Desktop/MainWindow.axaml"
                      LinkBase="Views" />
  </ItemGroup>
</Project>
