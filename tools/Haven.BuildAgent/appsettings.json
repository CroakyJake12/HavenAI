{
  "BuildAgent": {
    "RepositoryRoot": ".",
    "ArtifactRoot": ".haven-agent/artifacts",
    "VisualModel": "",
    "BuildProfiles": {
      "haven": {
        "Target": "Haven.sln"
      }
    },
    "RunProfiles": {
      "haven-desktop": {
        "Executable": "src/Haven.Desktop/bin/{Configuration}/net10.0-windows10.0.19041.0/Haven.exe",
        "WorkingDirectory": ".",
        "WindowTitleContains": "Haven"
      }
    },
    "ReferenceImages": {
      "dashboard": ".haven-agent/references/dashboard.png",
      "projects": ".haven-agent/references/projects.png",
      "voice-session": ".haven-agent/references/voice-session.png"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
