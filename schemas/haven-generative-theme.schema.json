{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "FILE DOCUMENTATION: This schema is located in schemas/ and is the validation boundary for non-executable generative themes. It enumerates every accepted metadata, palette, typography, shape, layout, and page field so generated UI cannot smuggle arbitrary properties or executable behavior into the Desktop layer. additionalProperties is intentionally false at each closed object boundary: extending the format therefore requires an explicit reviewed schema and validator change rather than silently accepting misspellings or unsupported capabilities.",
  "$id": "https://haven.local/schemas/haven-generative-theme.schema.json",
  "title": "Haven Generative UI Theme",
  "description": "Declarative, non-executable Haven theme and safe layout manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "author",
    "origin",
    "isBuiltIn",
    "createdAt",
    "updatedAt",
    "light",
    "dark",
    "typography",
    "shape",
    "layout",
    "pages"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 400 },
    "author": { "type": "string", "maxLength": 80 },
    "origin": { "type": "integer", "minimum": 0, "maximum": 3 },
    "isBuiltIn": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "light": { "$ref": "#/$defs/palette" },
    "dark": { "$ref": "#/$defs/palette" },
    "typography": { "$ref": "#/$defs/typography" },
    "shape": { "$ref": "#/$defs/shape" },
    "layout": { "$ref": "#/$defs/layout" },
    "pages": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "colour": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background", "elevated", "panel", "panel2", "panel3", "panelHover",
        "text", "textSoft", "muted", "muted2", "accent", "accentInk",
        "accentSoft", "blue", "blueSoft", "danger", "warning", "line",
        "lineStrong", "nub", "acrylicTint", "acrylicFallback", "button",
        "buttonHover", "buttonPressed", "focus"
      ],
      "properties": {
        "background": { "$ref": "#/$defs/colour" },
        "elevated": { "$ref": "#/$defs/colour" },
        "panel": { "$ref": "#/$defs/colour" },
        "panel2": { "$ref": "#/$defs/colour" },
        "panel3": { "$ref": "#/$defs/colour" },
        "panelHover": { "$ref": "#/$defs/colour" },
        "text": { "$ref": "#/$defs/colour" },
        "textSoft": { "$ref": "#/$defs/colour" },
        "muted": { "$ref": "#/$defs/colour" },
        "muted2": { "$ref": "#/$defs/colour" },
        "accent": { "$ref": "#/$defs/colour" },
        "accentInk": { "$ref": "#/$defs/colour" },
        "accentSoft": { "$ref": "#/$defs/colour" },
        "blue": { "$ref": "#/$defs/colour" },
        "blueSoft": { "$ref": "#/$defs/colour" },
        "danger": { "$ref": "#/$defs/colour" },
        "warning": { "$ref": "#/$defs/colour" },
        "line": { "$ref": "#/$defs/colour" },
        "lineStrong": { "$ref": "#/$defs/colour" },
        "nub": { "$ref": "#/$defs/colour" },
        "acrylicTint": { "$ref": "#/$defs/colour" },
        "acrylicFallback": { "$ref": "#/$defs/colour" },
        "button": { "$ref": "#/$defs/colour" },
        "buttonHover": { "$ref": "#/$defs/colour" },
        "buttonPressed": { "$ref": "#/$defs/colour" },
        "focus": { "$ref": "#/$defs/colour" }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamily", "baseFontSize", "headingScale", "letterSpacing"],
      "properties": {
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 160 },
        "baseFontSize": { "type": "number", "minimum": 10, "maximum": 24 },
        "headingScale": { "type": "number", "minimum": 1, "maximum": 2.5 },
        "letterSpacing": { "type": "number", "minimum": -1, "maximum": 5 }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlRadius",
        "cardRadius",
        "surfaceRadius",
        "spacingScale",
        "showCardBorders",
        "useAcrylic"
      ],
      "properties": {
        "controlRadius": { "type": "number", "minimum": 0, "maximum": 40 },
        "cardRadius": { "type": "number", "minimum": 0, "maximum": 48 },
        "surfaceRadius": { "type": "number", "minimum": 0, "maximum": 56 },
        "spacingScale": { "type": "number", "minimum": 0.7, "maximum": 1.8 },
        "showCardBorders": { "type": "boolean" },
        "useAcrylic": { "type": "boolean" }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "region", "order", "isVisible", "presentation"],
      "properties": {
        "itemId": {
          "enum": ["chat.temporary", "chat.model", "chat.effort", "chat.context"]
        },
        "region": {
          "enum": ["shell.header.right", "chat.composer.center", "chat.composer.right"]
        },
        "order": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "isVisible": { "type": "boolean" },
        "presentation": { "enum": ["default", "compact", "labelled", "icon"] }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placements", "hiddenPageIds"],
      "properties": {
        "placements": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/placement" }
        },
        "hiddenPageIds": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "title", "text", "commandId", "durationSeconds", "shortcutCommandIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "integer", "minimum": 0, "maximum": 4 },
        "title": { "type": "string", "maxLength": 100 },
        "text": { "type": ["string", "null"], "maxLength": 2000 },
        "commandId": {
          "type": ["string", "null"],
          "enum": [
            null, "home", "new-chat", "chat", "teach", "call", "do",
            "studio", "browse", "plan", "automations", "settings"
          ]
        },
        "durationSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "shortcutCommandIds": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "home", "new-chat", "chat", "teach", "call", "do",
              "studio", "browse", "plan", "automations", "settings"
            ]
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "iconKey", "order", "widgets"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 240 },
        "iconKey": { "$ref": "#/$defs/identifier" },
        "order": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "widgets": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/widget" }
        }
      }
    }
  }
}
