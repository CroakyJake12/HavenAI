+        if (string.IsNullOrWhiteSpace(id))
+        {
+            if (draft.ResponseKind is not MailResponseKind.New && !string.IsNullOrWhiteSpace(draft.SourceMessageId))
+            {
+                var action = draft.ResponseKind switch
