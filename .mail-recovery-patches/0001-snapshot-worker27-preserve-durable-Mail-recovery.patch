+        using (var _ = await SendJsonAsync(draft.AccountId, HttpMethod.Patch, new Uri(BaseUri, $"messages/{Uri.EscapeDataString(id)}"), CreateMessageContent(draft), cancellationToken).ConfigureAwait(false)) { }
