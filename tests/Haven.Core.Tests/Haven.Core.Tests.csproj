<!--
  FILE DOCUMENTATION
  Where: tests/Haven.Core.Tests/Haven.Core.Tests.csproj in the automated test suite, where executable examples protect behavior against regressions.
  What: This MSBuild/XML file declares project inputs, dependencies, and build behavior.
  Why: Central declarative configuration keeps builds reproducible across developer machines and CI.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Haven.Core\Haven.Core.csproj" />
    <ProjectReference Include="..\..\src\Haven.Application\Haven.Application.csproj" />
    <!-- Scheduled-task tests now target Haven.Application directly. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="coverlet.collector"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
</Project>